msgid "DCSBattleground commands"
msgstr "Comandi di DCSBattleground"

msgid "Push MGRS coordinates with screenshots to DCS Battleground"
msgstr "Invia coordinate MGRS con screenshot a DCS Battleground"

msgid "The second parameter needs to be a MGRS coordinate (ex: 38TLN0274366889)."
msgstr "Il secondo parametro deve essere una coordinata MGRS (es: 38TLN0274366889)."

msgid "Recon data added - {side} side - {server}"
msgstr "Dati di ricognizione aggiunti - lato {side} - {server}"

msgid "Coalitions have to be enabled and you need to use this command in one of your coalition channels!"
msgstr "Le coalizioni devono essere abilitate e il comando va usato in uno dei canali della propria coalizione!"

msgid "Delete recon data on a specified server"
msgstr "Elimina i dati di ricognizione su un server specificato"

msgid "Recon data deleted for server {}."
msgstr "Dati di ricognizione eliminati per il server {}."
