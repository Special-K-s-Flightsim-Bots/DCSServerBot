msgstr "Verranno eliminati dati dal database. Attenzione.\n\nSelezionare i dati da eliminare:"

msgid "We are going to delete all data of user {}. Are you sure?"
msgstr "Verranno eliminati tutti i dati dell'utente {}. Confermare?"

msgid "We are going to delete all data of server {}. Are you sure?"
msgstr "Verranno eliminati tutti i dati del server {}. Confermare?"

msgid "Data of user {} deleted."
msgstr "Dati dell'utente {} eliminati."

msgid "Data of server {} deleted."
msgstr "Dati del server {} eliminati."

msgid "No players to prune."
msgstr "Nessun giocatore da eliminare."

msgid "This will delete {} players incl. their stats from the database.\n"
msgstr "Verranno eliminati {} giocatori con le relative statistiche dal database.\n"

msgid "This will delete {} players incl. their stats from the database.\nAre you sure?"
msgstr "Verranno eliminati {} giocatori con le relative statistiche dal database.\nConfermare?"

msgid "This will delete all data older than {} days from the database.\n"
msgstr "Verranno eliminati dal database tutti i dati più vecchi di {} giorni.\n"

msgid "This will delete all data older than {} days from the database.\nAre you sure?"
msgstr "Verranno eliminati dal database tutti i dati più vecchi di {} giorni.\nConfermare?"

msgid "All data older than {} days pruned."
msgstr "Eliminati tutti i dati più vecchi di {} giorni."

