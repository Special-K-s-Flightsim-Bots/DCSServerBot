msgstr "Istanza {instance} aggiunta al nodo {node}.Assicurarsi di inoltrare le seguenti porte:```"

msgid "Instance {instance} added to node {node}.Please make sure you forward the following ports:```- DCS Port:    {dcs_port} (TCP/UDP)"
msgstr "Istanza {instance} aggiunta al nodo {node}.Assicurarsi di inoltrare le seguenti porte:```- Porta DCS:    {dcs_port} (TCP/UDP)"

msgid "Instance {instance} added to node {node}.Please make sure you forward the following ports:```- DCS Port:    {dcs_port} (TCP/UDP)- WebGUI Port: {webgui_port} (TCP)"
msgstr "Istanza {instance} aggiunta al nodo {node}.Assicurarsi di inoltrare le seguenti porte:```- Porta DCS:    {dcs_port} (TCP/UDP)- Porta WebGUI: {webgui_port} (TCP)"

msgid "Instance {instance} added to node {node}.Please make sure you forward the following ports:```- DCS Port:    {dcs_port} (TCP/UDP)- WebGUI Port: {webgui_port} (TCP)```"
msgstr "Istanza {instance} aggiunta al nodo {node}.Assicurarsi di inoltrare le seguenti porte:```- Porta DCS:    {dcs_port} (TCP/UDP)- Porta WebGUI: {webgui_port} (TCP)```"

