msgid "Can't get version information from ED, possible auth-server outage!"
msgstr "Impossibile ottenere le informazioni sulla versione da ED, possibile interruzione del server di autenticazione!"

msgid "Your installed version {version} is the latest on branch {branch}."
msgstr "La versione installata {version} è la più recente sul branch {branch}."

msgid "Would you like to update from version {old_version}@{old_branch} to {new_version}@{new_branch}?\n"
msgstr "Aggiornare dalla versione {old_version}@{old_branch} alla {new_version}@{new_branch}?\n"

msgid "Would you like to update from version {old_version}@{old_branch} to {new_version}@{new_branch}?\nAll running DCS servers will be shut down!"
msgstr "Aggiornare dalla versione {old_version}@{old_branch} alla {new_version}@{new_branch}?\nTutti i server DCS in esecuzione verranno arrestati!"

msgid "Updating DCS World to the newest version, please wait ..."
msgstr "Aggiornamento di DCS World alla versione più recente, attendere ..."

msgid "DCS updated to version {version}@{branch} on node {name}."
msgstr "DCS aggiornato alla versione {version}@{branch} sul nodo {name}."

msgid "DCS World could not be updated on node {name} due to missing disk space!"
msgstr "Impossibile aggiornare DCS World sul nodo {name}: spazio su disco insufficiente!"

msgid "DCS World updated to version {version}@{branch} on node {name}.\n"
msgstr "DCS World aggiornato alla versione {version}@{branch} sul nodo {name}.\n"

msgid "DCS World updated to version {version}@{branch} on node {name}.\nThe updater has requested a **reboot** of the system!"
msgstr "DCS World aggiornato alla versione {version}@{branch} sul nodo {name}.\nL'aggiornatore ha richiesto un **riavvio** del sistema!"

msgid "Error while updating DCS on node {name}, code={rc}"
msgstr "Errore durante l'aggiornamento di DCS sul nodo {name}, code={rc}"

msgid "The update takes longer than 10 minutes, please check back regularly, if it has finished."
msgstr "L'aggiornamento richiede più di 10 minuti, controllare periodicamente se è terminato."

msgid "Can't update branch {}. You might need to provide proper DCS credentials to do so."
msgstr "Impossibile aggiornare il branch {}. Potrebbe essere necessario fornire credenziali DCS valide."

msgid "Install modules in your DCS server"
msgstr "Installa moduli nel server DCS"

msgid "Shutdown all servers on node {} for the installation?"
msgstr "Arrestare tutti i server sul nodo {} per l'installazione?"

msgid "Installing module {module} on node {node}, please wait ..."
msgstr "Installazione del modulo {module} sul nodo {node}, attendere ..."

msgid "Module {module} installed on node {node}."
msgstr "Modulo {module} installato sul nodo {node}."

msgid "Module {module} installation on node {node} failed with code {rc}."
msgstr "Installazione del modulo {module} sul nodo {node} non riuscita, codice {rc}."

msgid "Uninstall modules from your DCS server"
msgstr "Disinstalla moduli dal server DCS"

msgid "Shutdown all servers on node {} for the uninstallation?"
msgstr "Arrestare tutti i server sul nodo {} per la disinstallazione?"

msgid "Aborted."
msgstr "Operazione annullata."

