msgid "The FPS of server {server.name} are below {min_fps} for longer than {period} minutes!"
msgstr "Gli FPS del server {server.name} sono inferiori a {min_fps} per più di {period} minuti!"

msgid "Displays the load of your DCS servers"
msgstr "Mostra il carico dei server DCS"

msgid "Shows servers statistics"
msgstr "Mostra le statistiche dei server"

msgid "Server {server} FPS ({fps}) has been below {min_fps} for more than {period} minutes."
msgstr "Gli FPS del server {server} ({fps}) sono inferiori a {min_fps} da più di {period} minuti."

msgid "Server Performance Low!"
msgstr "Prestazioni del server basse!"

msgid "Server {server} RAM usage is {ram} GB, exceeding the maximum of {max_ram} GB for more than {period} minutes."
msgstr "L'uso di RAM del server {server} è di {ram} GB, oltre il massimo di {max_ram} GB per più di {period} minuti."

msgid "Excessive RAM consumption!"
msgstr "Consumo di RAM eccessivo!"
