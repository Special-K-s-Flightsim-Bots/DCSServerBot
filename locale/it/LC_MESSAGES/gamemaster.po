msgstr "Campagna {} avviata."

msgid "Stop a campaign"
msgstr "Ferma una campagna"

msgid "Do you want to stop campaign \"{}\"?"
msgstr "Vuole fermare la campagna \"{}\"?"

msgid "Campaign stopped."
msgstr "Campagna fermata."

