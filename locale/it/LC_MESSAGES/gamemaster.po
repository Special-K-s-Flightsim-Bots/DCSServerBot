msgstr "Script Lua"

msgid "Enter your script here:"
msgstr "Inserire lo script qui:"

msgid "Script sent."
msgstr "Script inviato."

msgid "Loads a lua file into the mission"
msgstr "Carica un file lua nella missione"

msgid "Script loaded."
msgstr "Script caricato."

msgid "Reset coalition cooldown"
msgstr "Reimposta il cooldown della coalizione"

msgid "The coalition system is not enabled on this server."
msgstr "Il sistema delle coalizioni non è abilitato su questo server."

msgid "Do you want to reset the coalition-bindings from player {}?"
msgstr "Vuole reimpostare i collegamenti alla coalizione del giocatore {}?"

msgid "Coalition bindings for player {} reset."
msgstr "Collegamenti alla coalizione del giocatore {} reimpostati."

msgid "The bot is missing the \"Manage Roles\" permission!"
msgstr "Al bot manca il permesso \"Manage Roles\"!"

msgid "Reset all coalition cooldowns"
msgstr "Reimposta tutti i cooldown delle coalizioni"

