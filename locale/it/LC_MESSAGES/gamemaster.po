msgid "Send a chat message to DCS"
msgstr "Invia un messaggio in chat a DCS"

msgid "Server {} is not running."
msgstr "Il server {} non è in esecuzione."

msgid "Message sent."
msgstr "Messaggio inviato."

msgid "Sends a popup to a coalition\n"
msgstr "Invia un popup a una coalizione\n"

msgid "Sends a popup to all servers"
msgstr "Invia un popup a tutti i server"

msgid "Message NOT sent to server {server} because it is {status}."
msgstr "Messaggio NON inviato al server {server} perché è {status}."

msgid "Message sent to server {}."
msgstr "Messaggio inviato al server {}."

msgid "Set or get a flag inside the mission"
msgstr "Imposta o legge un flag all'interno della missione"

msgid "Flag {flag} set to {value}."
msgstr "Flag {flag} impostato a {value}."

msgid "Flag {flag} has value {value}."
msgstr "Il flag {flag} ha valore {value}."

msgid "Set or get a mission variable"
msgstr "Imposta o legge una variabile della missione"

msgid "Variable {name} set to {value}."
msgstr "Variabile {name} impostata a {value}."

msgid "Timeout while retrieving variable. Most likely a lua error occurred. Check your dcs.log."
msgstr "Timeout durante il recupero della variabile. Molto probabilmente si è verificato un errore lua. Controllare dcs.log."

msgid "Variable {name} has value {value}."
msgstr "La variabile {name} ha valore {value}."

msgid "Variable {} is not set."
msgstr "La variabile {} non è impostata."

