msgid "To which server do you want to upload this transponder file to?"
msgstr "Su quale server si desidera caricare questo file transponder?"

msgid "LotAtc is not configured on any server."
msgstr "LotAtc non è configurato su nessun server."

msgid "Transponder file {} uploaded."
msgstr "File transponder {} caricato."

msgid "Transponder file {} could not be uploaded!"
msgstr "Impossibile caricare il file transponder {}!"

msgid "GCI {} on station."
msgstr "GCI {} in stazione."

msgid "GCI {} offline."
msgstr "GCI {} disconnesso."

msgid "{num} {coalition} GCI{s} on station."
msgstr "{num} {coalition} GCI{s} in stazione."

msgid "{coalition} GCI \"{name}\" on station."
msgstr "GCI {coalition} \"{name}\" in stazione."

msgid "{coalition} GCI \"{name}\" offline."
msgstr "GCI {coalition} \"{name}\" disconnesso."

msgid "Shows active GCIs"
msgstr "Mostra i GCI attivi"

msgid "You need to join a side to show their GCIs"
msgstr "È necessario unirsi a una parte per mostrare i relativi GCI"

msgid "The following GCIs are active on the {coalition} side:\n{gcis}"
msgstr "I seguenti GCI sono attivi dalla parte {coalition}:\n{gcis}"

msgid "No GCIs are active on the {} side."
msgstr "Nessun GCI è attivo dalla parte {}."

msgid "Information about {coalition} GCI \"{name}\\"
msgstr "Informazioni sul GCI {coalition} \"{name}\\"

msgid "Info about a GCI"
msgstr "Informazioni su un GCI"

msgid "Usage: {prefix}{command} <name>"
msgstr "Uso: {prefix}{command} <name>"

msgid "Commands to manage GCIs"
msgstr "Comandi per gestire i GCI"

msgid "You are not allowed to see the {} GCIs."
msgstr "Non è consentito vedere i GCI {}."

msgid "There are no {coalition} GCIs active in server {server}"
msgstr "Non ci sono GCI {coalition} attivi nel server {server}"

msgid "GCI {} not found."
msgstr "GCI {} non trovato."

msgid "List of GCIs"
msgstr "Elenco dei GCI"

msgid "List of active {} GCIs"
msgstr "Elenco dei GCI {} attivi"

msgid "You are not allowed to play when being a GCI."
msgstr "Non è consentito giocare quando si è un GCI."

msgid "GCI {} tried to join as player {}!"
msgstr "Il GCI {} ha tentato di entrare come giocatore {}!"

msgid "active"
msgstr "attivo"

msgid "inactive"
msgstr "inattivo"
