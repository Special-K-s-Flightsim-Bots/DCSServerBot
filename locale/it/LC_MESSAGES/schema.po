msgstr "Un nome di ruolo Discord."

#. scheduler_schema:schema;action_map.settings.[0]
#: plugins/scheduler/schemas/scheduler_schema.yaml:139
msgid "A MizEdit setting name."
msgstr "Un nome di impostazione MizEdit."

#. punishment_schema:schema;element_schema.exemptions.ucid.[0]
#: plugins/punishment/schemas/punishment_schema.yaml:219
msgid "A player UCID."
msgstr "Un UCID di giocatore."

#. scheduler_schema:schema;action_map.times.[0]
#: plugins/scheduler/schemas/scheduler_schema.yaml:33
msgid "A time of day in HH:MM format."
msgstr "Un'ora del giorno nel formato HH:MM."

#. restapi_schema:schema;security.trusted.[0]
#: plugins/restapi/schemas/restapi_schema.yaml:45
msgid "A trusted network in CIDR notation."
msgstr "Una rete attendibile in notazione CIDR."

#. skyeye_schema:schema;skyeye_config.openai-api-key
#: extensions/skyeye/schemas/skyeye_schema.yaml:128
msgid "API key for the OpenAI Whisper API recognizer."
msgstr "API key per il riconoscitore OpenAI Whisper API."

#. realweather_schema:schema;instance_realweather_schema.api.checkwx.key
#. realweather_schema:schema;node_realweather_schema.api.checkwx.key
#: extensions/realweather/schemas/realweather_schema.yaml:187
#: extensions/realweather/schemas/realweather_schema.yaml:423
msgid "API key of your CheckWX account."
msgstr "API key del tuo account CheckWX."

#. restapi_schema:schema;auth.api_key
#: plugins/restapi/schemas/restapi_schema.yaml:8
msgid "API key that clients must send in the X-API-Key header."
msgstr "API key che i client devono inviare nell'header X-API-Key."

#. grpc_schema:schema;grpc_schema.tts.provider.aws.key
#: extensions/grpc/schemas/grpc_schema.yaml:82
msgid "AWS access key for Amazon Polly text-to-speech."
msgstr "AWS access key per il text-to-speech di Amazon Polly."

#. houndtts_schema:schema;houndtts_schema.provider.AWS.access_key_id
#: extensions/houndtts/schemas/houndtts_schema.yaml:147
msgid "AWS access key id used for Amazon Polly."
msgstr "ID della AWS access key usato per Amazon Polly."

#. grpc_schema:schema;grpc_schema.tts.provider.aws.region
#. houndtts_schema:schema;houndtts_schema.provider.AWS.region
#: extensions/grpc/schemas/grpc_schema.yaml:88 extensions/houndtts/schemas/houndtts_schema.yaml:157
msgid "AWS region that hosts the Polly service."
msgstr "Regione AWS che ospita il servizio Polly."

#. houndtts_schema:schema;houndtts_schema.provider.AWS.secret_key
#: extensions/houndtts/schemas/houndtts_schema.yaml:152
msgid "AWS secret access key used for Amazon Polly."
msgstr "AWS secret access key usata per Amazon Polly."

#. webservice_schema:DEFAULT.auth.local.users.[0].username
#: services/webservice/schemas/webservice_schema.yaml:551
msgid "Account name of the local console user."
msgstr "Nome dell'account dell'utente locale della console."

#. webservice_schema:DEFAULT.auth.local.users
#: services/webservice/schemas/webservice_schema.yaml:540
msgid "Accounts that may sign in with a username and password."
msgstr "Account che possono accedere con nome utente e password."

#. punishment_schema:schema;element_schema.punishments.[0].action
#: plugins/punishment/schemas/punishment_schema.yaml:138
msgid "Action taken when the point level is reached."
msgstr "Azione eseguita al raggiungimento del livello di punti."

#. scheduler_schema:schema;action_map.method
#: plugins/scheduler/schemas/scheduler_schema.yaml:69
msgid "Action to perform, e.g. restart, rotate or load."
msgstr "Azione da eseguire, ad es. restart, rotate o load."

#. cron_schema:schema;element_schema.actions.[0].action
#: services/cron/schemas/cron_schema.yaml:65
msgid "Action to perform, one of the supported types."
msgstr "Azione da eseguire, uno dei tipi supportati."

#. punishment_schema:schema;element_schema.penalties.[0].action
#: plugins/punishment/schemas/punishment_schema.yaml:95
msgid "Action to run immediately for this event (optional)."
msgstr "Azione da eseguire subito per questo evento (facoltativa)."

#. punishment_schema:schema;element_schema.punishments
#: plugins/punishment/schemas/punishment_schema.yaml:116
msgid "Actions triggered when a player reaches a point level."
msgstr "Azioni attivate quando un giocatore raggiunge un livello di punti."

#. discord_schema:schema;element_schema.reaction.bot_trap
#: plugins/discord/schemas/discord_schema.yaml:122
msgid "Add a trap that kicks bots reacting to the message."
msgstr "Aggiunge una trap che espelle i bot che reagiscono al messaggio."

#. realweather_schema:schema;instance_realweather_schema.realweather.mission.brief.add-metar
#. realweather_schema:schema;node_realweather_schema.realweather.mission.brief.add-metar
#: extensions/realweather/schemas/realweather_schema.yaml:114
#: extensions/realweather/schemas/realweather_schema.yaml:350
msgid "Add the current METAR to the mission briefing."
msgstr "Aggiunge il METAR corrente al briefing della missione."

#. olympus_schema:schema;instance_olympus_schema.regex;(frontend|client).mapLayers
#: extensions/olympus/schemas/olympus_schema.yaml:289
msgid "Additional map layer providers (Olympus 2.0)."
msgstr "Provider aggiuntivi di layer della mappa (Olympus 2.0)."

#. olympus_schema:schema;instance_olympus_schema.authentication.adminPassword
#. olympus_schema:schema;node_olympus_schema.authentication.adminPassword
#: extensions/olympus/schemas/olympus_schema.yaml:68 extensions/olympus/schemas/olympus_schema.yaml:216
msgid "Admin password (Olympus 2.0 and later)."
msgstr "Password di amministratore (Olympus 2.0 e successivi)."

#. servers_schema:schema;settings_schema.advanced
#: schemas/servers_schema.yaml:95
msgid "Advanced DCS settings written to serverSettings.lua."
msgstr "Impostazioni DCS avanzate scritte in serverSettings.lua."

#. realweather_schema:schema;instance_realweather_schema.options.weather.pressure
#: extensions/realweather/schemas/realweather_schema.yaml:828
msgid "Air pressure generation."
msgstr "Generazione della pressione atmosferica."

#. servers_schema:regex;(.+).usage_alarm
#: schemas/servers_schema.yaml:428
msgid "Alert pings when server usage crosses thresholds."
msgstr "Ping di avviso quando l'utilizzo del server supera le soglie."

#. servers_schema:regex;(.+).usage_alarm.min_threshold
#: schemas/servers_schema.yaml:438
msgid "Alert when fewer players than this are online."
msgstr "Avviso quando sono online meno giocatori di questo valore."

#. servers_schema:regex;(.+).usage_alarm.max_threshold
#: schemas/servers_schema.yaml:444
msgid "Alert when more players than this are online."
msgstr "Avviso quando sono online più giocatori di questo valore."

#. srs_schema:schema;node_srs_schema.beta
#: extensions/srs/schemas/srs_schema.yaml:104
msgid "Allow beta versions of DCS-SRS to be installed."
msgstr "Consente l'installazione di versioni beta di DCS-SRS."

#. nodes_schema:regex;(.+).auto_affinity.reuse_cores
#: schemas/nodes_schema.yaml:167
msgid "Allow bounded core reuse when minimums cannot be met."
msgstr "Consente il riutilizzo limitato dei core quando i minimi non possono essere soddisfatti."

#. servers_schema:schema;settings_schema.advanced.allow_trial_only_clients
#: schemas/servers_schema.yaml:184
msgid "Allow clients restricted to trial modules to join."
msgstr "Consente l'accesso ai client limitati ai moduli di prova."

#. servers_schema:schema;settings_schema.advanced.server_can_screenshot
#: schemas/servers_schema.yaml:139
msgid "Allow clients to take screenshots on the server."
msgstr "Consente ai client di fare screenshot sul server."

#. admin_schema:schema;uploads.enabled
#: plugins/admin/schemas/admin_schema.yaml:58
msgid "Allow configuration files to be uploaded at all."
msgstr "Consente del tutto l'upload dei file di configurazione."

#. servers_schema:schema;settings_schema.advanced.allow_object_export
#: schemas/servers_schema.yaml:169
msgid "Allow export of object data to external tools."
msgstr "Consente l'esportazione dei dati degli oggetti verso strumenti esterni."

#. servers_schema:schema;settings_schema.advanced.allow_ownship_export
#: schemas/servers_schema.yaml:164
msgid "Allow export of own-ship data to external tools."
msgstr "Consente l'esportazione dei dati del proprio velivolo verso strumenti esterni."

#. servers_schema:schema;settings_schema.advanced.allow_sensor_export
#: schemas/servers_schema.yaml:179
msgid "Allow export of sensor data to external tools."
msgstr "Consente l'esportazione dei dati dei sensori verso strumenti esterni."

#. tournament_schema:schema;element_schema.allow_exports
#: plugins/tournament/schemas/tournament_schema.yaml:45
msgid "Allow mission exports during tournament matches."
msgstr "Consente l'esportazione delle missioni durante le partite di torneo."

#. servers_schema:schema;settings_schema.advanced.allow_change_skin
#: schemas/servers_schema.yaml:149
msgid "Allow players to change their aircraft livery."
msgstr "Consente ai giocatori di cambiare la livrea del proprio velivolo."

#. servers_schema:schema;settings_schema.advanced.allow_change_tailno
#: schemas/servers_schema.yaml:154
msgid "Allow players to change their aircraft tail number."
msgstr "Consente ai giocatori di cambiare il numero di coda del proprio velivolo."

#. servers_schema:schema;settings_schema.advanced.allow_players_pool
#: schemas/servers_schema.yaml:174
msgid "Allow players to share a pool of aircraft across slots."
msgstr "Consente ai giocatori di condividere un pool di velivoli tra gli slot."

#. servers_schema:schema;settings_schema.advanced.allow_dynamic_radio
#: schemas/servers_schema.yaml:159
msgid "Allow players to use dynamic radio channel assignment."
msgstr "Consente ai giocatori di usare l'assegnazione dinamica dei canali radio."

#. realweather_schema:schema;instance_realweather_schema.options.weather.clouds.custom.allow-precipitation
#: extensions/realweather/schemas/realweather_schema.yaml:726
msgid "Allow precipitation with custom clouds."
msgstr "Consente precipitazioni con nuvole personalizzate."

#. tacview_schema:schema;instance_tacview_schema.tacviewRemoteControlEnabled
#. tacview_schema:schema;node_tacview_schema.tacviewRemoteControlEnabled
#: extensions/tacview/schemas/tacview_schema.yaml:83 extensions/tacview/schemas/tacview_schema.yaml:208
msgid "Allow remote control of Tacview."
msgstr "Consente il controllo remoto di Tacview."

#. nodes_schema:regex;(.+).auto_affinity.steal_load_threshold
#: schemas/nodes_schema.yaml:188
msgid "Allow stealing cores from idle processes above this load."
msgstr "Consente di sottrarre core ai processi inattivi oltre questo carico."

#. grpc_schema:schema;grpc_schema.evalEnabled
#: extensions/grpc/schemas/grpc_schema.yaml:31
msgid "Allow the eval() function in mission scripts. Default is false."
msgstr "Consente la funzione eval() negli script delle missioni. Il valore predefinito è false."

#. mission_schema:schema;element_schema.uploads.enabled
#: plugins/mission/schemas/mission_schema.yaml:58
msgid "Allow uploading .miz files to the server."
msgstr "Consente l'upload di file .miz sul server."

#. userstats_schema:schema;element_schema.squadrons.self_join
#: plugins/userstats/schemas/userstats_schema.yaml:87
msgid "Allow users to join and leave squadrons on their own."
msgstr "Consente agli utenti di entrare e uscire autonomamente dalle squadriglie."

#. slotblocking_schema:schema;element_schema.balancing.threshold
#: plugins/slotblocking/schemas/slotblocking_schema.yaml:185
msgid "Allowed deviation from the ratio before slots are blocked."
msgstr "Scostamento consentito dal rapporto prima che gli slot vengano bloccati."

#. servers_schema:regex;(.+).slot_spamming.slot_changes
#: schemas/servers_schema.yaml:479
msgid "Allowed slot changes within the observation window."
msgstr "Cambi di slot consentiti entro la finestra di osservazione."

#. nodes_schema:regex;(.+).DCS.allow_unsafe_api.[0]
#: schemas/nodes_schema.yaml:367
msgid "Allowed unsafe API feature."
msgstr "Funzionalità API non sicura consentita."

#. nodes_schema:regex;(.+).restrict_owner
#: schemas/nodes_schema.yaml:78
msgid "Also block restricted commands for the bot owner."
msgstr "Blocca i comandi riservati anche per il proprietario del bot."

#. creditsystem_schema:schema;element_schema.squadron_credits
#: plugins/creditsystem/schemas/creditsystem_schema.yaml:65
msgid "Also credit the player's squadron with earned points."
msgstr "Accredita i punti guadagnati anche alla squadriglia del giocatore."

#. missionstats_schema:schema;element_schema.persist_ai_statistics
#: plugins/missionstats/schemas/missionstats_schema.yaml:39
msgid "Also persist statistics for AI units."
msgstr "Salva le statistiche anche per le unità AI."

#. cleanup_schema:schema;element_schema.regex;(.+).recursive
#: services/cleanup/schemas/cleanup_schema.yaml:35
msgid "Also search subdirectories below the directory."
msgstr "Cerca anche nelle sottocartelle della cartella."

#. lardoon_schema:schema;instance_lardoon_schema.url
#: extensions/lardoon/schemas/lardoon_schema.yaml:107
msgid "Alternate hostname shown in the embed; needed if not single process."
msgstr "Hostname alternativo mostrato nell'embed; necessario se non è un processo singolo."

#. lardoon_schema:schema;node_lardoon_schema.url
#: extensions/lardoon/schemas/lardoon_schema.yaml:43
msgid "Alternate hostname shown in the server status embed."
msgstr "Hostname alternativo mostrato nell'embed di stato del server."

#. lardoon_schema:schema;instance_lardoon_schema.tacviewExportPath
#: extensions/lardoon/schemas/lardoon_schema.yaml:114
msgid "Alternative directory holding the Tacview files."
msgstr "Cartella alternativa che contiene i file Tacview."

#. olympus_schema:schema;instance_olympus_schema.regex;(frontend|client).mapMirrors
#: extensions/olympus/schemas/olympus_schema.yaml:322
msgid "Alternative map tile sources (Olympus 2.0)."
msgstr "Sorgenti alternative di tile della mappa (Olympus 2.0)."

#. commands_schema:schema;chat_commands_schema.regex;(.+).aliases.[0]
#: schemas/commands_schema.yaml:65
msgid "Alternative name for the chat command."
msgstr "Nome alternativo per il comando chat."

#. commands_schema:schema;chat_commands_schema.regex;(.+).aliases
#: schemas/commands_schema.yaml:58
msgid "Alternative names that also trigger this command."
msgstr "Nomi alternativi che attivano anch'essi questo comando."

#. houndtts_schema:schema;houndtts_schema.provider.AWS
#: extensions/houndtts/schemas/houndtts_schema.yaml:137
msgid "Amazon Polly text-to-speech provider settings."
msgstr "Impostazioni del provider text-to-speech Amazon Polly."

#. presets_schema:schema;preset_map.temperature
#: schemas/presets_schema.yaml:217
msgid "Ambient air temperature in degrees Celsius."
msgstr "Temperatura dell'aria ambiente in gradi Celsius."

#. skyeye_schema:schema;skyeye_config.threat-monitoring
#: extensions/skyeye/schemas/skyeye_schema.yaml:181
msgid "Announce airborne threats to the players."
msgstr "Annuncia le minacce aeree ai giocatori."

#. srs_schema:schema;node_srs_schema.announce.description
#: extensions/srs/schemas/srs_schema.yaml:81
msgid "Announcement body text."
msgstr "Testo del corpo dell'annuncio."

#. nodes_schema:regex;(.+).DCS.announce.description
#: schemas/nodes_schema.yaml:296
msgid "Announcement embed description."
msgstr "Descrizione dell'embed dell'annuncio."

#. nodes_schema:regex;(.+).DCS.announce.footer
#: schemas/nodes_schema.yaml:302
msgid "Announcement embed footer text."
msgstr "Testo del footer dell'embed dell'annuncio."

#. nodes_schema:regex;(.+).DCS.announce.title
#: schemas/nodes_schema.yaml:290
msgid "Announcement embed title."
msgstr "Titolo dell'embed dell'annuncio."

#. srs_schema:schema;node_srs_schema.announce.title
#: extensions/srs/schemas/srs_schema.yaml:75
#, python-brace-format
msgid "Announcement title; {} is replaced by the version."
msgstr "Titolo dell'annuncio; {} viene sostituito dalla versione."

#. firewall_schema:schema;element_schema.ddos_detection.consecutive_ticks
#: services/firewall/schemas/firewall_schema.yaml:63
msgid "Anomalous ticks in a row needed to confirm DDoS start."
msgstr "Tick anomali consecutivi necessari per confermare l'inizio di un DDoS."

