msgstr ""
"Project-Id-Version: 1.0\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: it\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Member {member} banned by {banned_by} for {reason}."
msgstr "Membro {member} bannato da {banned_by} per {reason}."

msgid "You have been banned from the DCS servers on {guild} for {reason} for the amount of {days} days."
msgstr "Il tuo account è stato bannato dai server DCS su {guild} per {reason} per {days} giorni."

msgid "Player {player} (ucid={ucid}) banned by {banned_by} for {reason}."
msgstr "Giocatore {player} (ucid={ucid}) bannato da {banned_by} per {reason}."

msgid "Player with ucid {ucid} banned by {banned_by} for {reason}."
msgstr "Giocatore con ucid {ucid} bannato da {banned_by} per {reason}."

msgid "Player {player} (ucid={ucid}) kicked by {kicked_by} for {reason}."
msgstr "Giocatore {player} (ucid={ucid}) espulso da {kicked_by} per {reason}."

msgid "You've been kicked back to spectators because of: {}."
msgstr "Sei stato espulso e riportato agli spettatori per: {}."

msgid "Player {player} (ucid={ucid}) moved to spectators by {spec_by} for {reason}."
msgstr "Giocatore {player} (ucid={ucid}) spostato agli spettatori da {spec_by} per {reason}."

msgid "Punished for {}"
msgstr "Punito per {}"

msgid "{name}, you have been punished for: {reason}!\n"
msgstr "{name}, sei stato punito per: {reason}!\n"

msgid "Player {player} (ucid={ucid}) punished with credits by {punished_by} for {reason}."
msgstr "Giocatore {player} (ucid={ucid}) punito con crediti da {punished_by} per {reason}."

msgid "{name}, you have been punished for: {reason}!"
msgstr "{name}, sei stato punito per: {reason}!"

msgid "{name}, check your fire: {reason}!"
msgstr "{name}, controlla il fuoco: {reason}!"

msgid "{name}, you have {points} punishment points."
msgstr "{name}, hai {points} punti di punizione."

msgid "Adds punishment points to a user\n"
msgstr "Aggiunge punti di punizione a un utente\n"

msgid "User {} is not linked."
msgstr "L'utente {} non è collegato."

msgid "The UCID provided is invalid."
msgstr "L'UCID fornito non è valido."

msgid "User punished with {} points."
msgstr "Utente punito con {} punti."

msgid "punished user {ucid} with {points} points."
msgstr "punito l'utente {ucid} con {points} punti."

msgid "Deletes a users punishment points"
msgstr "Elimina i punti di punizione di un utente"

msgid "This will delete all the punishment points for this user and unban them if they were banned.\n"
msgstr "Questo eliminerà tutti i punti di punizione dell'utente e lo sbannerà se era bannato.\n"

msgid "All punishment points deleted and player unbanned (if they were banned by the bot before)."
msgstr "Tutti i punti di punizione eliminati e giocatore sbannato (se era stato bannato prima dal bot)."

msgid "forgave player {}"
msgstr "perdonato il giocatore {}"

msgid "Displays the current penalty points"
msgstr "Mostra i punti di penalità attuali"

msgid "You need the DCS Admin role to show penalty points for other users."
msgstr "Serve il ruolo DCS Admin per mostrare i punti di penalità di altri utenti."

msgid "Member {} is not linked."
msgstr "Il membro {} non è collegato."

msgid "Use {} to link your Discord and DCS accounts first."
msgstr "Usare {} per collegare prima gli account Discord e DCS."

msgid "User has no penalty points."
msgstr "L'utente non ha punti di penalità."

msgid "Penalty Points for {}"
msgstr "Punti di penalità per {}"

msgid "Total penalty points: {total:.2f}"
msgstr "Punti di penalità totali: {total:.2f}"

msgid "Time (UTC)"
msgstr "Ora (UTC)"

msgid "Event"
msgstr "Evento"

msgid "Points"
msgstr "Punti"

msgid "Points decay over time, you might see different results on different days."
msgstr "I punti diminuiscono nel tempo, i risultati possono variare da un giorno all'altro."

msgid "never"
msgstr "mai"

msgid "Ban expires"
msgstr "Scadenza ban"

msgid "Reason"
msgstr "Motivo"

msgid "You are currently banned.\n"
msgstr "Sei attualmente bannato.\n"

msgid "Show last infractions of a user"
msgstr "Mostra le ultime infrazioni di un utente"

msgid "This user does not exist. Try {} to find them in the historic data."
msgstr "Questo utente non esiste. Provare {} per trovarlo nei dati storici."

msgid "{victim}, you are a victim of a friendly-fire event by player {offender}.\n"
msgstr "{victim}, sei vittima di un evento di fuoco amico da parte del giocatore {offender}.\n"

msgid "forgive another user for their infraction"
msgstr "perdona un altro utente per la sua infrazione"

msgid "There is nothing to forgive (maybe too late?)"
msgstr "Non c'è nulla da perdonare (forse troppo tardi?)"

msgid "{offender}, You have been forgiven by {victim} and you will not be punished for your recent actions."
msgstr "{offender}, sei stato perdonato da {victim} e non sarai punito per le tue azioni recenti."

msgid "You have chosen to forgive {} for their actions."
msgstr "Hai scelto di perdonare {} per le sue azioni."

msgid "displays your penalty points"
msgstr "mostra i tuoi punti di penalità"

msgid "Penalty points can only be changed from the website."
msgstr "I punti di penalità possono essere modificati solo dal sito web."

msgid "You need the DCS Admin role to change penalty points."
msgstr "Serve il ruolo DCS Admin per modificare i punti di penalità."

msgid "Penalty points must be a whole number between {minimum} and {maximum}."
msgstr "I punti di penalità devono essere un numero intero tra {minimum} e {maximum}."

msgid "A penalty change of 0 does nothing."
msgstr "Una variazione di 0 non ha alcun effetto."

msgid "A UCID is 32 hexadecimal characters."
msgstr "Un UCID è composto da 32 caratteri esadecimali."

msgid "The database is not available."
msgstr "Il database non è disponibile."

msgid "The punishment plugin is not running, so the points cannot be applied."
msgstr "Il plugin punishment non è in esecuzione, quindi i punti non possono essere applicati."

msgid "The penalty points could not be recorded: {error}"
msgstr "Impossibile registrare i punti di penalità: {error}"

msgid "The points were recorded, but the punishment could not be applied: {error}"
msgstr "I punti sono stati registrati, ma la punizione non può essere applicata: {error}"

msgid "The penalty points could not be deleted: {error}"
msgstr "Impossibile eliminare i punti di penalità: {error}"

msgid "The penalty points were deleted, but the ban could not be lifted: {error}"
msgstr "I punti di penalità sono stati eliminati, ma il ban non può essere revocato: {error}"

msgid "This installation runs no server yet."
msgstr "Questa installazione non gestisce ancora alcun server."

msgid "The users punishment points have been reduced by {} points."
msgstr "I punti di punizione dell'utente sono stati ridotti di {} punti."

msgid "changed punishment points of user {ucid} by {points} points."
msgstr "modificati i punti di punizione dell'utente {ucid} di {points} punti."

msgid "{victim}, you are a victim of a {event} event by player {offender}.\n"
msgstr "{victim}, sei vittima di un evento {event} da parte del giocatore {offender}.\n"

msgid "{name}, you have been punished for: {reason}!\nYour current credit points are: {points}"
msgstr "{name}, sei stato punito per: {reason}!\nI tuoi punti credito attuali sono: {points}"

msgid "This will delete all the punishment points for this user and unban them if they were banned.\nAre you sure?"
msgstr "Questo eliminerà tutti i punti di punizione dell'utente e lo sbannerà se era bannato.\nConfermare?"

msgid "You are currently banned.\nPlease contact a member of the server staff, if you want to get unbanned."
msgstr "Sei attualmente bannato.\nContatta un membro dello staff del server se vuoi essere sbannato."

msgid "{victim}, you are a victim of a friendly-fire event by player {offender}.\nIf you send {prefix}forgive in chat within the next {time} seconds, you can pardon the other player."
msgstr "{victim}, sei vittima di un evento di fuoco amico da parte del giocatore {offender}.\nSe invii {prefix}forgive in chat entro i prossimi {time} secondi, puoi perdonare l'altro giocatore."

msgid "Player {player} (ucid={ucid}) kicked from {server} by {kicked_by} for {reason}."
msgstr "Giocatore {player} (ucid={ucid}) espulso dal server {server} da {kicked_by} per {reason}."

msgid "Player {player} (ucid={ucid}) moved to spectators on {server} by {spec_by} for {reason}."
msgstr "Giocatore {player} (ucid={ucid}) spostato agli spettatori sul server {server} da {spec_by} per {reason}."

msgid "The user provided is invalid."
msgstr "L'utente fornito non è valido."

msgid "{initiator}, your seat was unlocked."
msgstr "{initiator}, il tuo posto è stato sbloccato."

msgid "{}, your aircraft must be fitted with a new ejection seat."
msgstr "{}, il tuo velivolo deve essere dotato di un nuovo seggiolino eiettabile."

msgid "{}, your aircraft needs an inspection."
msgstr "{}, il tuo velivolo necessita di un'ispezione."

msgid "Please stand by for {}"
msgstr "Restare in attesa di {}"

msgid "{initiator}, you have been happily rescued and can join a new plane."
msgstr "{initiator}, sei stato felicemente salvato e puoi salire su un nuovo velivolo."

msgid "Player {} (ucid={}) disconnected and reconnected {} seconds after being shot at."
msgstr "Il giocatore {} (ucid={}) si è disconnesso e riconnesso {} secondi dopo essere stato colpito."

msgid "You have chosen to forgive {offender} for their actions."
msgstr "Hai scelto di perdonare {offender} per le sue azioni."

msgid "Player {victim} forgave player {offender} for their actions"
msgstr "Il giocatore {victim} ha perdonato il giocatore {offender} per le sue azioni"
