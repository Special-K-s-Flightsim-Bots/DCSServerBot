msgstr "il database di cluster (config/.secret/clusterdb.pkl e main.yaml) — il database di cluster non è stato verificato, quindi non viene scritto"

msgid "the console's Discord login — no client secret is held, so it stays off"
msgstr "l'accesso Discord della console — nessun client secret disponibile, quindi resta disattivato"

msgid "the extensions are merged into this file"
msgstr "le estensioni sono unite in questo file"

msgid "guild, language, autoupdate"
msgstr "server Discord, lingua, aggiornamento automatico"

msgid "roles, channels, owner"
msgstr "ruoli, canali, proprietario"

msgid "the console and its sign-in"
msgstr "la console e il suo accesso"

msgid "this node, DCS"
msgstr "questo nodo, DCS"

msgid "status/chat/admin channels"
msgstr "canali stato/chat/admin"

