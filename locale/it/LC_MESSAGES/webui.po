msgstr "Istanza"

msgid "DCS port"
msgstr "Porta DCS"

msgid "WebGUI port"
msgstr "Porta WebGUI"

msgid "Coalition"
msgstr "Coalizione"

msgid "Expires"
msgstr "Scade"

msgid "Package"
msgstr "Pacchetto"

msgid "Installed"
msgstr "Installato"

msgid "Last seen"
msgstr "Ultima presenza"

