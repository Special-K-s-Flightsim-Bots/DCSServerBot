msgstr "descrizione schema"

msgid "DCS ME, supplied by the operator"
msgstr "DCS ME, fornito dall'operatore"

msgid "DCS ME and the bases the presets carry"
msgstr "DCS ME e le basi contenute nelle preimpostazioni"

msgid "curated — not read from the tree"
msgstr "curato — non letto dall'albero"

msgid "the widest single layer in clouds.lua"
msgstr "lo strato singolo più ampio in clouds.lua"

msgid "the REST API's precipitation codes"
msgstr "i codici di precipitazione della REST API"

