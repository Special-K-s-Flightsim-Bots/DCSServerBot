msgstr "Un canale amministratori dedicato per server"

msgid "One central admin channel for all servers"
msgstr "Un canale amministratori centrale per tutti i server"

msgid "admin channel"
msgstr "canale amministratori"

msgid "The id of the central admin channel — optional, -1 for none."
msgstr "L'id del canale amministratori centrale — facoltativo, -1 per nessuno."

msgid "Enter at least one role or role id for {role}."
msgstr "Inserire almeno un ruolo o un id di ruolo per {role}."

msgid "A channel id must be a whole number, or -1 for none."
msgstr "L'id di un canale deve essere un numero intero, oppure -1 per nessuno."

msgid "Please enter the name of your DCS group"
msgstr "Inserire il nome del gruppo DCS"

msgid "You now need to setup your users.\nDCSServerBot uses the following internal roles:"
msgstr "Ora occorre configurare gli utenti.\nDCSServerBot usa i seguenti ruoli interni:"

