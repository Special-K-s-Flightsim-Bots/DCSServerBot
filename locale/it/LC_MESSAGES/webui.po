msgstr "{count} mod root installati su {node} — sono attivi anche in questo server e si modificano nella pagina del nodo stesso."

msgid "The root mods of {node} could not be read."
msgstr "Impossibile leggere i mod root di {node}."

msgid "Root mods on {node} →"
msgstr "Mod root su {node} →"

