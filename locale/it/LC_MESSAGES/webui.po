msgstr "Non è stato possibile uscire da questi, quindi espellerlo a mano e verificare di nuovo: {failed}."

msgid "Give every managed server a name."
msgstr "Dare un nome a ogni server gestito."

msgid "Enter the status channel id for {name}."
msgstr "Inserire l'id del canale di stato per {name}."

msgid "The {field} channel id for {name} must be a number, or -1 for none."
msgstr "L'id del canale {field} per {name} deve essere un numero, oppure -1 per nessuno."

msgid "Two servers are named {name}. Names must be unique."
msgstr "Due server si chiamano {name}. I nomi devono essere univoci."

msgid "Guild ID"
msgstr "ID server Discord"

msgid "Right-click your Discord server → Copy Server ID."
msgstr "Tasto destro sul server Discord → Copia ID server."

msgid "→ your application → Bot → Reset Token. This is shown once; the console stores it in config/.secret/."
msgstr "→ la propria applicazione → Bot → Reset Token. Viene mostrato una sola volta; la console lo salva in config/.secret/."

msgid "To obtain the following values, you need to log into the {link}."
msgstr "Per ottenere i valori seguenti è necessario accedere a {link}."

msgid "Owner ID"
msgstr "ID proprietario"

msgid "Right-click your own Discord user → Copy User ID."
msgstr "Tasto destro sul proprio utente Discord → Copia ID utente."

msgid "Do you have more than 10000 members in your Discord server?"
msgstr "Il server Discord ha più di 10000 membri?"

msgid "You need to grant the 'View Audit Log' permission to your bot."
msgstr "È necessario concedere al bot il permesso 'View Audit Log'."

msgid "A token is kept for this step — leave the field empty to reuse it."
msgstr "Un token è conservato per questo passaggio — lasciare il campo vuoto per riutilizzarlo."

msgid "Discord Developer Portal → your application → OAuth2 → Client Secret. Shown once; the console stores it in config/.secret/."
msgstr "Discord Developer Portal → la propria applicazione → OAuth2 → Client Secret. Mostrato una sola volta; la console lo salva in config/.secret/."

msgid "A client secret is kept — leave the field empty to reuse it."
msgstr "Un client secret è conservato — lasciare il campo vuoto per riutilizzarlo."

msgid "Leave it empty and the console's Discord login stays off."
msgstr "Se lasciato vuoto, l'accesso Discord della console resta disattivato."

msgid "Connecting to Discord…"
msgstr "Connessione a Discord…"

msgid "Connected — the bot is in {guild}."
msgstr "Connesso — il bot è in {guild}."

msgid "Enter your Discord Guild ID."
msgstr "Inserire l'ID del server Discord."

msgid "The Guild ID must be a whole number."
msgstr "L'ID del server Discord deve essere un numero intero."

msgid "Enter your Discord Owner ID."
msgstr "Inserire l'ID del proprietario Discord."

msgid "The Owner ID must be a whole number."
msgstr "L'ID del proprietario deve essere un numero intero."

msgid "Enter your Discord TOKEN."
msgstr "Inserire il TOKEN Discord."

msgid "Choose the server to keep."
msgstr "Scegliere il server da mantenere."

msgid "Tick the box to confirm the bot will leave the other servers."
msgstr "Selezionare la casella per confermare che il bot uscirà dagli altri server."

msgid "We now need to setup your Discord roles and channels.\nDCSServerBot creates a role mapping for your bot users. It has the following internal roles:"
msgstr "Ora occorre configurare ruoli e canali Discord.\nDCSServerBot crea una mappatura dei ruoli per gli utenti del bot. Ha i seguenti ruoli interni:"

