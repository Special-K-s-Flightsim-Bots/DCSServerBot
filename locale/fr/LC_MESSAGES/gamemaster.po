msgstr "Aucun message trouvé."

msgid "Error while updating embed!"
msgstr "Erreur lors de la mise à jour de l'embed !"

msgid "Error {} while reading JSON file!"
msgstr "Erreur {} lors de la lecture du fichier JSON !"

msgid "To which server do you want to upload this LUA to?"
msgstr "Sur quel serveur voulez-vous téléverser ce LUA ?"

msgid "File exists. Do you want to overwrite it?"
msgstr "Le fichier existe. Voulez-vous l'écraser ?"

msgid "File {} could not be uploaded."
msgstr "Le fichier {} n'a pas pu être téléversé."

msgid "{num} LUA files uploaded. You can load any of them with {command} now."
msgstr "{num} fichiers LUA téléversés. Vous pouvez en charger n'importe lequel avec {command} maintenant."

msgid "join a coalition"
msgstr "rejoindre une coalition"

msgid "Usage: {prefix}{command} <blue|red>"
msgstr "Utilisation : {prefix}{command} <blue|red>"

msgid "You are a member of coalition {} already."
msgstr "Vous êtes déjà membre d'une coalition {}."

msgid "You can't join the {coalition} coalition in-between {lock_time} of leaving a coalition."
msgstr "Vous ne pouvez pas rejoindre la coalition {coalition} avant {lock_time} après avoir quitté une coalition."

msgid "Welcome to the {} side!"
msgstr "Bienvenue du côté {} !"

msgid "Your coalition password is {}"
msgstr "Le mot de passe de votre coalition est {}"

msgid "leave your coalition"
msgstr "quitter votre coalition"

msgid "You are not a member of any coalition. You can join one with {}join blue|red."
msgstr "Vous n'êtes membre d'aucune coalition. Vous pouvez en rejoindre une avec {}join blue|red."

msgid "You left the {} coalition!"
msgstr "Vous avez quitté la coalition {} !"

msgid "join the red side"
msgstr "rejoindre le camp rouge"

msgid "join the blue side"
msgstr "rejoindre le camp bleu"

msgid "displays your current coalition"
msgstr "affiche votre coalition actuelle"

msgid "You are a member of the {} coalition."
msgstr "Vous êtes membre de la coalition {}."

msgid "displays the coalition password"
msgstr "affiche le mot de passe de la coalition"

msgid "There is no password set for your coalition."
msgstr "Aucun mot de passe n'est défini pour votre coalition."

msgid "reads or sets a flag"
msgstr "lit ou définit un flag"

