msgstr "Serveur {server} ajouté à la campagne {campaign}."

msgid "Server {server} is already part of the campaign {campaign}!"
msgstr "Le serveur {server} fait déjà partie de la campagne {campaign} !"

msgid "Delete a server from a campaign\n"
msgstr "Supprimer un serveur d'une campagne\n"

msgid "Server {server} deleted from campaign {campaign}."
msgstr "Serveur {server} supprimé de la campagne {campaign}."

msgid "Delete a campaign"
msgstr "Supprimer une campagne"

msgid "Do you want to delete campaign \"{}\"?"
msgstr "Voulez-vous supprimer la campagne « {} » ?"

msgid "Campaign deleted."
msgstr "Campagne supprimée."

msgid "Start a campaign"
msgstr "Démarrer une campagne"

msgid "Campaign {} started."
msgstr "Campagne {} démarrée."

msgid "Stop a campaign"
msgstr "Arrêter une campagne"

msgid "Do you want to stop campaign \"{}\"?"
msgstr "Voulez-vous arrêter la campagne « {} » ?"

msgid "Campaign stopped."
msgstr "Campagne arrêtée."

msgid "Sends a message to a user"
msgstr "Envoie un message à un utilisateur"

msgid "User is not linked."
msgstr "L'utilisateur n'est pas lié."

msgid "Unknown user {}!"
msgstr "Utilisateur inconnu {} !"

msgid "Message will be displayed to the user."
msgstr "Le message sera affiché à l'utilisateur."

