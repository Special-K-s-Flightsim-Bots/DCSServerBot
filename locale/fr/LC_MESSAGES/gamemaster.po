msgstr "Retrait de coalition en masse pour les utilisateurs"

msgid "Usage: {}join <blue|red>"
msgstr "Utilisation : {}join <blue|red>"

msgid "Usage: {}flag <flag> [value]"
msgstr "Utilisation : {}flag <flag> [value]"

