msgid "Send a chat message to DCS"
msgstr "Envoie un message de chat à DCS"

msgid "Server {} is not running."
msgstr "Le serveur {} n'est pas en cours d'exécution."

msgid "Message sent."
msgstr "Message envoyé."

msgid "Sends a popup to a coalition\n"
msgstr "Envoie un popup à une coalition\n"

msgid "Sends a popup to all servers"
msgstr "Envoie un popup à tous les serveurs"

msgid "Message NOT sent to server {server} because it is {status}."
msgstr "Message NON envoyé au serveur {server} car il est {status}."

msgid "Message sent to server {}."
msgstr "Message envoyé au serveur {}."

msgid "Set or get a flag inside the mission"
msgstr "Définir ou lire un flag dans la mission"

msgid "Flag {flag} set to {value}."
msgstr "Flag {flag} défini à {value}."

msgid "Flag {flag} has value {value}."
msgstr "Le flag {flag} a la valeur {value}."

msgid "Set or get a mission variable"
msgstr "Définir ou lire une variable de mission"

msgid "Variable {name} set to {value}."
msgstr "Variable {name} définie à {value}."

msgid "Timeout while retrieving variable. Most likely a lua error occurred. Check your dcs.log."
msgstr "Délai dépassé lors de la récupération de la variable. Une erreur lua s'est probablement produite. Vérifiez votre dcs.log."

msgid "Variable {name} has value {value}."
msgstr "La variable {name} a la valeur {value}."

msgid "Variable {} is not set."
msgstr "La variable {} n'est pas définie."

msgid "Calls any function inside the mission"
msgstr "Appelle n'importe quelle fonction dans la mission"

msgid "Lua Script"
msgstr "Script Lua"

msgid "Enter your script here:"
msgstr "Saisissez votre script ici :"

msgid "Script sent."
msgstr "Script envoyé."

msgid "Loads a lua file into the mission"
msgstr "Charge un fichier lua dans la mission"

msgid "Script loaded."
msgstr "Script chargé."

msgid "Reset coalition cooldown"
msgstr "Réinitialiser le délai de coalition"

msgid "The coalition system is not enabled on this server."
msgstr "Le système de coalitions n'est pas activé sur ce serveur."

msgid "Do you want to reset the coalition-bindings from player {}?"
msgstr "Voulez-vous réinitialiser les liaisons de coalition du joueur {} ?"

msgid "Coalition bindings for player {} reset."
msgstr "Liaisons de coalition du joueur {} réinitialisées."

msgid "The bot is missing the \"Manage Roles\" permission!"
msgstr "Le bot n'a pas la permission « Gérer les rôles » !"

msgid "Reset all coalition cooldowns"
msgstr "Réinitialiser tous les délais de coalition"

msgid "Do you want to mass-reset all coalition-bindings from your players?"
msgstr "Voulez-vous réinitialiser en masse toutes les liaisons de coalition de vos joueurs ?"

msgid "Coalition bindings reset for all players on server {}."
msgstr "Liaisons de coalition réinitialisées pour tous les joueurs du serveur {}."

msgid "Coalition bindings reset for all players."
msgstr "Liaisons de coalition réinitialisées pour tous les joueurs."

msgid "Commands to manage DCS campaigns"
msgstr "Commandes pour gérer les campagnes DCS"

msgid "Name"
msgstr "Nom"

msgid "Start (UTC)"
msgstr "Début (UTC)"

msgid "End (UTC)"
msgstr "Fin (UTC)"

msgid "Format for {} needs to be yyyy-mm-dd hh24:mi!"
msgstr "Le format de {} doit être yyyy-mm-dd hh24:mi !"

msgid "Lists all (active) campaigns"
msgstr "Liste toutes les campagnes (actives)"

msgid "Display only active campaigns"
msgstr "Afficher uniquement les campagnes actives"

