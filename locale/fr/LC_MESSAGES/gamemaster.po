msgstr "Abandonné."

msgid "Select all servers for this campaign"
msgstr "Sélectionner tous les serveurs pour cette campagne"

msgid "Campaign {} added."
msgstr "Campagne {} ajoutée."

msgid "A campaign is already configured for this timeframe!"
msgstr "Une campagne est déjà configurée pour cette période !"

