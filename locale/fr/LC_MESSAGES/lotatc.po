msgid "To which server do you want to upload this transponder file to?"
msgstr "Sur quel serveur voulez-vous téléverser ce fichier de transpondeur ?"

msgid "LotAtc is not configured on any server."
msgstr "LotAtc n'est configuré sur aucun serveur."

msgid "Transponder file {} uploaded."
msgstr "Fichier de transpondeur {} téléversé."

msgid "Transponder file {} could not be uploaded!"
msgstr "Le fichier de transpondeur {} n'a pas pu être téléversé !"

msgid "GCI {} on station."
msgstr "GCI {} en poste."

msgid "GCI {} offline."
msgstr "GCI {} hors ligne."

msgid "{num} {coalition} GCI{s} on station."
msgstr "{num} GCI{s} {coalition} en poste."

msgid "{coalition} GCI \"{name}\" on station."
msgstr "GCI {coalition} \"{name}\" en poste."

msgid "{coalition} GCI \"{name}\" offline."
msgstr "GCI {coalition} \"{name}\" hors ligne."

msgid "Shows active GCIs"
msgstr "Affiche les GCI actifs"

msgid "You need to join a side to show their GCIs"
msgstr "Vous devez rejoindre un camp pour afficher ses GCI"

msgid "The following GCIs are active on the {coalition} side:\n{gcis}"
msgstr "Les GCI suivants sont actifs du côté {coalition} :\n{gcis}"

msgid "No GCIs are active on the {} side."
msgstr "Aucun GCI n'est actif du côté {}."

msgid "Information about {coalition} GCI \"{name}\\"
msgstr "Informations sur le GCI {coalition} \"{name}\\"

msgid "Info about a GCI"
msgstr "Informations sur un GCI"

msgid "Usage: {prefix}{command} <name>"
msgstr "Utilisation : {prefix}{command} <name>"

msgid "Commands to manage GCIs"
msgstr "Commandes pour gérer les GCI"

msgid "You are not allowed to see the {} GCIs."
msgstr "Vous n'êtes pas autorisé à voir les GCI {}."

msgid "There are no {coalition} GCIs active in server {server}"
msgstr "Aucun GCI {coalition} n'est actif sur le serveur {server}"

msgid "GCI {} not found."
msgstr "GCI {} introuvable."

msgid "List of GCIs"
msgstr "Liste des GCI"

msgid "List of active {} GCIs"
msgstr "Liste des GCI {} actifs"

msgid "Server: {}"
msgstr "Serveur : {}"

msgid "You are not allowed to play when being a GCI."
msgstr "Vous n'êtes pas autorisé à jouer en tant que GCI."

msgid "GCI {} tried to join as player {}!"
msgstr "Le GCI {} a tenté de rejoindre en tant que joueur {} !"

msgid "active"
msgstr "actif"

msgid "inactive"
msgstr "inactif"
