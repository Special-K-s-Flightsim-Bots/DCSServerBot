msgstr "Nouveaux"

msgid "returning {returning} · new {new} · total {total}"
msgstr "de retour {returning} · nouveaux {new} · total {total}"

msgid "peak {hour}:00 UTC"
msgstr "pic {hour}:00 UTC"

msgid "All servers"
msgstr "Tous les serveurs"

msgid "Period"
msgstr "Période"

msgid "No statistics are available for this period yet: either the installation has no sessions recorded in it, or the statistics read could not be reached."
msgstr "Aucune statistique n'est encore disponible pour cette période : soit l'installation n'a aucune session enregistrée sur celle-ci, soit la lecture des statistiques n'a pas pu être atteinte."

msgid "Nothing recorded in this window."
msgstr "Rien d'enregistré dans cette fenêtre."

msgid "No audit entry matches this view."
msgstr "Aucune entrée d'audit ne correspond à cette vue."

msgid "from %(since)s through %(until)s"
msgstr "du %(since)s au %(until)s"

msgid "since %(since)s"
msgstr "depuis le %(since)s"

msgid "through %(until)s"
msgstr "jusqu'au %(until)s"

msgid "filtered"
msgstr "filtré"

msgid "Entries: %(total)s · %(narrowed)s"
msgstr "Entrées : %(total)s · %(narrowed)s"

msgid "Entries: %(total)s"
msgstr "Entrées : %(total)s"

msgid "No bans are in place on the servers you manage."
msgstr "Aucun bannissement n'est en place sur les serveurs que vous gérez."

msgid "all servers"
msgstr "tous les serveurs"

msgid "never"
msgstr "jamais"

msgid "No log file yet for this server (looked for '{path}' on node '{node}')."
msgstr "Aucun fichier journal pour ce serveur pour l'instant (recherche de '{path}' sur le nœud '{node}')."

msgid "The log restarted while loading older lines — the lines shown are from the previous file."
msgstr "Le journal a redémarré pendant le chargement de lignes plus anciennes — les lignes affichées proviennent du fichier précédent."

msgid "Live state is not available yet. The bot is still starting up."
msgstr "L'état en direct n'est pas encore disponible. Le bot est encore en cours de démarrage."

msgid "No servers are registered on this cluster."
msgstr "Aucun serveur n'est enregistré sur ce cluster."

msgid "This view shows only the servers your roles manage, and none of them are here. An administrator can add your role to a server's managed_by if you should be seeing one."
msgstr "Cette vue n'affiche que les serveurs gérés par vos rôles, et aucun d'eux ne s'y trouve. Un administrateur peut ajouter votre rôle au managed_by d'un serveur si vous devriez en voir un."

msgid "No players are online right now."
msgstr "Aucun joueur n'est en ligne pour le moment."

msgid "No nodes are registered."
msgstr "Aucun nœud n'est enregistré."

msgid "No instances are configured."
msgstr "Aucune instance n'est configurée."

msgid "No instances on this node."
msgstr "Aucune instance sur ce nœud."

msgid "The bot log file is not available yet."
msgstr "Le fichier journal du bot n'est pas encore disponible."

msgid "The bot log file is empty."
msgstr "Le fichier journal du bot est vide."

msgid "No log lines match the selected level."
msgstr "Aucune ligne de journal ne correspond au niveau sélectionné."

msgid "No mission is loaded."
msgstr "Aucune mission n'est chargée."

msgid "No weather is reported."
msgstr "Aucune météo n'est signalée."

msgid "This server is not running."
msgstr "Ce serveur n'est pas en cours d'exécution."

msgid "no DCS on this node"
msgstr "aucun DCS sur ce nœud"

msgid "installed"
msgstr "installé"

msgid "No root mods are installed on {node}."
msgstr "Aucun mod racine n'est installé sur {node}."

msgid "update {version}"
msgstr "mettre à jour {version}"

msgid "Version {version} of {package} is available in the package folder; the installed version is {installed}."
msgstr "La version {version} de {package} est disponible dans le dossier des paquets ; la version installée est {installed}."

msgid "Version {version} of {package} is available in its repository and has to be downloaded before it can be installed."
msgstr "La version {version} de {package} est disponible dans son dépôt et doit être téléchargée avant de pouvoir être installée."

msgid "Killed by AI"
msgstr "Tué par l'IA"

msgid "Killed by a player"
msgstr "Tué par un joueur"

msgid "Crash / own fault"
msgstr "Crash / faute personnelle"

msgid "Active"
msgstr "Actif"

msgid "Forgiven"
msgstr "Pardonné"

msgid "Auto-Unbanned"
msgstr "Débanni automatiquement"

msgid "Identity & access"
msgstr "Identité et accès"

msgid "Server behaviour"
msgstr "Comportement du serveur"

msgid "Requirements"
msgstr "Exigences"

msgid "Anti-cheat"
msgstr "Anti-triche"

msgid "Discord channels"
msgstr "Salons Discord"

msgid "Mission list — owned by a feature of its own"
msgstr "Liste des missions — gérée par une fonctionnalité dédiée"

msgid "Coalition passwords"
msgstr "Mots de passe des coalitions"

msgid "A channel change is applied immediately: the bot rewrites servers.yaml and starts using the new channel at once, with no restart."
msgstr "Une modification de salon s'applique immédiatement : le bot réécrit servers.yaml et utilise le nouveau salon aussitôt, sans redémarrage."

msgid "Renamed by the bot, not by the file: a rename moves the server (its instance folder and its servers.yaml entry) and rewrites the channel names and messages that carry the old name."
msgstr "Renommé par le bot, pas par le fichier : un renommage déplace le serveur (son dossier d'instance et son entrée dans servers.yaml) et réécrit les noms de salons et les messages qui portent l'ancien nom."

msgid "A brief description, shown in /status and in the server list. The Discord editor allows up to 2000 characters."
msgstr "Une brève description, affichée dans /status et dans la liste des serveurs. L'éditeur Discord autorise jusqu'à 2000 caractères."

msgid "Server port"
msgstr "Port du serveur"

msgid "The UDP port DCS listens on. The Discord editor takes a 5-digit value here. A port another server on this node already uses is refused, naming it."
msgstr "Le port UDP sur lequel DCS écoute. L'éditeur Discord accepte ici une valeur à 5 chiffres. Un port déjà utilisé par un autre serveur de ce nœud est refusé, en le nommant."

msgid "Password"
msgstr "Mot de passe"

msgid "The DCS password a client needs to join. The field shows the stored password: leave it as it is to keep it, empty it to remove it, type in it to set a new one."
msgstr "Le mot de passe DCS dont un client a besoin pour se connecter. Le champ affiche le mot de passe stocké : laissez-le tel quel pour le conserver, videz-le pour le supprimer, saisissez-y une valeur pour en définir un nouveau."

msgid "Maximum number of players"
msgstr "Nombre maximal de joueurs"

msgid "The slot count DCS advertises. The Discord editor takes up to three digits here, which is where the 999 ceiling comes from."
msgstr "Le nombre de slots annoncé par DCS. L'éditeur Discord accepte ici jusqu'à trois chiffres, d'où le plafond de 999."

msgid "Public server"
msgstr "Serveur public"

msgid "Lists the server in the public DCS server browser."
msgstr "Répertorie le serveur dans le navigateur public de serveurs DCS."

msgid "Resume mode"
msgstr "Mode de reprise"

msgid "What DCS does when the last client leaves and when a mission loads."
msgstr "Ce que fait DCS lorsque le dernier client part et lorsqu'une mission se charge."

msgid "Maximum allowed ping"
msgstr "Ping maximal autorisé"

msgid "Values above 300 tend to cause lags / desyncs (the editor's own words). 0 turns the check off."
msgstr "Les valeurs supérieures à 300 ont tendance à causer des lags / désynchronisations (termes de l'éditeur). 0 désactive la vérification."

msgid "Server can screenshot"
msgstr "Le serveur peut faire des captures d'écran"

msgid "Lets the server take screenshots (used by plugins that ask a client for a picture)."
msgstr "Autorise le serveur à faire des captures d'écran (utilisé par les plugins qui demandent une image à un client)."

msgid "Allow trial-only clients"
msgstr "Autoriser les clients en version d'essai uniquement"

msgid "Clients that own no module may still join."
msgstr "Les clients qui ne possèdent aucun module peuvent tout de même se connecter."

msgid "Require pure clients"
msgstr "Exiger des clients purs"

msgid "A client with any modification is refused at join."
msgstr "Un client comportant une quelconque modification est refusé à la connexion."

msgid "Require pure scripts"
msgstr "Exiger des scripts purs"

msgid "Modified mission scripts are refused."
msgstr "Les scripts de mission modifiés sont refusés."

msgid "Require pure models"
msgstr "Exiger des modèles purs"

msgid "Modified 3D models are refused."
msgstr "Les modèles 3D modifiés sont refusés."

msgid "Require pure textures"
msgstr "Exiger des textures pures"

msgid "Modified textures are refused."
msgstr "Les textures modifiées sont refusées."

msgid "Allow change tail number"
msgstr "Autoriser le changement de numéro de queue"

msgid "Players may repaint their tail number in the cockpit."
msgstr "Les joueurs peuvent repeindre leur numéro de queue dans le cockpit."

msgid "Allow dynamic radio"
msgstr "Autoriser la radio dynamique"

msgid "Players may tune any radio channel, not only the mission's presets."
msgstr "Les joueurs peuvent accorder n'importe quel canal radio, pas seulement les préréglages de la mission."

msgid "Allow change skin"
msgstr "Autoriser le changement de livrée"

msgid "Players may pick another livery for their aircraft."
msgstr "Les joueurs peuvent choisir une autre livrée pour leur appareil."

msgid "Allow object export"
msgstr "Autoriser l'export d'objets"

msgid "DCS's export switch for third-party tooling that reads the mission state."
msgstr "Le commutateur d'export de DCS pour les outils tiers qui lisent l'état de la mission."

msgid "Allow sensor export"
msgstr "Autoriser l'export de capteurs"

msgid "DCS's export switch for sensor data."
msgstr "Le commutateur d'export de DCS pour les données de capteurs."

msgid "Allow ownship export"
msgstr "Autoriser l'export de l'appareil piloté"

msgid "DCS's export switch for the player's own aircraft."
msgstr "Le commutateur d'export de DCS pour l'appareil piloté par le joueur."

msgid "Allow players pool"
msgstr "Autoriser le pool de joueurs"

msgid "Players nobody slots are held in a pool instead of leaving."
msgstr "Les joueurs sans slot sont gardés dans un pool au lieu de partir."

msgid "Disable all events"
msgstr "Désactiver tous les événements"

msgid "Turns DCS's own mission events off. The bot's event-driven plugins see nothing while it is on."
msgstr "Désactive les événements de mission propres à DCS. Les plugins du bot pilotés par événements ne voient rien tant que cette option est active."

msgid "The missions DCS cycles through, in order. Managed by the mission autoscan and validated at boot — a bad path is a boot failure — so this tab does not edit it."
msgstr "Les missions que DCS enchaîne, dans l'ordre. Gérées par l'autoscan des missions et validées au démarrage — un chemin invalide fait échouer le démarrage — cet onglet ne les modifie donc pas."

msgid "Blue coalition password"
msgstr "Mot de passe de la coalition bleue"

msgid "The password a client picks to join the blue side. The bot stores it and asks DCS to apply it."
msgstr "Le mot de passe qu'un client choisit pour rejoindre le camp bleu. Le bot l'enregistre et demande à DCS de l'appliquer."

msgid "Red coalition password"
msgstr "Mot de passe de la coalition rouge"

msgid "The password a client picks to join the red side. The bot stores it and asks DCS to apply it."
msgstr "Le mot de passe qu'un client choisit pour rejoindre le camp rouge. Le bot l'enregistre et demande à DCS de l'appliquer."

msgid "A coalition password can be changed while the server is running, paused or stopped: the bot sends it to DCS and keeps the cleartext in its database."
msgstr "Un mot de passe de coalition peut être modifié pendant que le serveur est en marche, en pause ou arrêté : le bot l'envoie à DCS et conserve le texte en clair dans sa base de données."

msgid "A password is set outside DCSServerBot — the bot knows only its hash. Type a new one to replace it."
msgstr "Un mot de passe a été défini hors de DCSServerBot — le bot n'en connaît que le hachage. Saisissez-en un nouveau pour le remplacer."

msgid "The bot knows this password but DCS currently carries no hash for it — saving here sets it in DCS too."
msgstr "Le bot connaît ce mot de passe mais DCS n'en porte actuellement aucun hachage — enregistrer ici le définit aussi dans DCS."

msgid "The coalition passwords can only be changed while the server is shutdown, stopped, running or paused. Wait for it to settle, then edit here."
msgstr "Les mots de passe de coalition ne peuvent être modifiés que lorsque le serveur est en cours d'arrêt, arrêté, en marche ou en pause. Attendez qu'il se stabilise, puis modifiez ici."

msgid "The server must be stopped to change its configuration. Stop it on the Servers page, then edit here."
msgstr "Le serveur doit être arrêté pour modifier sa configuration. Arrêtez-le sur la page Serveurs, puis modifiez ici."

msgid "Admin channel"
msgstr "Salon administrateur"

msgid "The channel where admin commands for this server are accepted."
msgstr "Le salon où les commandes d'administration de ce serveur sont acceptées."

msgid "Status channel"
msgstr "Salon d'état"

msgid "Where the bot posts joins, leaves and mission changes."
msgstr "Là où le bot publie les arrivées, les départs et les changements de mission."

msgid "Chat channel"
msgstr "Salon de discussion"

msgid "Relays in-game chat. Not set means the bot relays nowhere."
msgstr "Relaye le chat en jeu. Non défini signifie que le bot ne relaye nulle part."

msgid "Dynamic"
msgstr "Dynamique"

msgid "No Trial Clients"
msgstr "Aucun client d'essai"

msgid "Pure Clients Required"
msgstr "Clients purs requis"

msgid "Pure Scripts Required"
msgstr "Scripts purs requis"

msgid "Pure Models Required"
msgstr "Modèles purs requis"

msgid "Pure Textures Required"
msgstr "Textures pures requises"

msgid "Ownship export"
msgstr "Export de l'appareil piloté"

msgid "Object export"
msgstr "Export d'objets"

msgid "Sensor export"
msgstr "Export de capteurs"

msgid "ascending"
msgstr "croissant"

msgid "descending"
msgstr "décroissant"

msgid "Status"
msgstr "État"

msgid "Elapsed"
msgstr "Écoulé"

msgid "DCS port"
msgstr "Port DCS"

msgid "WebGUI port"
msgstr "Port WebGUI"

msgid "Expires"
msgstr "Expire le"

msgid "Package"
msgstr "Paquet"

msgid "Installed"
msgstr "Installé"

msgid "Last seen"
msgstr "Dernière vue"

msgid "When"
msgstr "Quand"

msgid "Pick anything that sounds like your server. Every tick pre-fills a set of plugins for all the servers you just configured — you can change any of it, and nothing is written yet."
msgstr "Choisissez un nom qui évoque votre serveur. Chaque case cochée pré-remplit un ensemble de plugins pour tous les serveurs que vous venez de configurer — vous pouvez tout modifier, et rien n'est encore écrit."

msgid "Also install"
msgstr "Installer aussi"

msgid "Radio for {instance} — pick one"
msgstr "Radio pour {instance} — choisissez-en une"

msgid "Both at once would fight over the same audio."
msgstr "Les deux à la fois se disputeraient le même audio."

msgid "Found at {path}. Each server gets its own SRS port, two apart, above the ports already in use."
msgstr "Trouvé dans {path}. Chaque serveur obtient son propre port SRS, espacés de deux, au-dessus des ports déjà utilisés."

msgid "Not found on this machine. Install it first, or add the path later in the console. Each server gets its own SRS port, two apart, above the ports already in use."
msgstr "Introuvable sur cette machine. Installez-le d'abord, ou ajoutez le chemin plus tard dans la console. Chaque serveur obtient son propre port SRS, espacés de deux, au-dessus des ports déjà utilisés."

msgid "Built into DCS. Nothing to install; the bot just switches the server side on."
msgstr "Intégré à DCS. Rien à installer ; le bot active simplement le côté serveur."

msgid "Tactical view"
msgstr "Vue tactique"

msgid "Found at {path}. One recorded ACMI per flight."
msgstr "Trouvé dans {path}. Un ACMI enregistré par vol."

msgid "Found at {path}."
msgstr "Trouvé dans {path}."

msgid "Not found on this machine. Install it first, or add the path later in the console."
msgstr "Introuvable sur cette machine. Installez-le d'abord, ou ajoutez le chemin plus tard dans la console."

msgid "There are many more extensions — GCI, weather, persistence, mod manager and others. Every one of them has a form in the web admin console once the bot is running."
msgstr "Il existe bien d'autres extensions — GCI, météo, persistance, gestionnaire de mods et autres. Chacune dispose d'un formulaire dans la console d'administration web une fois le bot en marche."

msgid "Continue"
msgstr "Continuer"

msgid "{instance}: SRS was not found — no port allocated"
msgstr "{instance} : SRS introuvable — aucun port alloué"

msgid "Configuration file could not be written ({ex}): {path}"
msgstr "Le fichier de configuration n'a pas pu être écrit ({ex}) : {path}"

msgid "{path} already exists — left untouched"
msgstr "{path} existe déjà — laissé intact"

msgid "{path} was refused earlier in this commit — not written"
msgstr "{path} a été refusé plus tôt dans cette écriture — non écrit"

msgid "{path} is not written while joining an existing installation"
msgstr "{path} n'est pas écrit lors de l'adhésion à une installation existante"

msgid "{path} is merged while joining an existing installation, never rewritten"
msgstr "{path} est fusionné lors de l'adhésion à une installation existante, jamais réécrit"

msgid "{path}: '{key}' already exists with different values — refusing to overwrite another node's entry."
msgstr "{path} : '{key}' existe déjà avec des valeurs différentes — refus d'écraser l'entrée d'un autre nœud."

msgid "Saved Games instances created: {created}"
msgstr "Instances Saved Games créées : {created}"

msgid "Saved Games instances created: none"
msgstr "Instances Saved Games créées : aucune"

msgid "{instance}: the instance folder could not be created ({ex})"
msgstr "{instance} : le dossier de l'instance n'a pas pu être créé ({ex})"

msgid "Language"
msgstr "Langue"

msgid "General"
msgstr "Général"

msgid "Database"
msgstr "Base de données"

msgid "This node"
msgstr "Ce nœud"

msgid "Discord — the bot"
msgstr "Discord — le bot"

msgid "Discord — roles and channels"
msgstr "Discord — rôles et salons"

msgid "Web console"
msgstr "Console web"

msgid "DCS servers"
msgstr "Serveurs DCS"

msgid "What do you run?"
msgstr "Que faites-vous tourner ?"

msgid "Review and write"
msgstr "Vérifier et écrire"

msgid "Your community"
msgstr "Votre communauté"

msgid "Which language do you speak?"
msgstr "Quelle langue parlez-vous ?"

msgid "Do you want the web admin console?"
msgstr "Voulez-vous la console d'administration web ?"

msgid "Nothing is written yet — the last screen writes your configuration."
msgstr "Rien n'est encore écrit — le dernier écran écrit votre configuration."

msgid "Setup"
msgstr "Installation"

msgid "tap to see the steps"
msgstr "touchez pour voir les étapes"

msgid "Setup steps"
msgstr "Étapes de l'installation"

msgid "The bot can be set to the same language, which means, that all Discord and in-game messages will be in your language as well. Would you like me to configure the bot this way?"
msgstr "Le bot peut être réglé sur la même langue, ce qui signifie que tous les messages Discord et en jeu seront aussi dans votre langue. Voulez-vous que je configure le bot ainsi ?"

msgid "Unticked, the bot keeps its own default language (English) — the console still speaks the language of your browser."
msgstr "Décochée, le bot conserve sa propre langue par défaut (anglais) — la console parle toujours la langue de votre navigateur."

msgid "Preselected from your browser — it sent \"{header}\"."
msgstr "Présélectionnée d'après votre navigateur — il a envoyé \"{header}\"."

msgid "Preselected from the language in the link you followed — the \"{param}\" parameter."
msgstr "Présélectionnée d'après la langue du lien que vous avez suivi — le paramètre \"{param}\"."

msgid "Preselected from the language this console stored for you — the \"{cookie}\" cookie."
msgstr "Présélectionnée d'après la langue que cette console a enregistrée pour vous — le cookie \"{cookie}\"."

msgid "Preselected from the answer you saved to this step on an earlier run."
msgstr "Présélectionnée d'après la réponse que vous avez enregistrée à cette étape lors d'une exécution précédente."

msgid "Preselected from this install's default language — nothing else named one."
msgstr "Présélectionnée d'après la langue par défaut de cette installation — aucune autre source n'en a désigné une."

msgid "Before you start you need PostgreSQL 14 or higher, and a Discord bot token. On a no-Discord install the token is not needed."
msgstr "Avant de commencer, il vous faut PostgreSQL 14 ou supérieur et un token de bot Discord. Sur une installation sans Discord, le token n'est pas nécessaire."

msgid "Do you want your DCSServerBot being auto-updated?"
msgstr "Voulez-vous que votre DCSServerBot soit mis à jour automatiquement ?"

msgid "Do you want to run DCSServerBot with Discord support (recommended)?"
msgstr "Voulez-vous exécuter DCSServerBot avec le support Discord (recommandé) ?"

msgid "Discord is how the bot talks to your admins and players. Without it you manage everything from this console."
msgstr "Discord est le moyen pour le bot de parler à vos administrateurs et joueurs. Sans lui, vous gérez tout depuis cette console."

msgid "This step is not built yet."
msgstr "Cette étape n'est pas encore implémentée."

msgid "Your answers could not be saved — the setup draft was not written, so this step is not recorded. Try again."
msgstr "Vos réponses n'ont pas pu être enregistrées — le brouillon d'installation n'a pas été écrit, cette étape n'est donc pas enregistrée. Réessayez."

msgid "Create a new database"
msgstr "Créer une nouvelle base de données"

msgid "The bot creates its own database and its own user. You enter the PostgreSQL superuser credentials below."
msgstr "Le bot crée sa propre base de données et son propre utilisateur. Vous saisissez ci-dessous les identifiants du superutilisateur PostgreSQL."

msgid "Use an existing database"
msgstr "Utiliser une base de données existante"

msgid "Point the bot at a database that already exists. You enter the credentials the bot should use, not a superuser's."
msgstr "Indiquez au bot une base de données qui existe déjà. Vous saisissez les identifiants que le bot doit utiliser, pas ceux d'un superutilisateur."

msgid "How should the bot get its database?"
msgstr "Comment le bot doit-il obtenir sa base de données ?"

msgid "host"
msgstr "hôte"

msgid "Where PostgreSQL runs. The bot usually runs on the same machine."
msgstr "Là où PostgreSQL s'exécute. Le bot tourne généralement sur la même machine."

msgid "master database"
msgstr "base de données maître"

msgid "The maintenance database of your PostgreSQL server."
msgstr "La base de données de maintenance de votre serveur PostgreSQL."

msgid "master user"
msgstr "utilisateur maître"

msgid "The PostgreSQL superuser the bot uses once, to create its own database and user."
msgstr "Le superutilisateur PostgreSQL que le bot utilise une fois, pour créer sa propre base de données et son utilisateur."

msgid "master password"
msgstr "mot de passe maître"

msgid "database"
msgstr "base de données"

msgid "The database the bot should use."
msgstr "La base de données que le bot doit utiliser."

msgid "user"
msgstr "utilisateur"

msgid "The user the bot connects with."
msgstr "L'utilisateur avec lequel le bot se connecte."

msgid "password"
msgstr "mot de passe"

msgid "Stored in config/.secret/, never on this page again."
msgstr "Stocké dans config/.secret/, plus jamais affiché sur cette page."

msgid "The bot will create the database {database} and the user {user}."
msgstr "Le bot va créer la base de données {database} et l'utilisateur {user}."

msgid "A password is kept for this test — leave the field empty to reuse it."
msgstr "Un mot de passe est conservé pour ce test — laissez le champ vide pour le réutiliser."

msgid "Test connection and create"
msgstr "Tester la connexion et créer"

msgid "Test connection"
msgstr "Tester la connexion"

msgid "Test the connection before you continue."
msgstr "Testez la connexion avant de continuer."

msgid "The user {user} already exists."
msgstr "L'utilisateur {user} existe déjà."

msgid "Reset its password (a new one is generated and stored in config/.secret/)."
msgstr "Réinitialiser son mot de passe (un nouveau est généré et stocké dans config/.secret/)."

msgid "its password"
msgstr "son mot de passe"

msgid "To use DCSServerBot, you need to install PostgreSQL. You can download it {link}."
msgstr "Pour utiliser DCSServerBot, vous devez installer PostgreSQL. Vous pouvez le télécharger {link}."

msgid "here"
msgstr "ici"

msgid "Creating the database…"
msgstr "Création de la base de données…"

msgid "Testing the connection…"
msgstr "Test de la connexion…"

msgid "Continuing…"
msgstr "Poursuite…"

msgid "Federation support"
msgstr "Support de fédération"

msgid "Share resources with another DCSServerBot installation. This adds a second, cluster-wide database to config/main.yaml — only needed when this installation joins an existing federation."
msgstr "Partagez des ressources avec une autre installation DCSServerBot. Cela ajoute une seconde base de données, à l'échelle du cluster, dans config/main.yaml — nécessaire uniquement lorsque cette installation rejoint une fédération existante."

msgid "How should the bot get the cluster database?"
msgstr "Comment le bot doit-il obtenir la base de données du cluster ?"

msgid "Connected to PostgreSQL {version}. Created database {database} and user {user}."
msgstr "Connecté à PostgreSQL {version}. Base de données {database} et utilisateur {user} créés."

msgid "Connected to PostgreSQL {version}. The database {database} was created; the user {user} already existed."
msgstr "Connecté à PostgreSQL {version}. La base de données {database} a été créée ; l'utilisateur {user} existait déjà."

msgid "Connected to PostgreSQL {version}. The database {database} already existed; the bot will migrate it on first start."
msgstr "Connecté à PostgreSQL {version}. La base de données {database} existait déjà ; le bot la migrera au premier démarrage."

msgid "Connected to PostgreSQL {version}. The user {user}'s password was reset and stored in config/.secret/."
msgstr "Connecté à PostgreSQL {version}. Le mot de passe de l'utilisateur {user} a été réinitialisé et stocké dans config/.secret/."

msgid "Connected to {database} (PostgreSQL {version}). The database is empty — the bot will create its tables on first start."
msgstr "Connecté à {database} (PostgreSQL {version}). La base est vide — le bot créera ses tables au premier démarrage."

msgid "Connected. This database already holds DCSServerBot data ({count} tables). The bot will continue from it."
msgstr "Connecté. Cette base contient déjà des données DCSServerBot ({count} tables). Le bot continuera à partir d'elle."

msgid "Connected. This database holds data from an older DCSServerBot ({count} tables). The bot will migrate it on first start."
msgstr "Connecté. Cette base contient les données d'un DCSServerBot plus ancien ({count} tables). Le bot la migrera au premier démarrage."

msgid "Could not connect: the master password was refused."
msgstr "Connexion impossible : le mot de passe maître a été refusé."

msgid "The master user may only use letters, digits, '_' and '-'."
msgstr "L'utilisateur maître ne peut contenir que des lettres, des chiffres, '_' et '-'."

msgid "The master user may not be named after one of the bot's own secret files. Choose another name."
msgstr "L'utilisateur maître ne peut pas porter le nom d'un des fichiers secrets du bot. Choisissez un autre nom."

msgid "Could not connect: nothing is answering on {host}:{port}. Is the PostgreSQL service running?"
msgstr "Connexion impossible : rien ne répond sur {host}:{port}. Le service PostgreSQL est-il démarré ?"

msgid "Could not connect to {host}:{port}."
msgstr "Connexion impossible à {host}:{port}."

msgid "Could not connect: {user} cannot sign in to this database. Check the password, or switch to 'Create a new database' — only the superuser credentials on that path can reset it."
msgstr "Connexion impossible : {user} ne peut pas se connecter à cette base. Vérifiez le mot de passe, ou passez à « Créer une nouvelle base de données » — seuls les identifiants du superutilisateur de cette voie peuvent le réinitialiser."

msgid "Could not connect: the database {database} does not exist."
msgstr "Connexion impossible : la base de données {database} n'existe pas."

msgid "This database contains tables DCSServerBot did not create ({count} tables, e.g. {example}). Choose an empty database, or create a new one."
msgstr "Cette base contient des tables que DCSServerBot n'a pas créées ({count} tables, par ex. {example}). Choisissez une base vide, ou créez-en une nouvelle."

msgid "{database} already exists and holds data. Switch to 'Use an existing database' to adopt it, or enter a different name."
msgstr "{database} existe déjà et contient des données. Passez à « Utiliser une base de données existante » pour l'adopter, ou saisissez un autre nom."

msgid "That password was not accepted ({left} attempts left before the password is reset)."
msgstr "Ce mot de passe n'a pas été accepté ({left} tentatives restantes avant la réinitialisation du mot de passe)."

msgid "The server refused while the database or user was being created (database {database}, user {user}). Check the PostgreSQL log and your superuser's rights, then test again."
msgstr "Le serveur a refusé lors de la création de la base ou de l'utilisateur (base {database}, utilisateur {user}). Consultez le journal PostgreSQL et les droits de votre superutilisateur, puis retestez."

msgid "The connection was verified for these values — nothing has been written yet."
msgstr "La connexion a été vérifiée pour ces valeurs — rien n'a encore été écrit."

msgid "Connected to {database}. This database has the same name as this installation's own — the bot treats a federation by database name, so this will not federate anything."
msgstr "Connecté à {database}. Cette base porte le même nom que celle de cette installation — le bot identifie une fédération par le nom de la base, cela ne fédérera donc rien."

msgid "PostgreSQL {version} is older than the supported {min}."
msgstr "PostgreSQL {version} est plus ancien que la version prise en charge {min}."

msgid "DCS World installation"
msgstr "Installation de DCS World"

msgid "Where DCS World is installed. The bot writes Scripts/MissionScripting.lua there."
msgstr "Là où DCS World est installé. Le bot y écrit Scripts/MissionScripting.lua."

msgid "Other — I will enter the path"
msgstr "Autre — je saisirai le chemin"

msgid "Continue without a DCS installation"
msgstr "Continuer sans installation DCS"

msgid "path"
msgstr "chemin"

msgid "Do you want your DCS installation being auto-updated by the bot?"
msgstr "Voulez-vous que votre installation DCS soit mise à jour automatiquement par le bot ?"

msgid "listen port"
msgstr "port d'écoute"

msgid "Other nodes of this installation talk to this one on this port."
msgstr "Les autres nœuds de cette installation communiquent avec celui-ci sur ce port."

msgid "Is {ip} a static IP-address for this node?"
msgstr "{ip} est-elle une adresse IP statique pour ce nœud ?"

msgid "DCSServerBot can subscribe to the DGSA banlist managed by a group of DCS administrators.\nIt is split into two parts: one for banned DCS players and one for banned Discord users.\nFor public servers, it's recommended to subscribe to this list for optimal security."
msgstr "DCSServerBot peut s'abonner à la banlist DGSA gérée par un groupe d'administrateurs DCS.\nElle est divisée en deux parties : une pour les joueurs DCS bannis et une pour les utilisateurs Discord bannis.\nPour les serveurs publics, il est recommandé de s'abonner à cette liste pour une sécurité optimale."

msgid "Do you want to use the global banlist for DCS players?"
msgstr "Voulez-vous utiliser la banlist globale pour les joueurs DCS ?"

msgid "Do you want to use the global banlist for Discord users?"
msgstr "Voulez-vous utiliser la banlist globale pour les utilisateurs Discord ?"

msgid "The listen port must be a whole number between 1 and 65535."
msgstr "Le port d'écoute doit être un nombre entier entre 1 et 65535."

msgid "Something is already listening on port {port}."
msgstr "Quelque chose écoute déjà sur le port {port}."

msgid "Enter the path to your DCS World installation."
msgstr "Saisissez le chemin de votre installation de DCS World."

msgid "That folder does not exist: {path}. Check the path and try again."
msgstr "Ce dossier n'existe pas : {path}. Vérifiez le chemin et réessayez."

msgid "Choose a DCS World installation, or the last entry."
msgstr "Choisissez une installation de DCS World, ou la dernière entrée."

msgid "Searching for existing DCS server configurations ..."
msgstr "Recherche des configurations de serveur DCS existantes ..."

msgid "{count} found."
msgstr "{count} trouvée(s)."

msgid "No configured DCS servers found. Add one below, or continue and add your servers later in the admin console."
msgstr "Aucun serveur DCS configuré trouvé. Ajoutez-en un ci-dessous, ou continuez et ajoutez vos serveurs plus tard dans la console d'administration."

msgid "instance — the Saved Games folder name"
msgstr "instance — le nom du dossier Saved Games"

msgid "The name of this instance's folder under Saved Games, for example DCS.openbeta. DCSServerBot starts DCS from there."
msgstr "Le nom du dossier de cette instance sous Saved Games, par exemple DCS.openbeta. DCSServerBot démarre DCS depuis là."

msgid "Pick each server's Status, Chat and Admin channels below from your Discord server — create any you are missing there first. The channels are used like this:"
msgstr "Choisissez ci-dessous, dans votre serveur Discord, les salons État, Discussion et Admin de chaque serveur — créez d'abord ceux qui vous manquent. Les salons sont utilisés ainsi :"

msgid "Status Channel — readable by everyone, writable only by the bot."
msgstr "Salon d'état — lisible par tous, inscriptible uniquement par le bot."

msgid "Chat Channel — readable and writable by everyone."
msgstr "Salon de discussion — lisible et inscriptible par tous."

msgid "Admin channel, central or per server — readable and writable only by Admin and DCS Admin users."
msgstr "Salon admin, central ou par serveur — lisible et inscriptible uniquement par les utilisateurs Admin et DCS Admin."

msgid "DCSServerBot needs these permissions on the channels:"
msgstr "DCSServerBot a besoin de ces permissions sur les salons :"

msgid "View Channel"
msgstr "Voir les salons"

msgid "Send Messages"
msgstr "Envoyer des messages"

msgid "Read Messages"
msgstr "Lire les messages"

msgid "Read Message History"
msgstr "Lire l'historique des messages"

msgid "Add Reactions"
msgstr "Ajouter des réactions"

msgid "Attach Files"
msgstr "Joindre des fichiers"

msgid "Embed Links"
msgstr "Intégrer des liens"

msgid "Manage Messages"
msgstr "Gérer les messages"

msgid "The bot is an administrator on your server, so it already holds every permission it needs — nothing to set by hand."
msgstr "Le bot est administrateur sur votre serveur, il possède donc déjà toutes les permissions nécessaires — rien à définir à la main."

msgid "Manage this server through DCSServerBot"
msgstr "Gérer ce serveur via DCSServerBot"

msgid "This server is not managed — channels and settings are set on the console's server page after setup."
msgstr "Ce serveur n'est pas géré — les salons et paramètres se définissent sur la page serveur de la console après l'installation."

msgid "server name"
msgstr "nom du serveur"

msgid "bot port"
msgstr "port du bot"

msgid "autostart"
msgstr "démarrage automatique"

msgid "channels"
msgstr "salons"

msgid "status"
msgstr "état"

msgid "chat"
msgstr "discussion"

msgid "— not set —"
msgstr "— non défini —"

msgid "Chosen from your Discord server."
msgstr "Choisi dans votre serveur Discord."

msgid "Pick one or more roles from your Discord server."
msgstr "Choisissez un ou plusieurs rôles dans votre serveur Discord."

msgid "Discord refused this token, so the bot has no connection and DCSServerBot cannot start. Get the token from the Discord Developer Portal → your application → Bot → Reset Token; it is shown once. If you no longer have it, reset it there and copy the new value — a reset invalidates the old one."
msgstr "Discord a refusé ce token, le bot n'a donc aucune connexion et DCSServerBot ne peut pas démarrer. Récupérez le token dans le portail des développeurs Discord → votre application → Bot → Reset Token ; il n'est affiché qu'une fois. Si vous ne l'avez plus, réinitialisez-le à cet endroit et copiez la nouvelle valeur — une réinitialisation invalide l'ancienne."

msgid "The bot is not in that guild — or the id is wrong."
msgstr "Le bot n'est pas dans ce serveur — ou l'id est faux."

msgid "The bot cannot read that guild — grant it access."
msgstr "Le bot ne peut pas lire ce serveur — accordez-lui l'accès."

msgid "Discord is rate-limiting us — try again in a moment."
msgstr "Discord nous limite en débit — réessayez dans un instant."

msgid "Discord could not be reached — enter the values by hand, or pick them later in the console."
msgstr "Discord est injoignable — saisissez les valeurs à la main, ou choisissez-les plus tard dans la console."

msgid "Discord accepted this token, but the bot is not a member of any Discord server. DCSServerBot manages exactly one server and cannot start without it."
msgstr "Discord a accepté ce token, mais le bot n'est membre d'aucun serveur Discord. DCSServerBot gère exactement un serveur et ne peut pas démarrer sans lui."

msgid "Invite the bot with this link, then test again:"
msgstr "Invitez le bot avec ce lien, puis retestez :"

msgid "Discord accepted this token, but the bot is a member of more than one Discord server, and DCSServerBot allows exactly one."
msgstr "Discord a accepté ce token, mais le bot est membre de plusieurs serveurs Discord, et DCSServerBot n'en autorise qu'un."

msgid "Kick it from every server but the one you keep, then test again. The servers it is in:"
msgstr "Expulsez-le de tous les serveurs sauf celui que vous gardez, puis retestez. Les serveurs où il se trouve :"

msgid "Or let the tour make the bot leave the others: pick the server to keep — it becomes the guild id written to your configuration."
msgstr "Ou laissez l'assistant faire quitter les autres au bot : choisissez le serveur à garder — il devient l'id de serveur écrit dans votre configuration."

msgid "I understand the bot will leave every other server."
msgstr "Je comprends que le bot quittera tous les autres serveurs."

msgid "Leave the other servers"
msgstr "Quitter les autres serveurs"

msgid "The bot left {left}. The server kept is {guild} — that is the guild id your configuration gets."
msgstr "Le bot a quitté {left}. Le serveur gardé est {guild} — c'est l'id de serveur que reçoit votre configuration."

msgid "These could not be left, so kick them by hand and test again: {failed}."
msgstr "Il n'a pas pu quitter ceux-ci, expulsez-les à la main et retestez : {failed}."

msgid "Give every managed server a name."
msgstr "Donnez un nom à chaque serveur géré."

msgid "Enter the status channel id for {name}."
msgstr "Saisissez l'id du salon d'état pour {name}."

msgid "The {field} channel id for {name} must be a number, or -1 for none."
msgstr "L'id du salon {field} pour {name} doit être un nombre, ou -1 pour aucun."

msgid "Two servers are named {name}. Names must be unique."
msgstr "Deux serveurs portent le nom {name}. Les noms doivent être uniques."

msgid "Guild ID"
msgstr "ID du serveur"

msgid "Right-click your Discord server → Copy Server ID."
msgstr "Clic droit sur votre serveur Discord → Copier l'identifiant du serveur."

msgid "→ your application → Bot → Reset Token. This is shown once; the console stores it in config/.secret/."
msgstr "→ votre application → Bot → Reset Token. Il n'est affiché qu'une fois ; la console le stocke dans config/.secret/."

msgid "Discord Developer Portal"
msgstr "Portail des développeurs Discord"

msgid "To obtain the following values, you need to log into the {link}."
msgstr "Pour obtenir les valeurs suivantes, vous devez vous connecter au {link}."

msgid "Owner ID"
msgstr "ID du propriétaire"

msgid "Right-click your own Discord user → Copy User ID."
msgstr "Clic droit sur votre propre utilisateur Discord → Copier l'identifiant de l'utilisateur."

msgid "Do you have more than 10000 members in your Discord server?"
msgstr "Avez-vous plus de 10000 membres sur votre serveur Discord ?"

msgid "You need to grant the 'View Audit Log' permission to your bot."
msgstr "Vous devez accorder la permission « Voir les logs d'audit » à votre bot."

msgid "A token is kept for this step — leave the field empty to reuse it."
msgstr "Un token est conservé pour cette étape — laissez le champ vide pour le réutiliser."

msgid "client secret"
msgstr "secret client"

msgid "Discord Developer Portal → your application → OAuth2 → Client Secret. Shown once; the console stores it in config/.secret/."
msgstr "Portail des développeurs Discord → votre application → OAuth2 → Client Secret. Affiché une fois ; la console le stocke dans config/.secret/."

msgid "A client secret is kept — leave the field empty to reuse it."
msgstr "Un secret client est conservé — laissez le champ vide pour le réutiliser."

msgid "Leave it empty and the console's Discord login stays off."
msgstr "Laissez-le vide et la connexion Discord de la console reste désactivée."

msgid "Connecting to Discord…"
msgstr "Connexion à Discord…"

msgid "Connected — the bot is in {guild}."
msgstr "Connecté — le bot est dans {guild}."

msgid "Enter your Discord Guild ID."
msgstr "Saisissez l'ID de votre serveur Discord."

msgid "The Guild ID must be a whole number."
msgstr "L'ID du serveur doit être un nombre entier."

msgid "Enter your Discord Owner ID."
msgstr "Saisissez votre ID de propriétaire Discord."

msgid "The Owner ID must be a whole number."
msgstr "L'ID du propriétaire doit être un nombre entier."

msgid "Enter your Discord TOKEN."
msgstr "Saisissez votre TOKEN Discord."

msgid "Choose the server to keep."
msgstr "Choisissez le serveur à garder."

msgid "Tick the box to confirm the bot will leave the other servers."
msgstr "Cochez la case pour confirmer que le bot quittera les autres serveurs."

msgid "We now need to setup your Discord roles and channels.\nDCSServerBot creates a role mapping for your bot users. It has the following internal roles:"
msgstr "Nous devons maintenant configurer vos rôles et salons Discord.\nDCSServerBot crée une correspondance de rôles pour les utilisateurs de votre bot. Elle comporte les rôles internes suivants :"

msgid "You can keep the defaults, if unsure and create the respective roles in your Discord server."
msgstr "En cas de doute, vous pouvez garder les valeurs par défaut et créer les rôles correspondants dans votre serveur Discord."

msgid "Users can delete data, change the bot, run commands on your server"
msgstr "Les utilisateurs peuvent supprimer des données, modifier le bot, exécuter des commandes sur votre serveur"

msgid "Users can upload missions, start/stop DCS servers, kick/ban users, etc."
msgstr "Les utilisateurs peuvent téléverser des missions, démarrer/arrêter des serveurs DCS, expulser/bannir des utilisateurs, etc."

msgid "Normal user, can pull statistics, ATIS, etc."
msgstr "Utilisateur normal, peut consulter les statistiques, l'ATIS, etc."

msgid "audit channel"
msgstr "salon d'audit"

msgid "A channel for audit events — optional, -1 for none."
msgstr "Un salon pour les événements d'audit — facultatif, -1 pour aucun."

msgid "The bot can either use a dedicated admin channel for each server or a central admin channel for all servers."
msgstr "Le bot peut utiliser un salon admin dédié à chaque serveur ou un salon admin central pour tous les serveurs."

msgid "A dedicated admin channel per server"
msgstr "Un salon admin dédié par serveur"

msgid "One central admin channel for all servers"
msgstr "Un salon admin central pour tous les serveurs"

msgid "admin channel"
msgstr "salon admin"

msgid "The id of the central admin channel — optional, -1 for none."
msgstr "L'id du salon admin central — facultatif, -1 pour aucun."

msgid "Enter at least one role or role id for {role}."
msgstr "Saisissez au moins un rôle ou un id de rôle pour {role}."

msgid "A channel id must be a whole number, or -1 for none."
msgstr "Un id de salon doit être un nombre entier, ou -1 pour aucun."

msgid "Please enter the name of your DCS group"
msgstr "Veuillez saisir le nom de votre groupe DCS"

msgid "You now need to setup your users.\nDCSServerBot uses the following internal roles:"
msgstr "Vous devez maintenant configurer vos utilisateurs.\nDCSServerBot utilise les rôles internes suivants :"

msgid "Users can delete data and change the bot"
msgstr "Les utilisateurs peuvent supprimer des données et modifier le bot"

msgid "Users can restart missions, kick/ban users, etc."
msgstr "Les utilisateurs peuvent redémarrer des missions, expulser/bannir des utilisateurs, etc."

msgid "These users are UCIDs, not Discord roles"
msgstr "Ces utilisateurs sont des UCID, pas des rôles Discord"

msgid "A UCID is the 32-character player id DCS gives a user — it is not a Discord role, name or id. Enter one UCID per field, exactly 32 characters; use + Add for more users. A role may stay empty: it then grants nothing."
msgstr "Un UCID est l'identifiant de joueur de 32 caractères que DCS attribue à un utilisateur — ce n'est ni un rôle, ni un nom, ni un id Discord. Saisissez un UCID par champ, exactement 32 caractères ; utilisez + Ajouter pour d'autres utilisateurs. Un rôle peut rester vide : il n'accorde alors rien."

msgid "Enter the name of your DCS group."
msgstr "Saisissez le nom de votre groupe DCS."

msgid "'{value}' is not a UCID. A UCID is exactly 32 letters and digits — the DCS player id, not a Discord role or user id. Check the {role} entry."
msgstr "'{value}' n'est pas un UCID. Un UCID est composé d'exactement 32 lettres et chiffres — l'id de joueur DCS, pas un rôle ou un id d'utilisateur Discord. Vérifiez l'entrée {role}."

msgid "Run the web admin console (recommended)"
msgstr "Exécuter la console d'administration web (recommandé)"

msgid "Configure and watch this installation in a browser. Turn this off and DCSServerBot runs bot-only — you edit the YAML files by hand."
msgstr "Configurez et surveillez cette installation dans un navigateur. Désactivez cette option et DCSServerBot tourne en mode bot seul — vous modifiez les fichiers YAML à la main."

msgid "The console is off. DCSServerBot runs bot-only, and enabling the console later is one key in config/services/webservice.yaml."
msgstr "La console est désactivée. DCSServerBot tourne en mode bot seul, et activer la console plus tard se fait avec une clé dans config/services/webservice.yaml."

msgid "public address"
msgstr "adresse publique"

msgid "The address this console is reachable at. Discord sends its login back here, so it must match the redirect you registered."
msgstr "L'adresse à laquelle cette console est joignable. Discord y renvoie sa connexion, elle doit donc correspondre à la redirection que vous avez enregistrée."

msgid "Console account"
msgstr "Compte de la console"

msgid "The console's own sign-in: a username and a password. Only the password's hash is stored. This account always exists — it is how you get into the console when Discord is down."
msgstr "La connexion propre à la console : un nom d'utilisateur et un mot de passe. Seul le hachage du mot de passe est stocké. Ce compte existe toujours — c'est ainsi que vous accédez à la console quand Discord est indisponible."

msgid "username"
msgstr "nom d'utilisateur"

msgid "A password is set — leave the field empty to keep it."
msgstr "Un mot de passe est défini — laissez le champ vide pour le conserver."

msgid "Enter a username for the console account."
msgstr "Saisissez un nom d'utilisateur pour le compte de la console."

msgid "Enter a password for the console account."
msgstr "Saisissez un mot de passe pour le compte de la console."

msgid "The password must be at most {max} characters."
msgstr "Le mot de passe doit comporter au maximum {max} caractères."

msgid "Already done"
msgstr "Déjà fait"

msgid "Will be written, nothing yet"
msgstr "Sera écrit, rien pour l'instant"

msgid "Not written"
msgstr "Non écrit"

msgid "Write configuration"
msgstr "Écrire la configuration"

msgid "Write again"
msgstr "Réécrire"

msgid "written"
msgstr "écrit"

msgid "not written"
msgstr "non écrit"

msgid "What the write did"
msgstr "Ce que l'écriture a fait"

msgid "not attempted — an earlier file was not written"
msgstr "non tenté — un fichier précédent n'a pas été écrit"

msgid "Only the entries marked written reached the disk. The setup is not finished — fix the reason below and write again."
msgstr "Seules les entrées marquées écrit ont atteint le disque. L'installation n'est pas terminée — corrigez la raison ci-dessous et réécrivez."

msgid "the file was not written"
msgstr "le fichier n'a pas été écrit"

msgid "the bot's database and its own user were created (step 3)"
msgstr "la base de données du bot et son propre utilisateur ont été créés (étape 3)"

msgid "the bot's database and its user were verified (step 3)"
msgstr "la base de données du bot et son utilisateur ont été vérifiés (étape 3)"

msgid "the PostgreSQL master password is stored in config/.secret/"
msgstr "le mot de passe maître PostgreSQL est stocké dans config/.secret/"

msgid "the bot's database password is stored in config/.secret/"
msgstr "le mot de passe de la base de données du bot est stocké dans config/.secret/"

msgid "the Discord answers (guild, owner, roles) — Discord support is off"
msgstr "les réponses Discord (serveur, propriétaire, rôles) — le support Discord est désactivé"

msgid "the community answers (group name, users) — Discord support is on"
msgstr "les réponses communauté (nom du groupe, utilisateurs) — le support Discord est activé"

msgid "Missing — enter again"
msgstr "Manquant — saisissez à nouveau"

msgid "A restart dropped a secret this configuration needs, and nothing was written. Go back to the step named below, enter the value again, then write."
msgstr "Un redémarrage a perdu un secret dont cette configuration a besoin, et rien n'a été écrit. Revenez à l'étape indiquée ci-dessous, saisissez à nouveau la valeur, puis écrivez."

msgid "the Discord bot token is not held — enter it again on step 5"
msgstr "le token du bot Discord n'est pas détenu — saisissez-le à nouveau à l'étape 5"

msgid "the database password is not held — enter it again on step 3"
msgstr "le mot de passe de la base de données n'est pas détenu — saisissez-le à nouveau à l'étape 3"

msgid "the cluster database's password is not held — enter it again on step 3"
msgstr "le mot de passe de la base de données du cluster n'est pas détenu — saisissez-le à nouveau à l'étape 3"

msgid "guild, language, autoupdate, the cluster database"
msgstr "serveur, langue, mise à jour auto, la base de données du cluster"

msgid "guild, language, autoupdate, the cluster database — NOT a federation (same database name)"
msgstr "serveur, langue, mise à jour auto, la base de données du cluster — PAS une fédération (même nom de base)"

msgid "the cluster database (config/.secret/clusterdb.pkl and main.yaml) — Federation support is off"
msgstr "la base de données du cluster (config/.secret/clusterdb.pkl et main.yaml) — le support de fédération est désactivé"

msgid "the cluster database (config/.secret/clusterdb.pkl and main.yaml) — the cluster database was not verified, so it is not written"
msgstr "la base de données du cluster (config/.secret/clusterdb.pkl et main.yaml) — la base de données du cluster n'a pas été vérifiée, elle n'est donc pas écrite"

msgid "the console's Discord login — no client secret is held, so it stays off"
msgstr "la connexion Discord de la console — aucun secret client n'est détenu, elle reste donc désactivée"

msgid "the extensions are merged into this file"
msgstr "les extensions sont fusionnées dans ce fichier"

msgid "guild, language, autoupdate"
msgstr "serveur, langue, mise à jour auto"

msgid "roles, channels, owner"
msgstr "rôles, salons, propriétaire"

msgid "the console and its sign-in"
msgstr "la console et sa connexion"

msgid "this node, DCS"
msgstr "ce nœud, DCS"

msgid "status/chat/admin channels"
msgstr "salons état/discussion/admin"

msgid "autostart per server"
msgstr "démarrage automatique par serveur"

msgid "DGSA banlist opt-ins"
msgstr "abonnements à la banlist DGSA"

msgid "the Discord bot token"
msgstr "le token du bot Discord"

msgid "the console's Discord client secret"
msgstr "le secret client Discord de la console"

msgid "the bot's database password"
msgstr "le mot de passe de la base de données du bot"

msgid "the cluster database's password"
msgstr "le mot de passe de la base de données du cluster"

msgid "Setup is done"
msgstr "L'installation est terminée"

msgid "Your configuration is written. The setup console closes now and DCSServerBot starts."
msgstr "Votre configuration est écrite. La console d'installation se ferme maintenant et DCSServerBot démarre."

msgid "The console will be at {url} once it is up."
msgstr "La console sera à l'adresse {url} une fois démarrée."

msgid "Sign in with the console account you just created."
msgstr "Connectez-vous avec le compte de la console que vous venez de créer."

msgid "Add your DCS servers in the console: Servers → Add Server."
msgstr "Ajoutez vos serveurs DCS dans la console : Serveurs → Ajouter un serveur."

msgid "To add or change DCS servers, edit config/nodes.yaml and config/servers.yaml."
msgstr "Pour ajouter ou modifier des serveurs DCS, modifiez config/nodes.yaml et config/servers.yaml."

msgid "The web admin console is off — DCSServerBot runs bot-only until you enable it in config/services/webservice.yaml."
msgstr "La console d'administration web est désactivée — DCSServerBot tourne en mode bot seul jusqu'à ce que vous l'activiez dans config/services/webservice.yaml."

msgid "If it is not running, start it with {script}."
msgstr "S'il n'est pas en marche, démarrez-le avec {script}."

msgid "Open the console"
msgstr "Ouvrir la console"

msgid "No SRS port was set for {instances}: SRS was not found. Add the installation path later in the console."
msgstr "Aucun port SRS n'a été défini pour {instances} : SRS est introuvable. Ajoutez le chemin d'installation plus tard dans la console."

msgid "This node is not configured yet"
msgstr "Ce nœud n'est pas encore configuré"

msgid "This installation is already configured, but it has no entry for the node {node} in config/nodes.yaml, so the bot cannot start on this machine. Is this a new node, or did the hostname of an existing node change?"
msgstr "Cette installation est déjà configurée, mais elle n'a aucune entrée pour le nœud {node} dans config/nodes.yaml, le bot ne peut donc pas démarrer sur cette machine. S'agit-il d'un nouveau nœud, ou le nom d'hôte d'un nœud existant a-t-il changé ?"

msgid "A new node"
msgstr "Un nouveau nœud"

msgid "Add this machine to config/nodes.yaml. Nothing else of this installation is changed."
msgstr "Ajoutez cette machine à config/nodes.yaml. Rien d'autre de cette installation n'est modifié."

msgid "An existing node whose hostname changed"
msgstr "Un nœud existant dont le nom d'hôte a changé"

msgid "Rename one of the configured nodes to {node}. Its configuration and its database rows are carried over, and nothing is added."
msgstr "Renommez l'un des nœuds configurés en {node}. Sa configuration et ses lignes de base de données sont reprises, et rien n'est ajouté."

msgid "node to rename"
msgstr "nœud à renommer"

msgid "I understand: the node picked above was this machine, and it is now called {node}"
msgstr "Je comprends : le nœud choisi ci-dessus était cette machine, et il s'appelle désormais {node}"

