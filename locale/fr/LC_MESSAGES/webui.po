msgid "Theatres"
msgstr "Théâtres"

msgid "share of playtime"
msgstr "part du temps de jeu"

msgid "Top missions"
msgstr "Missions les plus jouées"

msgid "by playtime"
msgstr "par temps de jeu"

msgid "Top modules"
msgstr "Modules les plus utilisés"

msgid "the period's totals, one row each"
msgstr "les totaux de la période, une ligne chacun"

msgid "Most flown theatre"
