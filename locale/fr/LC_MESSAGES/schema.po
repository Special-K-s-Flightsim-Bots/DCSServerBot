#. scheduler_schema:schema;action_map.run_extensions
#: plugins/scheduler/schemas/scheduler_schema.yaml:106
msgid "Apply extensions before the restart or rotation."
msgstr "Applique les extensions avant le redémarrage ou la rotation."

#. scheduler_schema:schema;action_map.coalition_win
#: plugins/scheduler/schemas/scheduler_schema.yaml:96
msgid "Apply the action only when a coalition won the mission."
msgstr "Applique l'action uniquement lorsqu'une coalition a gagné la mission."

#. scheduler_schema:schema;action_map.mission_end
#: plugins/scheduler/schemas/scheduler_schema.yaml:91
msgid "Apply the action only when the mission ends."
msgstr "Applique l'action uniquement à la fin de la mission."

#. logistics_schema:schema;element_schema.tasks.auto_approve
#: plugins/logistics/schemas/logistics_schema.yaml:107
msgid "Approve Discord-created tasks without admin review."
msgstr "Approuve les tâches créées sur Discord sans validation d'un administrateur."

#. menus_schema:schema;command_menu_element.params
#: schemas/menus_schema.yaml:32
msgid "Arguments passed to the command or game event."
msgstr "Arguments transmis à la commande ou à l'événement de jeu."

#. commands_schema:schema;cmd_execute_schema.args
#: plugins/commands/schemas/commands_schema.yaml:16
msgid "Arguments passed to the command; supports placeholders."
msgstr "Arguments transmis à la commande ; prend en charge les placeholders."

#. olympus_schema:schema;instance_olympus_schema.regex;(frontend|client).mapLayers.regex;(.+).attribution
#: extensions/olympus/schemas/olympus_schema.yaml:317
msgid "Attribution text displayed on this map layer."
msgstr "Texte d'attribution affiché sur cette couche de carte."

#. admin_schema:schema;downloads.[0].audit
#: plugins/admin/schemas/admin_schema.yaml:43
msgid "Audit every download of this entry."
msgstr "Audite chaque téléchargement de cette entrée."

#. bot_schema:audit_log
#: services/bot/schemas/bot_schema.yaml:28
msgid "Audit log polling used when privileged intents are off."
msgstr "Interrogation du journal d'audit utilisée lorsque les intents privilégiés sont désactivés."

#. restapi_schema:schema;endpoint.regex;(.+).security.local
#. restapi_schema:schema;security.local
#: plugins/restapi/schemas/restapi_schema.yaml:60 plugins/restapi/schemas/restapi_schema.yaml:103
msgid "Auth required for loopback (local) requests."
msgstr "Authentification requise pour les requêtes loopback (locales)."

#. restapi_schema:schema;endpoint.regex;(.+).security.remote
#. restapi_schema:schema;security.remote
#: plugins/restapi/schemas/restapi_schema.yaml:72 plugins/restapi/schemas/restapi_schema.yaml:115
msgid "Auth required for requests from the internet."
msgstr "Authentification requise pour les requêtes provenant d'Internet."

#. restapi_schema:schema;endpoint.regex;(.+).security.trusted
#. restapi_schema:schema;security.trusted
#: plugins/restapi/schemas/restapi_schema.yaml:66 plugins/restapi/schemas/restapi_schema.yaml:109
msgid "Auth required for requests from trusted networks."
msgstr "Authentification requise pour les requêtes provenant de réseaux de confiance."

#. flightplan_schema:schema;auto_lifecycle_schema.activate_on_takeoff
#: plugins/flightplan/schemas/flightplan_schema.yaml:23
