msgid "Commands to manage music in your (DCS) server"
msgstr "Commandes pour gérer la musique sur votre serveur (DCS)"

msgid "Music Player"
msgstr "Lecteur de musique"

msgid "You don't have any playlists to play. Please create one with {}."
msgstr "Vous n'avez aucune playlist à lire. Veuillez en créer une avec {}."

msgid "Frequency"
msgstr "Fréquence"

msgid "Red"
msgstr "Rouge"

msgid "Blue"
msgstr "Bleu"

msgid "Neutral"
msgstr "Neutre"

msgid "n/a"
msgstr "n/d"

msgid " Now Playing "
msgstr " En lecture "

msgid "Title"
msgstr "Titre"

msgid "Artist"
msgstr "Artiste"

msgid "- empty -"
msgstr "- vide -"

msgid "Pick a song from the list"
msgstr "Choisissez une piste dans la liste"

msgid "Use /music play to access all songs in the list.\n"
msgstr "Utilisez /music play pour accéder à toutes les pistes de la liste.\n"

msgid "Pick a playlist to play"
msgstr "Choisissez une playlist à lire"

msgid "Stop"
msgstr "Arrêter"

msgid "Play"
msgstr "Lire"

msgid "Skip"
msgstr "Passer"

msgid "Repeat"
msgstr "Répéter"

msgid "Shuffle"
msgstr "Aléatoire"

msgid "Change Settings for {}"
msgstr "Modifier les paramètres de {}"

msgid "Frequency (xxx.xx)"
msgstr "Fréquence (xxx.xx)"

msgid "Coalition (1=red | 2=blue)"
msgstr "Coalition (1=rouge | 2=bleu)"

msgid "Display Name"
msgstr "Nom affiché"

msgid "Modulation must be one of AM | FM!"
msgstr "La modulation doit être AM ou FM !"

msgid "Coalition must be 1 or 2!"
msgstr "La coalition doit être 1 ou 2 !"

msgid "Play a song or a playlist\n"
msgstr "Lire une piste ou une playlist\n"

msgid "Server {} is not running."
msgstr "Le serveur {} n'est pas démarré."

msgid "Now playing {} ..."
msgstr "Lecture de {} ..."

msgid "Radio {} started."
msgstr "Radio {} démarrée."

msgid "Stop playing"
msgstr "Arrêter la lecture"

msgid "Radio {} stopped."
msgstr "Radio {} arrêtée."

msgid "Commands to manage music playlists"
msgstr "Commandes pour gérer les playlists musicales"

msgid "Add a song to a playlist"
msgstr "Ajouter une piste à une playlist"

msgid "{title} has been added to playlist {playlist}."
msgstr "{title} a été ajoutée à la playlist {playlist}."

msgid "Add all available songs to a playlist"
msgstr "Ajouter toutes les pistes disponibles à une playlist"

msgid "Do you really want to add ALL songs to the playlist?"
msgstr "Voulez-vous vraiment ajouter TOUTES les pistes à la playlist ?"

msgid "Remove a song from a playlist"
msgstr "Retirer une piste d'une playlist"

msgid "{title} has been removed from playlist {playlist}."
msgstr "{title} a été retirée de la playlist {playlist}."

msgid "Playlist {} deleted."
msgstr "Playlist {} supprimée."

msgid "File exists. Do you want to overwrite it?"
msgstr "Le fichier existe. Voulez-vous l'écraser ?"

msgid "Song {} uploaded."
msgstr "Piste {} envoyée."

msgid "Error {status} while reading file {file}!"
msgstr "Erreur {status} lors de la lecture du fichier {file} !"

msgid "Do you really want to add ALL songs from the `{}` folder to the playlist?"
msgstr "Voulez-vous vraiment ajouter TOUTES les pistes du dossier `{}` à la playlist ?"

msgid "Playlist {} updated."
msgstr "Playlist {} mise à jour."
