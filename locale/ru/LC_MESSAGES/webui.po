msgstr "{label} (узел)"

#: services/webservice/pages/actions.py:3910
msgid "Mission file already on this server"
msgstr "Файл миссии, уже имеющийся на этом сервере"

#: services/webservice/pages/actions.py:3912
msgid "Only files NOT already in the rotation are offered."
msgstr "Предлагаются только файлы, которых ЕЩЁ НЕТ в ротации."

#: services/webservice/pages/actions.py:3917
#, python-brace-format
msgid "Add a mission to {server}?"
msgstr "Добавить миссию на {server}?"

#: services/webservice/pages/actions.py:3944
#: services/webservice/pages/actions.py:3969
#, python-brace-format
msgid "Remove {mission} from the rotation?"
msgstr "Удалить {mission} из ротации?"

#: services/webservice/pages/actions.py:3948
#, python-brace-format
msgid "Remove {count} missions from {server}?"
msgstr "Удалить {count} миссий с {server}?"

#: services/webservice/pages/actions.py:3950
#, python-brace-format
msgid "Remove {count} missions"
msgstr "Удалить {count} миссий"

#: services/webservice/pages/actions.py:3953
#, python-brace-format
msgid "<b>The running mission ({mission}) cannot be removed.</b>"
msgstr "<b>Запущенную миссию ({mission}) нельзя удалить.</b>"

#: services/webservice/pages/dashboard.py:79
#: services/webservice/pages/dashboard.py:82
msgid "Dashboard"
msgstr "Обзор"

#: services/webservice/pages/dashboard.py:80
msgid ""
"Live state of every node, instance and server in the cluster. A server "
"row you may operate carries its own controls."
msgstr ""
"Текущее состояние каждого узла, инстанса и сервера в кластере. Строка "
"сервера, которым ты можешь управлять, несёт собственные элементы "
"управления."

#: services/webservice/pages/dashboard.py:83
msgid "Operations"
msgstr "Операции"

#: services/webservice/pages/dashboard.py:86
#: services/webservice/templates/_state.html:23
msgid "Cluster"
msgstr "Кластер"

#: services/webservice/pages/dashboard.py:169
msgid "Nothing needs you — every node is heartbeating and no server is down."
msgstr ""
"Ты не нужен — все узлы подают признаки жизни, и ни один сервер не "
"выключен."

#: services/webservice/pages/dashboard.py:176
