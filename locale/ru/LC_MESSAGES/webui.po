#: services/webservice/i18n.py:489
msgid "Nothing to show — type a password first, then this reveals what you typed."
msgstr ""
"Показывать нечего — сначала введи пароль, затем это покажет то, что ты "
"ввёл."

#: services/webservice/upgrade.py:66
msgid "no update check yet"
msgstr "проверки обновлений ещё не было"

#: services/webservice/auth/discord_oauth.py:263
msgid "Sign in with Discord"
msgstr "Войти через Discord"

#: services/webservice/auth/routes.py:57
msgid "Sign-in failed. Check your username and password and try again."
msgstr "Не удалось войти. Проверь имя пользователя и пароль и попробуй снова."

#: services/webservice/auth/routes.py:113
msgid "Discord and local sign-in enabled"
msgstr "Включён вход через Discord и локальный вход"

#: services/webservice/auth/routes.py:115
msgid "Discord sign-in enabled"
msgstr "Включён вход через Discord"

#: services/webservice/auth/routes.py:117
msgid "Local sign-in enabled"
msgstr "Включён локальный вход"

#: services/webservice/auth/routes.py:118
msgid "No sign-in method enabled"
msgstr "Ни один способ входа не включён"

#: services/webservice/pages/actions.py:326
msgid ""
"Start and Stop live only here: they act on fewer states than Startup and "
"Shutdown, so they do not earn a place in the strip."
msgstr ""
"Старт и Стоп есть только здесь: они действуют в меньшем числе состояний, "
"чем Запуск и Выключение, поэтому не удостаиваются места в панели."

#: services/webservice/pages/actions.py:334
#, python-brace-format
msgid "{label} — an action on {name} is running; this can take a moment"
msgstr "{label} — на {name} выполняется действие; это может занять минуту"

#: services/webservice/pages/actions.py:335
#, python-brace-format
msgid "{label} — an action on {name} is running"
msgstr "{label} — на {name} выполняется действие"

#: services/webservice/pages/actions.py:488
msgid "Startup"
msgstr "Запуск"

#: services/webservice/pages/actions.py:492
msgid "End maintenance so the server is scheduled again"
msgstr "Завершить обслуживание, чтобы сервер снова попал в расписание"

#: services/webservice/pages/actions.py:494
msgid ""
"On by default, exactly like Discord's /server startup. An unflagged "
"server simply stays unflagged."
msgstr ""
"Включено по умолчанию, точно как /server startup в Discord. Сервер без "
"флага просто остаётся без флага."

#: services/webservice/pages/actions.py:496
msgid "Startup — bring this server up from SHUTDOWN"
msgstr "Запуск — поднять этот сервер из состояния ВЫКЛЮЧЕН"

#: services/webservice/pages/actions.py:497
#, python-brace-format
msgid "Startup server {server}"
msgstr "Запустить сервер {server}"

#: services/webservice/pages/actions.py:498
msgid ""
"It comes back up and rejoins the rotation: with the box below ticked (the"
" default) any maintenance is ended, so the scheduler may start it again. "
"A server that was not in maintenance simply stays that way. This is the "
"DCS-level bring-up, not the process-level Start in the row's menu."
msgstr ""
"Он снова поднимается и возвращается в ротацию: если флажок ниже отмечен "
"(по умолчанию), обслуживание завершается, и планировщик может снова его "
"запустить. Сервер, который не был на обслуживании, просто остаётся таким."
" Это подъём на уровне DCS, а не Старт на уровне процесса в меню строки."

#: services/webservice/pages/actions.py:503
msgid "Start up server"
msgstr "Запустить сервер"

#: services/webservice/pages/actions.py:504
#, python-brace-format
msgid "Start up {server} — ends maintenance so the scheduler may start it"
msgstr ""
"Запустить {server} — завершает обслуживание, чтобы планировщик мог его "
"запустить"

#: services/webservice/pages/actions.py:506
msgid "Start"
msgstr "Старт"

#: services/webservice/pages/actions.py:509
msgid "Start — start a STOPPED server"
msgstr "Старт — запустить ОСТАНОВЛЕННЫЙ сервер"

#: services/webservice/pages/actions.py:510
#, python-brace-format
msgid "Start server {server}"
msgstr "Запустить сервер {server}"

#: services/webservice/pages/actions.py:511
msgid "start a STOPPED server — Startup is the usual one"
msgstr "запустить ОСТАНОВЛЕННЫЙ сервер — обычно используется Запуск"

#: services/webservice/pages/actions.py:513
msgid "Pause"
msgstr "Пауза"

#: services/webservice/pages/actions.py:515
msgid "Pause — freeze the mission; players stay connected"
msgstr "Пауза — заморозить миссию; игроки остаются на связи"

#: services/webservice/pages/actions.py:516
#, python-brace-format
msgid "Pause the mission on {server}"
msgstr "Поставить миссию на паузу на {server}"

#: services/webservice/pages/actions.py:518
msgid "Unpause"
msgstr "Продолжить"

#: services/webservice/pages/actions.py:520
msgid "Unpause — resume the frozen mission"
msgstr "Продолжить — возобновить замороженную миссию"

#: services/webservice/pages/actions.py:521
#, python-brace-format
msgid "Unpause the mission on {server}"
msgstr "Возобновить миссию на {server}"

#: services/webservice/pages/actions.py:523
#: services/webservice/pages/actions.py:1017
msgid "Restart"
msgstr "Перезапуск"

#: services/webservice/pages/actions.py:527
msgid "Restart — players currently flying lose their sortie"
msgstr "Перезапуск — летящие сейчас игроки теряют свой вылет"

#: services/webservice/pages/actions.py:528
#, python-brace-format
msgid "Restart server {server}"
msgstr "Перезапустить сервер {server}"

#: services/webservice/pages/actions.py:529
msgid ""
"<b>Players currently flying lose their sortie.</b> The mission restarts "
"from the beginning — mid-mission progress is gone."
msgstr ""
"<b>Летящие сейчас игроки теряют свой вылет.</b> Миссия перезапускается с "
"начала — прогресс в середине миссии потерян."

#: services/webservice/pages/actions.py:531
msgid ""
"A restart stops the mission, reloads it from the start and the players "
"reconnect to a fresh round. It cannot be undone from here."
msgstr ""
"Перезапуск останавливает миссию, загружает её заново с начала, и игроки "
"переподключаются к новому раунду. Отсюда это отменить нельзя."

#: services/webservice/pages/actions.py:533
msgid "Restart server"
msgstr "Перезапустить сервер"

#: services/webservice/pages/actions.py:534
#, python-brace-format
msgid "Restart {server} — players flying lose their sortie"
msgstr "Перезапустить {server} — летящие игроки теряют свой вылет"

#: services/webservice/pages/actions.py:536
msgid "Shutdown"
msgstr "Выключение"

#: services/webservice/pages/actions.py:542
msgid "Set maintenance so the scheduler does not restart it"
msgstr "Поставить на обслуживание, чтобы планировщик его не перезапускал"

#: services/webservice/pages/actions.py:544
msgid ""
"On by default, exactly like Discord's /server shutdown: without it a "
"scheduled start brings the server straight back."
msgstr ""
"Включено по умолчанию, точно как /server shutdown в Discord: без этого "
"запланированный запуск сразу вернёт сервер."

#: services/webservice/pages/actions.py:546
msgid "Shutdown — stop the DCS server; everyone on it is disconnected"
msgstr "Выключение — остановить сервер DCS; все на нём будут отключены"

#: services/webservice/pages/actions.py:547
#, python-brace-format
msgid "Shutdown server {server}"
msgstr "Выключить сервер {server}"

#: services/webservice/pages/actions.py:548
#, python-brace-format
msgid ""
"<b>{players} players are disconnected</b> and nobody can join until "
"somebody starts the server up again. The box below is ticked by default "
"and puts the server into maintenance — it stays out of service, so the "
"scheduler does not bring it back up. Clear it only to shut the server "
"down without keeping it down."
msgstr ""
"<b>{players} игроков будут отключены</b>, и никто не сможет зайти, пока "
"кто-нибудь не запустит сервер снова. Флажок ниже отмечен по умолчанию и "
"переводит сервер на обслуживание — он остаётся вне работы, поэтому "
"планировщик его не поднимет. Снимай его, только чтобы выключить сервер, "
"не удерживая его выключенным."

#: services/webservice/pages/actions.py:553
msgid ""
"It stays SHUTDOWN on every page until a Startup brings it back — this is "
"the graceful stop, not the process-level Stop in the row's menu."
msgstr ""
"Он остаётся ВЫКЛЮЧЕН на всех страницах, пока Запуск не вернёт его — это "
"корректная остановка, а не Стоп на уровне процесса в меню строки."

#: services/webservice/pages/actions.py:556
#: services/webservice/pages/actions.py:1032
msgid "Shut down"
msgstr "Выключить"

#: services/webservice/pages/actions.py:557
#, python-brace-format
msgid "Shut down {server} — {players} players are disconnected"
msgstr "Выключить {server} — {players} игроков будут отключены"

#: services/webservice/pages/actions.py:559
msgid "Stop"
msgstr "Стоп"

#: services/webservice/pages/actions.py:562
msgid "Stop — stop the server process; players are disconnected"
msgstr "Стоп — остановить процесс сервера; игроки будут отключены"

#: services/webservice/pages/actions.py:563
#, python-brace-format
msgid "Stop server {server}"
msgstr "Остановить сервер {server}"

#: services/webservice/pages/actions.py:564
msgid "stop the server process — players are disconnected"
msgstr "остановить процесс сервера — игроки будут отключены"

#: services/webservice/pages/actions.py:565
#, python-brace-format
msgid ""
"<b>{players} players are disconnected.</b> Stop ends the server process, "
"and nobody can join until a Start brings it back."
msgstr ""
"<b>{players} игроков будут отключены.</b> Стоп завершает процесс сервера,"
" и никто не сможет зайти, пока Старт не вернёт его."

#: services/webservice/pages/actions.py:567
msgid ""
"This is the process-level pair (Stop/Start), not the DCS-level pair "
"(Shutdown/Startup)."
msgstr ""
"Это пара уровня процесса (Стоп/Старт), а не пара уровня DCS "
"(Выключение/Запуск)."

#: services/webservice/pages/actions.py:569
msgid "Stop server process"
msgstr "Остановить процесс сервера"

#: services/webservice/pages/actions.py:570
#, python-brace-format
msgid "Stop {server} — {players} players are disconnected"
msgstr "Остановить {server} — {players} игроков будут отключены"

#: services/webservice/pages/actions.py:585
msgid "Maintenance"
msgstr "Обслуживание"

#: services/webservice/pages/actions.py:587
msgid ""
"Maintenance — keep this server out of service; the scheduler will not "
"start it"
msgstr "Обслуживание — держать этот сервер вне работы; планировщик его не запустит"

#: services/webservice/pages/actions.py:588
#, python-brace-format
msgid "Put server {server} into maintenance"
msgstr "Перевести сервер {server} на обслуживание"

#: services/webservice/pages/actions.py:589
msgid "keep the server out of service — it is not stopped by this"
msgstr "держать сервер вне работы — этим он не останавливается"

#: services/webservice/pages/actions.py:592
msgid "End maintenance"
msgstr "Завершить обслуживание"

#: services/webservice/pages/actions.py:594
msgid "End maintenance — let the scheduler start this server again"
msgstr ""
"Завершить обслуживание — позволить планировщику снова запустить этот "
"сервер"

#: services/webservice/pages/actions.py:595
#, python-brace-format
msgid "Take server {server} out of maintenance"
msgstr "Снять сервер {server} с обслуживания"

#: services/webservice/pages/actions.py:596
msgid "the server may be started again — nothing is started by this"
msgstr "сервер снова может быть запущен — этим ничего не запускается"

#: services/webservice/pages/actions.py:662
#: services/webservice/pages/actions.py:682
#: services/webservice/templates/server_detail.html:552
msgid "Add to the rotation"
msgstr "Добавить в ротацию"

#: services/webservice/pages/actions.py:666
msgid "Load it when the server next starts"
msgstr "Загрузить его при следующем запуске сервера"

#: services/webservice/pages/actions.py:668
msgid "Arms the rotation so this mission is the next one the server loads."
msgstr ""
"Настраивает ротацию так, чтобы эта миссия была следующей, которую "
"загрузит сервер."

#: services/webservice/pages/actions.py:672
msgid "Load it now"
msgstr "Загрузить сейчас"

#: services/webservice/pages/actions.py:674
msgid ""
"Loads it right away — only honoured while the server is running, paused "
"or stopped."
msgstr ""
"Загружает её сразу — учитывается, только пока сервер работает, на паузе "
"или остановлен."

#: services/webservice/pages/actions.py:679
msgid ""
"This mission is already on the server: adding it changes the ROTATION "
"LIST only. No file is copied and nothing is deleted — that is what Upload"
" does."
msgstr ""
"Эта миссия уже есть на сервере: добавление меняет ТОЛЬКО СПИСОК РОТАЦИИ. "
"Ни один файл не копируется и ничего не удаляется — это делает Отправка "
"файла миссии."

#: services/webservice/pages/actions.py:683
#, python-brace-format
msgid "Add the mission to {server}'s rotation list"
msgstr "Добавить миссию в список ротации {server}"

#: services/webservice/pages/actions.py:689
msgid "Remove"
msgstr "Удалить"

#: services/webservice/pages/actions.py:693
msgid "Also delete the mission file from disk"
msgstr "Также удалить файл миссии с диска"

#: services/webservice/pages/actions.py:695
msgid ""
"Removes the primary file, its .dcssb copy and the .orig. This cannot be "
"undone."
msgstr "Удаляет основной файл, его копию .dcssb и .orig. Это нельзя отменить."

#: services/webservice/pages/actions.py:700
msgid ""
"<b>The mission is removed from the rotation list and stops being "
"loaded.</b> The box below is off by default: with it ticked the mission "
"file itself — the primary, its .dcssb copy and the .orig — is deleted "
"from the server, and that cannot be undone."
msgstr ""
"<b>Миссия удаляется из списка ротации и перестаёт загружаться.</b> Флажок"
" ниже по умолчанию снят: если его отметить, сам файл миссии — основной, "
"его копия .dcssb и .orig — удаляется с сервера, и это нельзя отменить."

#: services/webservice/pages/actions.py:704
msgid ""
"Removing it from the list changes the rotation only; the file stays on "
"the server unless you tick the box. Discord's /mission delete asks the "
"same two questions."
msgstr ""
"Удаление из списка меняет только ротацию; файл остаётся на сервере, если "
"ты не отметишь флажок. /mission delete в Discord задаёт те же два "
"вопроса."

#: services/webservice/pages/actions.py:707
#: services/webservice/pages/actions.py:3946
msgid "Remove mission"
msgstr "Удалить миссию"

#: services/webservice/pages/actions.py:708
#, python-brace-format
msgid "Remove the mission from {server}'s rotation list"
msgstr "Удалить миссию из списка ротации {server}"

#: services/webservice/pages/actions.py:710
#: services/webservice/templates/server_detail.html:533
msgid "Load"
msgstr "Загрузить"

#: services/webservice/pages/actions.py:715
#: services/webservice/templates/server_detail.html:610
msgid "Upload mission"
msgstr "Отправить миссию"

#: services/webservice/pages/actions.py:730
#: services/webservice/pages/actions.py:750
#: services/webservice/pages/actions.py:3951
msgid "Remove missions"
msgstr "Удалить миссии"

#: services/webservice/pages/actions.py:734
msgid "Also delete the mission files from disk"
msgstr "Также удалить файлы миссий с диска"

#: services/webservice/pages/actions.py:736
msgid ""
"Removes the primary file, its .dcssb copy and the .orig of EVERY selected"
" mission. This cannot be undone. Left OFF, the mission only leaves the "
"rotation — and while the server's mission auto-scan is on, a mission file"
" left on disk is re-added to the list, so the removal is not permanent."
msgstr ""
"Удаляет основной файл, его копию .dcssb и .orig КАЖДОЙ выбранной миссии. "
"Это нельзя отменить. Если оставить выключенным, миссия лишь покидает "
"ротацию — а пока на сервере включено автосканирование миссий, оставленный"
" на диске файл миссии снова добавляется в список, поэтому удаление не "
"окончательное."

#: services/webservice/pages/actions.py:744
msgid ""
"<b>The selected missions are removed from the rotation list and stop "
"being loaded.</b> The box below is off by default: with it ticked the "
"mission files themselves are deleted from the server, and that cannot be "
"undone."
msgstr ""
"<b>Выбранные миссии удаляются из списка ротации и перестают "
"загружаться.</b> Флажок ниже по умолчанию снят: если его отметить, сами "
"файлы миссий удаляются с сервера, и это нельзя отменить."

#: services/webservice/pages/actions.py:748
msgid ""
"The chosen missions leave the rotation list; their files stay on the "
"server unless you tick the box."
msgstr ""
"Выбранные миссии покидают список ротации; их файлы остаются на сервере, "
"если ты не отметишь флажок."

#: services/webservice/pages/actions.py:751
#, python-brace-format
msgid "Remove the selected missions from {server}'s rotation list"
msgstr "Удалить выбранные миссии из списка ротации {server}"

#: services/webservice/pages/actions.py:755
msgid "Move"
msgstr "Переместить"

#: services/webservice/pages/actions.py:769
#: services/webservice/templates/server_detail.html:443
msgid "Set as start"
msgstr "Сделать стартовой"

#: services/webservice/pages/actions.py:870
msgid "Kick"
msgstr "Кик"

#: services/webservice/pages/actions.py:872
#: services/webservice/pages/actions.py:888
msgid "Reason"
msgstr "Причина"

#: services/webservice/pages/actions.py:873
msgid "Shown to the player in game."
msgstr "Показывается игроку в игре."

#: services/webservice/pages/actions.py:875
msgid "Kick — disconnected now; they may rejoin immediately"
msgstr "Кик — отключён сейчас; может сразу вернуться"

#: services/webservice/pages/actions.py:876
#, python-brace-format
msgid "Kick {player} from {server}"
msgstr "Кикнуть {player} с {server}"

#: services/webservice/pages/actions.py:877
msgid "disconnected now — a kick is not a ban"
msgstr "отключён сейчас — кик это не бан"

#: services/webservice/pages/actions.py:878
#, python-brace-format
msgid ""
"<b>{player} is disconnected from {server} now.</b> They can rejoin "
"immediately — a kick is not a ban and leaves no block behind."
msgstr ""
"<b>{player} сейчас отключён от {server}.</b> Он может сразу вернуться — "
"кик это не бан и не оставляет блокировки."

#: services/webservice/pages/actions.py:880
msgid ""
"A kick ends their session; it blocks nothing and expires with it. Nothing"
" is written to the ban list, so they may be back in the air in a minute."
msgstr ""
"Кик завершает его сессию; он ничего не блокирует и заканчивается вместе с"
" ней. В список банов ничего не записывается, так что через минуту он "
"может снова быть в воздухе."

#: services/webservice/pages/actions.py:883
msgid "Kick player"
msgstr "Кикнуть игрока"

#: services/webservice/pages/actions.py:884
#, python-brace-format
msgid "Kick {player} from {server} — they may rejoin immediately"
msgstr "Кикнуть {player} с {server} — может сразу вернуться"

#: services/webservice/pages/actions.py:886
msgid "Ban"
msgstr "Бан"

#: services/webservice/pages/actions.py:889
msgid "Kept on the ban list."
msgstr "Хранится в списке банов."

#: services/webservice/pages/actions.py:891
msgid "Ban — removed and blocked from rejoining"
msgstr "Бан — удалён и не может вернуться"

#: services/webservice/pages/actions.py:892
#, python-brace-format
msgid "Ban {player} from {server}"
msgstr "Забанить {player} на {server}"

#: services/webservice/pages/actions.py:893
msgid "removed and blocked from rejoining"
msgstr "удалён и не может вернуться"

#: services/webservice/pages/actions.py:894
#, python-brace-format
msgid ""
"<b>{player} is removed from {server} and cannot rejoin it</b> for as long"
" as the ban stands. Empty duration means it never expires on its own."
msgstr ""
"<b>{player} удаляется с {server} и не может вернуться</b>, пока действует"
" бан. Пустая длительность означает, что он никогда не истечёт сам."

#: services/webservice/pages/actions.py:897
msgid ""
"The ban is written to the ban list every installation syncs, so it holds "
"wherever they connect from — not only on this server."
msgstr ""
"Бан записывается в список банов, который синхронизируется каждой "
"установкой, поэтому он действует, откуда бы они ни подключались — не "
"только на этом сервере."

#: services/webservice/pages/actions.py:899
msgid "Ban player"
msgstr "Забанить игрока"

#: services/webservice/pages/actions.py:900
#, python-brace-format
msgid "Ban {player} — empty duration is permanent"
msgstr "Забанить {player} — пустая длительность означает бессрочно"

#: services/webservice/pages/actions.py:902
#: services/webservice/pages/actions.py:903
msgid "Message"
msgstr "Сообщение"

#: services/webservice/pages/actions.py:907
msgid "Chat — a chat line in game, visible to everyone"
msgstr "Чат — строка чата в игре, видимая всем"

#: services/webservice/pages/actions.py:908
#, python-brace-format
msgid "Send a chat line to {player} on {server}"
msgstr "Отправить строку чата {player} на {server}"

#: services/webservice/pages/actions.py:910
msgid "Popup — a private message in game"
msgstr "Всплывающее окно — личное сообщение в игре"

#: services/webservice/pages/actions.py:911
#, python-brace-format
msgid "Send a popup to {player} on {server}"
msgstr "Отправить всплывающее окно {player} на {server}"

#: services/webservice/pages/actions.py:914
msgid "Mute"
msgstr "Мут"

#: services/webservice/pages/actions.py:915
msgid "Mute — they can no longer send chat"
msgstr "Мут — больше не может писать в чат"

#: services/webservice/pages/actions.py:916
#, python-brace-format
msgid "Mute {player} on {server}"
msgstr "Замутить {player} на {server}"

#: services/webservice/pages/actions.py:917
msgid "they can no longer send chat"
msgstr "больше не может писать в чат"

#: services/webservice/pages/actions.py:919
msgid "Unmute"
msgstr "Снять мут"

#: services/webservice/pages/actions.py:920
msgid "Unmute — restore their chat"
msgstr "Снять мут — вернуть ему чат"

#: services/webservice/pages/actions.py:921
#, python-brace-format
msgid "Unmute {player} on {server}"
msgstr "Снять мут с {player} на {server}"

#: services/webservice/pages/actions.py:922
msgid "restore their chat"
msgstr "вернуть ему чат"

#: services/webservice/pages/actions.py:1018
#, python-brace-format
msgid "Restart node — every server on {node} goes down while the node restarts"
msgstr "Перезапуск узла — все серверы на {node} падают, пока узел перезапускается"

#: services/webservice/pages/actions.py:1019
#, python-brace-format
msgid "Restart node {node}"
msgstr "Перезапустить узел {node}"

#: services/webservice/pages/actions.py:1020
msgid "every server on the node goes down"
msgstr "все серверы на узле падают"

#: services/webservice/pages/actions.py:1021
#: services/webservice/pages/actions.py:1053
#, python-brace-format
msgid ""
"<b>Every server on {node} goes down with it</b> — {servers} server(s) and"
" {players} player(s) are on it right now."
msgstr ""
"<b>Все серверы на {node} падают вместе с ним</b> — прямо сейчас на нём "
"{servers} сервер(ов) и {players} игрок(ов)."

#: services/webservice/pages/actions.py:1023
msgid ""
"A node restart ends the bot process on that machine; the launcher there "
"brings the node back, and its servers do not: they stay down until "
"somebody starts them again."
msgstr ""
"Перезапуск узла завершает процесс бота на той машине; тамошний лаунчер "
"возвращает узел, а его серверы — нет: они остаются выключенными, пока "
"кто-нибудь не запустит их снова."

#: services/webservice/pages/actions.py:1026
msgid ""
"<b>This console runs inside that node</b> — restarting it ends the "
"process serving this page, and this window has to be reloaded once the "
"node is back."
msgstr ""
"<b>Эта консоль работает внутри того узла</b> — его перезапуск завершает "
"процесс, обслуживающий эту страницу, и это окно нужно перезагрузить, "
"когда узел вернётся."

#: services/webservice/pages/actions.py:1029
msgid "Restart node"
msgstr "Перезапустить узел"

#: services/webservice/pages/actions.py:1030
#, python-brace-format
msgid "Restart {node} — every server on it goes down"
msgstr "Перезапустить {node} — все серверы на нём падают"

#: services/webservice/pages/actions.py:1033
#, python-brace-format
msgid ""
"Shut down node — every server on {node} goes down and nothing brings it "
"back"
msgstr "Выключить узел — все серверы на {node} падают, и ничто его не вернёт"

#: services/webservice/pages/actions.py:1034
#, python-brace-format
msgid "Shut down node {node}"
msgstr "Выключить узел {node}"

#: services/webservice/pages/actions.py:1035
msgid "every server on the node goes down, for good"
msgstr "все серверы на узле падают, окончательно"

#: services/webservice/pages/actions.py:1036
#, python-brace-format
msgid ""
"<b>{servers} server(s) on {node} go down and {players} player(s) are "
"disconnected, and nothing brings the node back.</b>"
msgstr ""
"<b>{servers} сервер(ов) на {node} падают и {players} игрок(ов) будут "
"отключены, и ничто не вернёт узел.</b>"

#: services/webservice/pages/actions.py:1038
msgid ""
"A node shutdown ends the bot process on that machine for good: somebody "
"has to start the node THERE, at the machine. A node that is down cannot "
"be started from this browser, and its servers stay down with it."
msgstr ""
"Выключение узла навсегда завершает процесс бота на той машине: кто-то "
"должен запустить узел ТАМ, на самой машине. Выключенный узел нельзя "
"запустить из этого браузера, и его серверы остаются выключенными вместе с"
" ним."

#: services/webservice/pages/actions.py:1042
msgid ""
"<b>This console runs inside that node</b> — shutting it down ends the "
"process serving this page, and nothing brings it back until somebody "
"starts the node on that machine."
msgstr ""
"<b>Эта консоль работает внутри того узла</b> — его выключение завершает "
"процесс, обслуживающий эту страницу, и ничто не вернёт его, пока "
"кто-нибудь не запустит узел на той машине."

#: services/webservice/pages/actions.py:1045
msgid "Shut down node"
msgstr "Выключить узел"

#: services/webservice/pages/actions.py:1046
#, python-brace-format
msgid "Shut down {node} — every server on it goes down"
msgstr "Выключить {node} — все серверы на нём падают"

#: services/webservice/pages/actions.py:1048
msgid "Upgrade"
msgstr "Обновление"

#: services/webservice/pages/actions.py:1049
#, python-brace-format
msgid ""
"Upgrade node — update DCSServerBot on {node} and restart it; every server"
" on it goes down"
msgstr ""
"Обновление узла — обновить DCSServerBot на {node} и перезапустить его; "
"все серверы на нём падают"

#: services/webservice/pages/actions.py:1051
#, python-brace-format
msgid "Upgrade node {node}"
msgstr "Обновить узел {node}"

#: services/webservice/pages/actions.py:1052
msgid "update and restart, every server goes down"
msgstr "обновить и перезапустить, все серверы падают"

#: services/webservice/pages/actions.py:1055
msgid ""
"The node is updated and restarted. The console offers Upgrade ONLY while "
"the node itself reports an update pending — it asks every node in the "
"background, never while rendering a page, and this control is gone again "
"once there is nothing to upgrade."
msgstr ""
"Узел обновляется и перезапускается. Консоль предлагает Обновление ТОЛЬКО "
"пока сам узел сообщает об ожидающем обновлении — она опрашивает каждый "
"узел в фоне, никогда при отрисовке страницы, и это управление снова "
"исчезает, как только обновлять больше нечего."

#: services/webservice/pages/actions.py:1059
msgid ""
"<b>This console runs inside that node</b> — upgrading it ends the process"
" serving this page, and this window has to be reloaded once the node is "
"back."
msgstr ""
"<b>Эта консоль работает внутри того узла</b> — его обновление завершает "
"процесс, обслуживающий эту страницу, и это окно нужно перезагрузить, "
"когда узел вернётся."

#: services/webservice/pages/actions.py:1062
msgid "Upgrade node"
msgstr "Обновить узел"

#: services/webservice/pages/actions.py:1063
#, python-brace-format
msgid "Upgrade {node} — every server on it goes down"
msgstr "Обновить {node} — все серверы на нём падают"

#: services/webservice/pages/actions.py:1078
#: services/webservice/pages/actions.py:1102
msgid "Take servers offline"
msgstr "Отключить серверы"

#: services/webservice/pages/actions.py:1081
msgid "Also mark them as maintenance"
msgstr "Также пометить их как обслуживание"

#: services/webservice/pages/actions.py:1083
msgid ""
"On by default: without it a scheduled start can bring the servers back "
"while the node is \"offline\"."
msgstr ""
"Включено по умолчанию: без этого запланированный запуск может вернуть "
"серверы, пока узел \"офлайн\"."

#: services/webservice/pages/actions.py:1085
#, python-brace-format
msgid "Take the servers on {node} offline?"
msgstr "Отключить серверы на {node}?"

#: services/webservice/pages/actions.py:1086
#, python-brace-format
msgid ""
"Take servers offline — every server on {node} that is up is marked as "
"maintenance and stopped; its players are disconnected, while the node's "
"services stay up"
msgstr ""
"Отключить серверы — каждый работающий сервер на {node} помечается как "
"обслуживание и останавливается; его игроки отключаются, а службы узла "
"продолжают работать"

#: services/webservice/pages/actions.py:1089
#, python-brace-format
msgid "Take the servers on {node} out of service"
msgstr "Вывести серверы на {node} из работы"

#: services/webservice/pages/actions.py:1090
msgid "marks the node's servers as maintenance and stops them"
msgstr "помечает серверы узла как обслуживание и останавливает их"

#: services/webservice/pages/actions.py:1091
#, python-brace-format
msgid ""
"<b>{servers} server(s) on {node} go down and {players} player(s) are "
"disconnected.</b> The box below is ticked by default and marks those "
"servers as maintenance — leave it ticked unless you mean to let a "
"scheduled start bring them back while the node is \"offline\"."
msgstr ""
"<b>{servers} сервер(ов) на {node} падают и {players} игрок(ов) будут "
"отключены.</b> Флажок ниже отмечен по умолчанию и помечает эти серверы "
"как обслуживание — оставь его отмеченным, если только ты не хочешь "
"позволить запланированному запуску вернуть их, пока узел \"офлайн\"."

#: services/webservice/pages/actions.py:1095
msgid ""
"Only the SERVERS on the node change. The node itself keeps running, so "
"its services — including this console — stay up, and bringing the node "
"back is a job this browser CAN do. With the box ticked the servers are "
"flagged as maintenance before they stop, so they stay out of service "
"until somebody ends that; clear the box and no flag is written at all — "
"the servers stop and nothing keeps the scheduler from starting them "
"again."
msgstr ""
"Меняются только СЕРВЕРЫ на узле. Сам узел продолжает работать, поэтому "
"его службы — включая эту консоль — остаются доступны, и вернуть узел "
"МОЖНО из этого браузера. Если флажок отмечен, серверы помечаются как "
"обслуживание перед остановкой, поэтому они остаются вне работы, пока "
"кто-нибудь это не завершит; сними флажок, и флаг вообще не записывается —"
" серверы останавливаются, и ничто не мешает планировщику снова их "
"запустить."

#: services/webservice/pages/actions.py:1103
#, python-brace-format
msgid ""
"Take {node} offline — {servers} server(s) go down, {players} player(s) "
"are disconnected"
msgstr ""
"Отключить {node} — {servers} сервер(ов) падают, {players} игрок(ов) будут"
" отключены"

#: services/webservice/pages/actions.py:1110
#: services/webservice/pages/actions.py:1126
msgid "Bring servers online"
msgstr "Включить серверы"

#: services/webservice/pages/actions.py:1112
#, python-brace-format
msgid "Bring the servers on {node} back online?"
msgstr "Вернуть серверы на {node} в строй?"

#: services/webservice/pages/actions.py:1113
msgid ""
"Bring servers online — clear the maintenance flags this node's power-off "
"set and start the servers it stopped; a flag set by hand is left alone"
msgstr ""
"Включить серверы — снять флаги обслуживания, установленные при отключении"
" этого узла, и запустить серверы, которые он остановил; вручную "
"поставленный флаг не трогается"

#: services/webservice/pages/actions.py:1115
#, python-brace-format
msgid "Bring the servers on {node} back into service"
msgstr "Вернуть серверы на {node} в работу"

#: services/webservice/pages/actions.py:1116
msgid "ends the maintenance this node's power-off set, and starts what it stopped"
msgstr ""
"завершает обслуживание, установленное при отключении этого узла, и "
"запускает то, что он остановил"

#: services/webservice/pages/actions.py:1118
msgid ""
"This reverts EXACTLY the last power-off on this node: it clears only the "
"maintenance flags that operation set and starts only the servers it "
"stopped. A flag somebody set by hand is never cleared, and a server that "
"is still in maintenance is never started. If the bot has restarted since "
"the power-off the record is gone, and this then starts every server that "
"is down and not in maintenance, clearing no flag at all — the message "
"says which of the two happened. The node's services were never touched."
msgstr ""
"Это отменяет РОВНО последнее отключение на этом узле: снимаются только "
"флаги обслуживания, установленные той операцией, и запускаются только "
"серверы, которые она остановила. Флаг, поставленный кем-то вручную, "
"никогда не снимается, а сервер, который всё ещё на обслуживании, никогда "
"не запускается. Если бот перезапускался после отключения, запись "
"потеряна, и тогда это запускает каждый выключенный сервер не на "
"обслуживании, не снимая ни одного флага — сообщение говорит, какой из "
"двух случаев произошёл. Службы узла никогда не затрагивались."

#: services/webservice/pages/actions.py:1127
#, python-brace-format
msgid ""
"Bring {node} online — the flags its power-off set are cleared, what it "
"stopped is started"
msgstr ""
"Включить {node} — флаги, поставленные при его отключении, снимаются, "
"остановленное запускается"

#: services/webservice/pages/actions.py:1698
#, python-brace-format
msgid "More controls for {server}"
msgstr "Больше управления для {server}"

#: services/webservice/pages/actions.py:1978
#, python-brace-format
msgid "Controls for node {node}"
msgstr "Управление для узла {node}"

#: services/webservice/pages/actions.py:2174
#, python-brace-format
msgid "Controls for {player} on {server}"
msgstr "Управление для {player} на {server}"

#: services/webservice/pages/actions.py:2309
#, python-brace-format
msgid "{label} {target}?"
msgstr "{label} {target}?"

#: services/webservice/pages/actions.py:2362
#: services/webservice/pages/actions.py:2459
#: services/webservice/pages/actions.py:2614
#: services/webservice/pages/actions.py:3989
msgid "confirm"
msgstr "подтвердить"

#: services/webservice/pages/actions.py:2362
#: services/webservice/pages/actions.py:2614
#: services/webservice/pages/actions.py:3989
msgid "options"
msgstr "параметры"

#: services/webservice/pages/actions.py:2441
msgid "Days (optional)"
msgstr "Дней (необязательно)"

#: services/webservice/pages/actions.py:2442
msgid ""
"Empty = permanent — the ban does not expire on its own. 7 means seven "
"days from now."
msgstr ""
"Пусто = бессрочно — бан не истекает сам. 7 означает семь дней с этого "
"момента."

#: services/webservice/pages/actions.py:2590
#, python-brace-format
