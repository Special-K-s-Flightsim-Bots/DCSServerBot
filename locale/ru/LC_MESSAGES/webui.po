msgstr "параметры"

#: services/webservice/pages/actions.py:3683
#, python-brace-format
msgid "Last update check: {when}."
msgstr "Последняя проверка обновлений: {when}."

#: services/webservice/pages/actions.py:3696
#, python-brace-format
msgid "{label} (node)"
msgstr "{label} (узел)"

#: services/webservice/pages/actions.py:3790
msgid "Not authorized (this target is outside your scope)."
msgstr "Не авторизовано (эта цель вне твоей области)."

#: services/webservice/pages/actions.py:3797
msgid "Not authorized (no signed-in identity)."
msgstr "Не авторизовано (нет вошедшей учётной записи)."

#: services/webservice/pages/actions.py:3798
msgid "Not authorized (this action must be confirmed through its dialog)."
msgstr "Не авторизовано (это действие нужно подтвердить через его диалог)."

#: services/webservice/pages/actions.py:3802
msgid "Not done (the typed name does not match the target)."
msgstr "Не выполнено (введённое имя не совпадает с целью)."

#: services/webservice/pages/actions.py:3807
msgid "A DGSA ban cannot be edited — it can only be lifted here."
msgstr "Бан DGSA нельзя изменить — его можно только снять здесь."

#: services/webservice/pages/actions.py:5085
msgid "Mission file already on this server"
msgstr "Файл миссии, уже имеющийся на этом сервере"

#: services/webservice/pages/actions.py:5087
msgid "Only files NOT already in the rotation are offered."
msgstr "Предлагаются только файлы, которых ЕЩЁ НЕТ в ротации."

#: services/webservice/pages/actions.py:5092
#, python-brace-format
msgid "Add a mission to {server}?"
msgstr "Добавить миссию на {server}?"

#: services/webservice/pages/actions.py:5119 services/webservice/pages/actions.py:5144
#, python-brace-format
msgid "Remove {mission} from the rotation?"
msgstr "Удалить {mission} из ротации?"

#: services/webservice/pages/actions.py:5123
#, python-brace-format
msgid "Remove {count} missions from {server}?"
msgstr "Удалить {count} миссий с {server}?"

#: services/webservice/pages/actions.py:5125
#, python-brace-format
msgid "Remove {count} missions"
msgstr "Удалить {count} миссий"

#: services/webservice/pages/actions.py:5128
#, python-brace-format
msgid "<b>The running mission ({mission}) cannot be removed.</b>"
msgstr "<b>Запущенную миссию ({mission}) нельзя удалить.</b>"

#: services/webservice/pages/actions.py:5493
msgid "Type the name to confirm"
msgstr "Введи имя для подтверждения"

#: services/webservice/pages/actions.py:5494
msgid "The action is refused unless this matches the target's name exactly."
msgstr "Действие будет отклонено, если это не совпадает с именем цели точно."

#: services/webservice/pages/actions.py:5539
msgid "Days (optional)"
msgstr "Дней (необязательно)"

#: services/webservice/pages/actions.py:5540
msgid "Empty = permanent — the ban does not expire on its own. 7 means seven days from now."
msgstr "Пусто = бессрочно — бан не истекает сам. 7 означает семь дней с этого момента."

#: services/webservice/pages/actions.py:5556
msgid "Expires (UTC)"
msgstr "Истекает (UTC)"

#: services/webservice/pages/actions.py:5557
msgid ""
"A UTC date/time: YYYY-MM-DD HH:MM:SS, or less — HH:MM, HH, or the date alone (the current time that day). Empty = "
"permanent."
msgstr ""
"Дата/время UTC: YYYY-MM-DD HH:MM:SS или меньше — HH:MM, HH или только дата (текущее время в тот день). Пусто = "
"бессрочно."

#: services/webservice/pages/actions.py:5588
msgid "Player (UCID)"
msgstr "Игрок (UCID)"

#: services/webservice/pages/actions.py:5589
msgid "The player's UCID, as the ban list records it — e.g. 4b1f9c22."
msgstr "UCID игрока, как его хранит список банов — например, 4b1f9c22."

#: services/webservice/pages/actions.py:5595
msgid "Applies to"
msgstr "Применяется к"

#: services/webservice/pages/actions.py:5596
msgid "All my servers"
msgstr "Все мои серверы"

#: services/webservice/pages/actions.py:5597
msgid "Every server (bot-wide)"
msgstr "Все серверы (глобально)"

#: services/webservice/pages/actions.py:5598
msgid "One server, or every server you manage. A ban on all of them is written to the list every installation syncs."
msgstr ""
"Один сервер или все серверы, которыми ты управляешь. Бан на все из них записывается в список, который синхронизирует "
"каждая установка."

#: services/webservice/pages/actions.py:5603
msgid "Add a ban?"
msgstr "Добавить бан?"

#: services/webservice/pages/actions.py:5604
msgid "the UCID you enter below"
msgstr "UCID, который ты введёшь ниже"

