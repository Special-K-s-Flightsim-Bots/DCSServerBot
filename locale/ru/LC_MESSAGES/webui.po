msgstr "{label} {target}?"

#: services/webservice/pages/actions.py:3299 services/webservice/pages/actions.py:3407
#: services/webservice/pages/actions.py:3528 services/webservice/pages/actions.py:3707
#: services/webservice/pages/actions.py:5164 services/webservice/pages/actions.py:5712
#: services/webservice/pages/actions.py:5803
msgid "confirm"
msgstr "подтвердить"

#: services/webservice/pages/actions.py:3299 services/webservice/pages/actions.py:3707
#: services/webservice/pages/actions.py:5164 services/webservice/pages/actions.py:5712
#: services/webservice/pages/actions.py:5803 services/webservice/pages/actions.py:5981
