# /dcs
msgid "Commands to manage your DCS installations"
msgstr "Команды для управления вашими инсталляциями DCS World"

# /dcs ban
msgid "Bans a user by name or ucid"
msgstr "Банит игрока по имени или ucid"

msgid "Reason"
msgstr "Причина"

msgid "Days (empty = forever)"
msgstr "Дней (пусто = навсегда)"

msgid "Ban Details"
msgstr "Подробности бана"

msgid "Member {} is not linked!"
msgstr "Игрок {} не слинкован!"

msgid "{} is not a valid UCID!"
msgstr "{} не является верным UCID!"

msgid "Player {} banned on all servers"
msgstr "Игрок {} забанен на всех серверах"

msgid " for {} days."
msgstr " (на {} дней)."

# /dcs unban
msgid "Unbans a user by name or ucid"
msgstr "Разбанивает игрока по имени или ucid"

msgid "Player {} unbanned on {}."
msgstr "Игрок {} разбанен на {}."

msgid "Player {} was not banned on {}."
msgstr "Игрок {} не был забанен на {}."

msgid "Shows active bans"
msgstr "Показывает активные баны"

msgid "User with UCID {} is not banned."
msgstr "Игрок с UCID {} не забанен."

# /dcs bans
msgid "Ban Information"
msgstr "Информация о банах"

msgid "<unknown>"
msgstr "<неизвестно>"

msgid "never"
msgstr "никогда"

msgid "Banned by: {}"
msgstr "Кем забанен: {}"

msgid "Exp.: {}"
msgstr "Ист: {}"

# /dcs update
msgid "Update your DCS installations"
msgstr "Обновить вашу инсталляцию DCS"

msgid "Time in seconds to warn users before shutdown"
msgstr "Время в секундах, за которое предупредить игроков о выключении"

msgid "Can't get version information from ED, possible auth-server outage!"
msgstr "Ошибка получения версии от ED, возможно недоступен сервер авторизации!"

msgid "Your installed version {version} is the latest on branch {branch}."
msgstr "Ваша установленная версия {version} является последней в ветке {branch}."

msgid ""
"Would you like to update from version {old_version}@{old_branch} to {new_version}@{new_branch}?\n"
"All running DCS servers will be shut down!"
msgstr ""
"Вы хотите обновиться с версии {old_version}@{old_branch} на версию {new_version}@{new_branch}?\n"
"Все запущенные DCS серверы будут выключены!"

msgid "Updating DCS World to the newest version, please wait ..."
msgstr "Обновляю сервер DCS World до самоей новой версии, пожалуйста подождите ..."

msgid "DCS updated to version {version}@{branch} on node {name}."
msgstr "DCS обновлен до версии {version}@{branch} на ноде {name}."

msgid "DCS World could not be updated on node {name} due to missing disk space!"
msgstr "DCS World не был обновлен на ноде {name}, недостаточно дискового пространства!"

msgid "DCS World updated to version {version}@{branch} on node {name}.\n"
"The updater has requested a **reboot** of the system!"
msgstr "DCS World был обновлен до {version}@{branch} на ноде {name}.\n"
"Обновление запросило **перезагрузку** системы!"

msgid "Error while updating DCS on node {name}, code={rc}"
msgstr "Ошибка во время обновления DCS на ноде {name}, код={rc}"

msgid "The update takes longer than 10 minutes, please check back regularly, if it has finished."
msgstr "Обновление идёт более 10 минут. Пожалуйста, регулярно проверяйте процесс."

msgid "Can't update branch {}. You might need to provide proper DCS credentials to do so."
msgstr "Невозможно обновить ветку {}. Вам может потребоваться ввести данные пользователя DCS вручную."

# /dcs install
msgid "Install modules in your DCS server"
msgstr "Устанавливает модули на ваш сервер DCS"

msgid "Shutdown all servers on node {} for the installation?"
msgstr "Выключить все сервера на ноде {} для установки модулей?"

msgid "Installing module {module} on node {node}, please wait ..."
msgstr "Установка модуля {module} на ноду {node}, пожалуйста подождите ..."

msgid "Module {module} installed on node {node}."
msgstr "Модуль {module} установлен на ноде {node}."

# /dcs uninstall
msgid "Uninstall modules from your DCS server"
msgstr "Удаляет модули с вашего сервера DCS"

msgid "Shutdown all servers on node {} for the uninstallation?"
msgstr "Выключить все сервера на ноде {} для удаления модулей?"

msgid "Aborted."
msgstr "Отмена."

msgid "Module {module} uninstalled on node {node}."
msgstr "Модуль {module} удалён с ноды {node}."

# /download
msgid "Download files from your server"
msgstr "Скачать файлы с вашего сервера"

msgid "File {file} not found in directory {dir}."
msgstr "Файл {file} не найден в каталоге {dir}."

msgid "File sent as a DM."
msgstr "Файл отправлен в личные сообщения."

msgid "Here is your file:"
msgstr "Вот ваш файл:"

msgid "File too large. You need a higher boost level for your server."
msgstr "Файл превышает допустимый размер. Вашему Discord серверу требуется буст."

msgid "File sent to the configured channel."
msgstr "Файл отправлен в настроенный Discord канал."

msgid "File copied to the specified location."
msgstr "Файл скопирован в указанное место."

# /prune
msgid "Prune unused data in the database"
msgstr "Очистить неиспользуемые данные в базе данных"

msgid ":warning: Database Prune :warning:"
msgstr ":warning: Очистка базы данных! :warning:"

msgid ""
"You are going to delete data from your database. Be advised.\n"
"\n"
"Please select the data to be pruned:"
msgstr ""
"Внимание! Вы хотите удалить данные из базы данных! Будьте внимательны! Пожалуйста выберите данные для удаления:"

msgid "We are going to delete all data of user {}. Are you sure?"
msgstr "Мы собираемся удалить все данные по пользователю {}. Вы уверены?"

msgid "We are going to delete all data of server {}. Are you sure?"
msgstr "Мы собираемся удалить все данные по серверу {}. Вы уверены?"

msgid "Data of user {} deleted."
msgstr "Данные пользователя {} удалены."

msgid "Data of server {} deleted."
msgstr "Данные сервера {} удалены."

msgid "No players to prune."
msgstr "Не найдено игроков для удаления."

msgid ""
"This will delete {} players incl. their stats from the database.\n"
"Are you sure?"
msgstr ""
"Эта операция удалит {} игроков и их статистику из базы данных.\n"
"Вы уверены?"

msgid ""
"This will delete all data older than {} days from the database.\n"
"Are you sure?"
msgstr ""
"Эта операция удалит все данные старше {} дней из базы данных.\n"
"Вы уверены?"

msgid "All data older than {} days pruned."
msgstr "Все данные старше {} дней были удалены."

# /node
msgid "Commands to manage your nodes"
msgstr "Команды для управления нодами"

# /node statistics
msgid "Statistics of your nodes"
msgstr "Статистика ваших нод"

# /node list
msgid "Status of all nodes"
msgstr "Статус всех нод"

msgid "DCSServerBot Cluster Overview"
msgstr "Обзор DCSServerBot Cluster"

msgid "🆕 Update available"
msgstr "🆕 Доступно обновление"

msgid "Instance"
msgstr "Инстанс"

msgid "Server"
msgstr "Сервер"

msgid "Status"
msgstr "Статус"

# /node upgrade / restart
msgid "Do you want to {} all nodes?"
msgstr "Вы хотите выполнить {} всех нод?"

msgid "Do you want to {method} node {node}?"
msgstr "Вы хотите выполнить {method} на ноде {node}?"

msgid "upgrade"
msgstr "апгрейд"

msgid "shutdown"
msgstr "выключение"

msgid "restart"
msgstr "перезапуск"

msgid "Node {node} - {method} sent."
msgstr "Нода {node} - запрос на {method} отправлен."

msgid "All nodes are"
msgstr "Все ноды были"

msgid "Master is"
msgstr "Мастер является"

msgid " going to {} **NOW**."
msgstr " будет {} **СЕЙЧАС**."

# /node shutdown
msgid "Shuts a specific node down"
msgstr "Выключение конкретной ноды"

# /node restart
msgid "Restarts a specific node"
msgstr "Перезапуск конкретной ноды"

# /node offline
msgid "Shuts down all servers, enables maintenance"
msgstr "Выключает все сервера, включает режим обслуживания"

msgid "Shuts all servers down (default: on)"
msgstr "Отключает все сервера (по умолчанию: вкл.)"

msgid "Node {} is now offline."
msgstr "Нода {} переведена в режим оффлайн."

# /node online
msgid "Clears the maintenance mode for all servers"
msgstr "Отключение режима обслуживания на всех серверах"

msgid "Start all your servers (default: off)"
msgstr "Запускает все сервера (по умолчанию: выкл.)"

msgid "Node {} is now online."
msgstr "Нода {} теперь онлайн."

# /node upgrade
msgid "Upgrade DCSServerBot"
msgstr "Обновление DCSServerBot"

msgid "There is no upgrade available for "
msgstr "Обновлений не найдено для "

msgid "your cluster"
msgstr "вашего кластера"

msgid "node {}"
msgstr "ноды {}"

msgid "You are trying to upgrade an agent node in a cluster. Are you really sure?"
msgstr "Вы пытаетесь обновить ноду-агент в кластере. Вы точно уверены?"

# /node shell
msgid "Run a shell command on a node"
msgstr "Выполнить команду shell на ноде"

msgid "```Command executed.```"
msgstr "```Команда выполнена.```"

# /reload
msgid "Reloads a plugin"
msgstr "Перезагрузка плагина"

msgid "Plugin {} reloaded."
msgstr "Плагин {} перезагружен."

msgid "Plugin {} could not be reloaded, check the log for details."
msgstr "Плагин {} не мог быть перезагружен, проверьте лог файл."

msgid "All plugins reloaded."
msgstr "Все плагины перезагружены."

msgid "One or more plugins could not be reloaded, check the log for details."
msgstr "Один или несколько плагинов не были перезагружены, проверьте лог файл."

# /node add_instance
msgid "Add/create an instance\n"
msgstr "Добавить/создать инстанс\n"

msgid "Either select an existing instance or enter the name of a new one"
msgstr "Выберите существующий инстанс или введите имя нового"

msgid "Take this instance configuration as a reference"
msgstr "Взять конфигурацию данного инстанса за основу"

msgid "Instance \"{}\" created.\n"
"Do you want to configure a server for this instance?"
msgstr "Инстанс \"{}\" создан.\n"
"Произвести настройку сервера для этого инстанса?"

msgid "Server {server} assigned to instance {instance}."
msgstr "Сервер {server} назначен инстансу {instance}."

msgid "Instance {} created blank with no server assigned."
msgstr "Инстанс {} создан пустым без привязки к серверу."

msgid ""
"Instance {instance} added to node {node}.Please make sure you forward the following ports:```- DCS Port:    "
"{dcs_port} (TCP/UDP)- WebGUI Port: {webgui_port} (TCP)```"
msgstr ""
"Инстанс {instance} добавлен к ноде {node}.Убедитесь, что выполнен проброс следующих портов:```- DCS Порт:    "
"{dcs_port} (TCP/UDP)- WebGUI Порт: {webgui_port} (TCP)```"

msgid "Instance {instance} could not be added to node {node}, see log."
msgstr ""
"Инстанс {instance} не был добавлен к ноде {node}.\n"
"Проверьте лог файл."

# /node delete_instance
msgid "Delete an instance\n"
msgstr "Удаление инстанса\n"

msgid "The instance is in use by server \"{}\".\n"
"Do you really want to delete it?"
msgstr "Этот инстанс используется на сервере \"{}\".\n"
"Вы действительно хотите удалить его?"

msgid "Do you really want to delete instance {}?"
msgstr "Вы действительно хотите удалить инстанс {}?"

msgid "Do you want to remove the directory\n{}?"
msgstr "Вы хотите удалить директорию\n{}?"

msgid "Instance {instance} removed from node {node}."
msgstr "Инстанс {instance} удален с ноды {node}."

msgid "Instance {} could not be deleted, because the directory is in use."
msgstr "Инстанс {} не может быть удален, так как директория уже используется."

# /node rename_instance
msgid "Rename an instance\n"
msgstr "Переименовать инстанс\n"

msgid "Server {} has to be shut down before renaming the instance!"
msgstr "Сервер {} необходимо выключить перед переименованием инстанса!"

msgid "Do you really want to rename instance {}?"
msgstr "Вы действительно хотите переименовать инстанс {}?"

msgid "Instance {old_name} renamed to {new_name}."
msgstr "Инстанс {old_name} переименован в {new_name}."

msgid "Instance {} could not be renamed, because the directory is in use."
msgstr "Инстанс {} не может быть переименован, так как директория уже используется."

# Config upload
msgid "To which server do you want to upload this configuration to?"
msgstr "На какой сервер вы хотите загрузить эту конфигурацию?"

msgid "Error while uploading file to node {}!"
msgstr "Ошибка при загрузке файла на ноду {}!"

msgid "Error while reading file from discord."
msgstr "Ошибка чтения файла из Discord."

msgid "Plugin {} re-loaded."
msgstr "Плагин {} перезагружен."

msgid "To apply the new config by restarting a node or the whole cluster, use {}"
msgstr "Для применения новой конфигурации перезапуском ноды или всего кластера, используйте команду {}"

# /webadmin status
msgid "A configuration change applies on the next node restart, not on a page reload."
msgstr "Изменение конфигурации вступает в силу при следующем перезапуске узла, а не при обновлении страницы."

# /webadmin status
msgid "Configuration file"
msgstr "Файл конфигурации"

# /webadmin status
msgid "Frontend"
msgstr "Веб-интерфейс"

# /webadmin status
msgid "frontend is off — the service serves the REST API only: no page, no login, no session cookie. Set frontend: true."
msgstr "frontend выключен — сервис отдаёт только REST API: ни страниц, ни входа, ни cookie сессии. Установите frontend: true."

# /webadmin status
msgid "username and password"
msgstr "логин и пароль"

# /webadmin status
msgid "Discord"
msgstr "Discord"

# /webadmin status
msgid "break-glass credential"
msgstr "аварийные учётные данные"

# /webadmin status
msgid "Login"
msgstr "Вход"

# /webadmin status
msgid "The login block is empty — every page answers 403. Enable at least one of auth.local, auth.discord or auth.breakglass."
msgstr "Блок входа пуст — каждая страница отвечает 403. Включите хотя бы один из auth.local, auth.discord или auth.breakglass."

# /webadmin status
msgid "Session secret"
msgstr "Секрет сессии"

# /webadmin status
msgid "Public address"
msgstr "Публичный адрес"

# /webadmin status
msgid "Service"
msgstr "Сервис"

# /webadmin status
msgid "Next step"
msgstr "Следующий шаг"

# /webadmin status
msgid "Inspects the configuration of the admin website"
msgstr "Проверяет конфигурацию административного сайта"

# /webadmin status
msgid "frontend is on — the pages, the login and the session cookie are installed."
msgstr "frontend включён — страницы, вход и cookie сессии установлены."

# /webadmin status
msgid "session.secret is not set — a random key is generated at every start, so everyone is signed out when the node restarts. Set a secret of at least 32 characters."
msgstr "session.secret не задан — при каждом запуске создаётся случайный ключ, поэтому при перезапуске узла все выходят из системы. Задайте секрет не короче 32 символов."

# /webadmin status
msgid "auth.public_base_url is not set — redirect URIs are built from it, so a Discord login cannot return. Set the address your users open, e.g. https://dcs.example.com."
msgstr "auth.public_base_url не задан — URI перенаправления строятся из него, поэтому вход через Discord не сможет вернуться. Укажите адрес, который открывают ваши пользователи, например https://dcs.example.com."

# /webadmin status
msgid "The website runs on the master node only — this is not the master, so nothing is served here. Run the check on the master."
msgstr "Сайт работает только на master-узле — это не master, поэтому здесь ничего не отдаётся. Запустите проверку на master."

# /webadmin status
msgid "The service is loaded but not running, so nothing answers on a port. Restart the node."
msgstr "Сервис загружен, но не запущен, поэтому ни один порт не отвечает. Перезапустите узел."

# /webadmin status
msgid "Website status"
msgstr "Состояние сайта"

# /webadmin status
msgid "Shows which part of the website configuration is missing"
msgstr "Показывает, какой части конфигурации сайта не хватает"

# /webadmin status
msgid "{} found."
msgstr "{} найден."

# /webadmin status
msgid "session.secret is set ({} characters) — sessions survive a node restart."
msgstr "session.secret задан ({} символов) — сессии переживают перезапуск узла."

# /webadmin status
msgid "auth.public_base_url is {} — redirect URIs are built from it."
msgstr "auth.public_base_url — {}; URI перенаправления строятся из него."

# /webadmin status
msgid "The service is not loaded on this node — {} is read at startup. Restart the node."
msgstr "Сервис не загружен на этом узле — {} читается при запуске. Перезапустите узел."

# /webadmin status
msgid "The address is not known yet."
msgstr "Адрес пока неизвестен."

# /webadmin status
msgid "{} is missing — no website service exists without it. Run /webadmin setup to create it."
msgstr "{} отсутствует — без него сервиса сайта не существует. Запустите /webadmin setup, чтобы создать его."

# /webadmin status
msgid "Login is enabled for: {}."
msgstr "Вход включён для: {}."

# /webadmin status
msgid "session.secret is only {} characters long — a key shorter than 32 characters is refused at startup. Use at least 32."
msgstr "session.secret длиной всего {} символов — ключ короче 32 символов отклоняется при запуске. Используйте не менее 32."

# /webadmin status
msgid "auth.public_base_url is not an absolute http(s) address ({}) — redirect URIs are built from it."
msgstr "auth.public_base_url не является абсолютным адресом http(s) ({}) — URI перенаправления строятся из него."

# /webadmin status
msgid "auth.public_base_url points at this machine only ({}) — a Discord login comes back to this machine and nowhere else. Set the address your users open."
msgstr "auth.public_base_url указывает только на эту машину ({}) — вход через Discord возвращается только сюда. Укажите адрес, который открывают ваши пользователи."

# /webadmin status
msgid "The service is running on this node, port {}."
msgstr "Сервис работает на этом узле, порт {}."

# /webadmin status
msgid "Open {}."
msgstr "Откройте {}."

# /webadmin setup
msgid "Not chosen yet — pick a sign-in mode from the list below."
msgstr "Ещё не выбрано — выберите способ входа в списке ниже."

# /webadmin setup
msgid "Everything is collected — press the button below to write the configuration."
msgstr "Всё собрано — нажмите кнопку ниже, чтобы записать конфигурацию."

# /webadmin setup
msgid "Discord login and a local account"
msgstr "Вход через Discord и локальная учётная запись"

# /webadmin setup
msgid "Manual"
msgstr "Вручную"

# /webadmin setup
msgid "Pick how you sign in from the list below."
msgstr "Выберите ниже в списке, как вы входите."

# /webadmin setup
msgid "Fill in the form the wizard opened."
msgstr "Заполните форму, которую открыл мастер."

# /webadmin setup
msgid "The configuration keeps auth.discord.client_secret_key: discord_client_secret."
msgstr "Конфигурация сохраняет auth.discord.client_secret_key: discord_client_secret."

# /webadmin setup
msgid "Client secret"
msgstr "Секрет клиента"

# /webadmin setup
msgid "Username"
msgstr "Имя пользователя"

# /webadmin setup
msgid "Website setup"
msgstr "Настройка веб-сайта"

# /webadmin setup
msgid "Turns the admin website on and stores the login secret"
msgstr "Включает веб-сайт администратора и сохраняет секрет входа"

# /webadmin setup
msgid "Listen"
msgstr "Адрес прослушивания"

# /webadmin setup
msgid "How do you want to sign in?"
msgstr "Как вы хотите входить?"

# /webadmin setup
msgid "Write the configuration"
msgstr "Записать конфигурацию"

# /webadmin setup
msgid "Step 1: address and port"
msgstr "Шаг 1: адрес и порт"

# /webadmin setup
msgid "Step 2: Discord login"
msgstr "Шаг 2: вход через Discord"

# /webadmin setup
msgid "Step 2: local account"
msgstr "Шаг 2: локальная учётная запись"

# /webadmin setup
msgid "Local account"
msgstr "Локальная учётная запись"

# /webadmin setup
msgid "This node is not the master — the website runs on the master node only. Run /webadmin setup on the master node."
msgstr "Этот узел не мастер — веб-сайт работает только на мастер-узле. Запустите /webadmin setup на мастер-узле."

# /webadmin setup
msgid "Manual setup"
msgstr "Ручная настройка"

# /webadmin setup
msgid "Pick how you sign in first."
msgstr "Сначала выберите способ входа."

# /webadmin setup
msgid "The public address has to be an absolute http or https address."
msgstr "Публичный адрес должен быть абсолютным адресом http или https."

# /webadmin setup
msgid "The client secret is required."
msgstr "Секрет клиента обязателен."

# /webadmin setup
msgid "Backup"
msgstr "Резервная копия"

# /webadmin setup
msgid "Nothing changed — {} already matches."
msgstr "Ничего не изменилось — {} уже совпадает."

# /webadmin setup
msgid "{} was written."
msgstr "{} записан."

# /webadmin setup
msgid "This node is not the master — the website runs on the master node only. Run /webadmin setup on {}."
msgstr "Этот узел не мастер — веб-сайт работает только на мастер-узле. Запустите /webadmin setup на {}."

# /webadmin setup
msgid "The configuration could not be written: {}"
msgstr "Конфигурацию не удалось записать: {}"

# /webadmin setup
msgid "Store the client secret with:"
msgstr "Сохраните секрет клиента с помощью:"

# /webadmin setup
msgid "The port has to be a whole number between {} and {}."
msgstr "Порт должен быть целым числом от {} до {}."

# /webadmin setup
msgid "The previous version is kept as {}."
msgstr "Предыдущая версия сохранена как {}."

# /webadmin setup
msgid "A configuration change applies on the next node restart, not on a page reload: {}"
msgstr "Изменение конфигурации применяется при следующем перезапуске узла, а не при перезагрузке страницы: {}"

# /webadmin setup
msgid "Open the Discord Developer Portal, your application → OAuth2, and add the redirect URI {}."
msgstr "Откройте Discord Developer Portal, ваше приложение → OAuth2, и добавьте URI перенаправления {}."

# /webadmin setup
msgid "Discord login"
msgstr "Вход через Discord"

# /webadmin setup
msgid "Port"
msgstr "Порт"

# /webadmin setup
msgid "The bot's application id could not be read, so the Discord login cannot be configured here."
msgstr "Идентификатор приложения бота не удалось прочитать, поэтому вход через Discord здесь настроить нельзя."

# /webadmin
msgid "Inspects and sets up the admin website"
msgstr "Проверяет и настраивает веб-сайт администратора"

# /webadmin status
msgid "auth.public_base_url is {} — plain http carries the login page and the session cookie in cleartext. Set an https address, or an address inside your own network."
msgstr "auth.public_base_url — {}: обычный http передаёт страницу входа и сессионную cookie в открытом виде. Укажите адрес https или адрес внутри вашей собственной сети."

# /webadmin setup
msgid "The client secret is stored under auth.discord.client_secret_key — the configuration file names that key only, never the value."
msgstr "Клиентский секрет сохранён под auth.discord.client_secret_key — в файле конфигурации указан только этот ключ, никогда сам секрет."

# /webadmin setup
msgid "Step 2: Discord login and a local account"
msgstr "Шаг 2: вход через Discord и локальная учётная запись"

# /webadmin setup
msgid "Password"
msgstr "Пароль"

# /webadmin setup
msgid "A username is required."
msgstr "Требуется имя пользователя."

# /webadmin setup
msgid "The password has to be at least {} characters long."
msgstr "Пароль должен содержать не менее {} символов."

# /webadmin setup
msgid "The local account '{}' already exists — nothing was written. Change its password with the user password command instead."
msgstr "Локальная учётная запись '{}' уже существует — ничего не записано. Измените её пароль командой user password."

# /webadmin setup
msgid "The local account {} is set up; its password is the one you entered."
msgstr "Локальная учётная запись {} настроена; её пароль — тот, что вы ввели."

# /webadmin user
msgid "The username has to be at most {} characters long."
msgstr "Имя пользователя должно быть не длиннее {} символов."

# /webadmin user
msgid "The password has to be at most {} characters long."
msgstr "Пароль должен быть не длиннее {} символов."

# /webadmin user
msgid "The local account '{}' is not in the configuration any more — reload and pick again."
msgstr "Локальная учётная запись '{}' больше не находится в конфигурации — перезагрузите и выберите снова."

# /webadmin user
msgid "The role(s) {} are not defined by this installation — nothing was written. Known roles: {}."
msgstr "Роли {} не определены в этой установке — ничего не записано. Известные роли: {}."

# /webadmin user
msgid "The local account '{}' is the last one holding Admin — removing it would lock everyone out of the console. Give another account Admin first."
msgstr "Локальная учётная запись '{}' — последняя с ролью Admin; её удаление заблокирует всем доступ к консоли. Сначала назначьте Admin другой учётной записи."

# /webadmin user
msgid "Pick at least one role for the new account."
msgstr "Выберите хотя бы одну роль для новой учётной записи."

# /webadmin user
msgid "Local account removed"
msgstr "Локальная учётная запись удалена"

# /webadmin user
msgid "Account"
msgstr "Учётная запись"

# /webadmin user
msgid "The REST API plugin was reloaded, so its routes are attached to the new application object."
msgstr "Плагин REST API перезагружен, поэтому его маршруты привязаны к новому объекту приложения."

# /webadmin restart
msgid "The REST API plugin is loaded on this node, but its reload failed, so its routes are still attached to the old application object — reload it by hand."
msgstr "Плагин REST API загружен на этом узле, но его перезагрузка не удалась, поэтому его маршруты по-прежнему привязаны к старому объекту приложения — перезагрузите его вручную."

# /webadmin user
msgid "The REST API plugin is not loaded on this node, so no routes had to be re-attached."
msgstr "Плагин REST API не загружен на этом узле, поэтому маршруты не нужно было привязывать заново."

# /webadmin user
msgid "session.secret is not set — every restart mints a new random session key, so this signs everyone out. Write session.secret first, or press the button again to confirm."
msgstr "session.secret не задан — каждый перезапуск создаёт новый случайный ключ сессии, и всех выписывает из системы. Сначала задайте session.secret или нажмите кнопку ещё раз для подтверждения."

# /webadmin user
msgid "The web console could not be restarted ({}). It is down until the bot is restarted."
msgstr "Не удалось перезапустить веб-консоль ({}). Она не работает, пока бот не будет перезапущен."

# /webadmin user
msgid "The web console did not come back up — it is down until the bot is restarted. Check the bot's log for the service's error."
msgstr "Веб-консоль не поднялась — она не работает, пока бот не будет перезапущен. Проверьте журнал бота на ошибку службы."

# /webadmin user
msgid "The web console was rebuilt and is running on port {}."
msgstr "Веб-консоль пересоздана и работает на порту {}."

# /webadmin user
msgid "The web console was rebuilt and is running."
msgstr "Веб-консоль пересоздана и работает."

# /webadmin user
msgid "Web console restart"
msgstr "Перезапуск веб-консоли"

# /webadmin user
msgid "Result"
msgstr "Результат"

# /webadmin user
msgid "Address"
msgstr "Адрес"

# /webadmin user
msgid "Restart anyway"
msgstr "Всё равно перезапустить"

# /webadmin user
msgid "Cancel"
msgstr "Отмена"

# /webadmin user
msgid "Nothing was restarted."
msgstr "Ничего не было перезапущено."

# /webadmin user
msgid "Restart the web console"
msgstr "Перезапустить веб-консоль"

# /webadmin user
msgid "Roles"
msgstr "Роли"

# /webadmin user
msgid "New password"
msgstr "Новый пароль"

# /webadmin user
msgid "Add a local account"
msgstr "Добавить локальную учётную запись"

# /webadmin user
msgid "Set a new password for {}"
msgstr "Задать новый пароль для {}"

# /webadmin user
msgid "Pick a local account"
msgstr "Выберите локальную учётную запись"

# /webadmin user
msgid "Account to remove"
msgstr "Удаляемая учётная запись"

# /webadmin user
msgid "Account whose password to change"
msgstr "Учётная запись, пароль которой нужно изменить"

# /webadmin user
msgid "Delete it"
msgstr "Удалить"

# /webadmin user
msgid "Nothing was deleted."
msgstr "Ничего не было удалено."

# /webadmin user
msgid "This node is not the master — the website runs on the master node only. Run {} on {}."
msgstr "Этот узел не является мастером — сайт работает только на мастер-узле. Выполните {} на {}."

# /webadmin user
msgid "This node is not the master — the website runs on the master node only. Run {} on the master node."
msgstr "Этот узел не является мастером — сайт работает только на мастер-узле. Выполните {} на мастер-узле."

# /webadmin user
msgid "This installation defines no role names, so no account can be granted one."
msgstr "В этой установке не определены имена ролей, поэтому ни одной учётной записи нельзя назначить роль."

# /webadmin user
msgid "Adds a local account to the admin website"
msgstr "Добавляет локальную учётную запись на сайт администратора"

# /webadmin user
msgid "The website configuration carries no local accounts."
msgstr "Конфигурация сайта не содержит локальных учётных записей."

# /webadmin user
msgid "Pick the local account to remove. This cannot be undone."
msgstr "Выберите локальную учётную запись для удаления. Это действие необратимо."

# /webadmin user
msgid "Removes a local account from the admin website"
msgstr "Удаляет локальную учётную запись с сайта администратора"

# /webadmin user
msgid "Delete the local account '{}'? This cannot be undone."
msgstr "Удалить локальную учётную запись '{}'? Это действие необратимо."

# /webadmin user
msgid "Pick the local account whose password you want to change."
msgstr "Выберите локальную учётную запись, пароль которой вы хотите изменить."

# /webadmin user
msgid "Sets a new password for a local account"
msgstr "Задаёт новый пароль для локальной учётной записи"

# /webadmin user
msgid "Manages the local accounts that sign in to the admin website"
msgstr "Управляет локальными учётными записями, которые входят на сайт администратора"

# /webadmin setup
msgid "Setup cancelled — nothing was written."
msgstr "Настройка отменена — ничего не записано."
