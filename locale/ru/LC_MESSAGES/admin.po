# /dcs
msgid "Commands to manage your DCS installations"
msgstr "Команды для управления вашими инсталляциями DCS World"

# /dcs ban
msgid "Bans a user by name or ucid"
msgstr "Банит игрока по имени или ucid"

msgid "Reason"
msgstr "Причина"

msgid "Days (empty = forever)"
msgstr "Дней (пусто = навсегда)"

msgid "Ban Details"
msgstr "Подробности бана"

msgid "Member {} is not linked!"
msgstr "Игрок {} не слинкован!"

msgid "{} is not a valid UCID!"
msgstr "{} не является верным UCID!"

msgid "Player {} banned on all servers"
msgstr "Игрок {} забанен на всех серверах"

msgid " for {} days."
msgstr " (на {} дней)."

# /dcs unban
msgid "Unbans a user by name or ucid"
msgstr "Разбанивает игрока по имени или ucid"

msgid "Player {} unbanned on {}."
msgstr "Игрок {} разбанен на {}."

msgid "Player {} was not banned on {}."
msgstr "Игрок {} не был забанен на {}."

msgid "Shows active bans"
msgstr "Показывает активные баны"

msgid "User with UCID {} is not banned."
msgstr "Игрок с UCID {} не забанен."

# /dcs bans
msgid "Ban Information"
msgstr "Информация о банах"

msgid "<unknown>"
msgstr "<неизвестно>"

msgid "never"
msgstr "никогда"

msgid "Banned by: {}"
msgstr "Кем забанен: {}"

msgid "Exp.: {}"
msgstr "Ист: {}"

# /dcs update
msgid "Update your DCS installations"
msgstr "Обновить вашу инсталляцию DCS"

msgid "Time in seconds to warn users before shutdown"
msgstr "Время в секундах, за которое предупредить игроков о выключении"

msgid "Can't get version information from ED, possible auth-server outage!"
msgstr "Ошибка получения версии от ED, возможно недоступен сервер авторизации!"

msgid "Your installed version {version} is the latest on branch {branch}."
msgstr "Ваша установленная версия {version} является последней в ветке {branch}."

msgid ""
"Would you like to update from version {old_version}@{old_branch} to {new_version}@{new_branch}?\n"
"All running DCS servers will be shut down!"
msgstr ""
"Вы хотите обновиться с версии {old_version}@{old_branch} на версию {new_version}@{new_branch}?\n"
"Все запущенные DCS серверы будут выключены!"

msgid "Updating DCS World to the newest version, please wait ..."
msgstr "Обновляю сервер DCS World до самоей новой версии, пожалуйста подождите ..."

msgid "DCS updated to version {version}@{branch} on node {name}."
msgstr "DCS обновлен до версии {version}@{branch} на ноде {name}."

msgid "DCS World could not be updated on node {name} due to missing disk space!"
msgstr "DCS World не был обновлен на ноде {name}, недостаточно дискового пространства!"

msgid "DCS World updated to version {version}@{branch} on node {name}.\n"
"The updater has requested a **reboot** of the system!"
msgstr "DCS World был обновлен до {version}@{branch} на ноде {name}.\n"
"Обновление запросило **перезагрузку** системы!"

msgid "Error while updating DCS on node {name}, code={rc}"
msgstr "Ошибка во время обновления DCS на ноде {name}, код={rc}"

msgid "The update takes longer than 10 minutes, please check back regularly, if it has finished."
msgstr "Обновление идёт более 10 минут. Пожалуйста, регулярно проверяйте процесс."

msgid "Can't update branch {}. You might need to provide proper DCS credentials to do so."
msgstr "Невозможно обновить ветку {}. Вам может потребоваться ввести данные пользователя DCS вручную."

# /dcs install
msgid "Install modules in your DCS server"
msgstr "Устанавливает модули на ваш сервер DCS"

msgid "Shutdown all servers on node {} for the installation?"
msgstr "Выключить все сервера на ноде {} для установки модулей?"

msgid "Installing module {module} on node {node}, please wait ..."
msgstr "Установка модуля {module} на ноду {node}, пожалуйста подождите ..."

msgid "Module {module} installed on node {node}."
msgstr "Модуль {module} установлен на ноде {node}."

# /dcs uninstall
msgid "Uninstall modules from your DCS server"
msgstr "Удаляет модули с вашего сервера DCS"

msgid "Shutdown all servers on node {} for the uninstallation?"
msgstr "Выключить все сервера на ноде {} для удаления модулей?"

msgid "Aborted."
msgstr "Отмена."

msgid "Module {module} uninstalled on node {node}."
msgstr "Модуль {module} удалён с ноды {node}."

# /download
msgid "Download files from your server"
msgstr "Скачать файлы с вашего сервера"

msgid "File {file} not found in directory {dir}."
msgstr "Файл {file} не найден в каталоге {dir}."

msgid "File sent as a DM."
msgstr "Файл отправлен в личные сообщения."

msgid "Here is your file:"
msgstr "Вот ваш файл:"

msgid "File too large. You need a higher boost level for your server."
msgstr "Файл превышает допустимый размер. Вашему Discord серверу требуется буст."

msgid "File sent to the configured channel."
msgstr "Файл отправлен в настроенный Discord канал."

msgid "File copied to the specified location."
msgstr "Файл скопирован в указанное место."

# /prune
msgid "Prune unused data in the database"
msgstr "Очистить неиспользуемые данные в базе данных"

msgid ":warning: Database Prune :warning:"
msgstr ":warning: Очистка базы данных! :warning:"

msgid ""
"You are going to delete data from your database. Be advised.\n"
"\n"
"Please select the data to be pruned:"
msgstr ""
"Внимание! Вы хотите удалить данные из базы данных! Будьте внимательны! Пожалуйста выберите данные для удаления:"

msgid "We are going to delete all data of user {}. Are you sure?"
msgstr "Мы собираемся удалить все данные по пользователю {}. Вы уверены?"

msgid "We are going to delete all data of server {}. Are you sure?"
msgstr "Мы собираемся удалить все данные по серверу {}. Вы уверены?"

msgid "Data of user {} deleted."
msgstr "Данные пользователя {} удалены."

msgid "Data of server {} deleted."
msgstr "Данные сервера {} удалены."

msgid "No players to prune."
msgstr "Не найдено игроков для удаления."

msgid ""
"This will delete {} players incl. their stats from the database.\n"
"Are you sure?"
msgstr ""
"Эта операция удалит {} игроков и их статистику из базы данных.\n"
"Вы уверены?"

msgid ""
"This will delete all data older than {} days from the database.\n"
"Are you sure?"
msgstr ""
"Эта операция удалит все данные старше {} дней из базы данных.\n"
"Вы уверены?"

msgid "All data older than {} days pruned."
msgstr "Все данные старше {} дней были удалены."

# /node
msgid "Commands to manage your nodes"
msgstr "Команды для управления нодами"

# /node statistics
msgid "Statistics of your nodes"
msgstr "Статистика ваших нод"

# /node list
msgid "Status of all nodes"
msgstr "Статус всех нод"

msgid "DCSServerBot Cluster Overview"
msgstr "Обзор DCSServerBot Cluster"

msgid "🆕 Update available"
msgstr "🆕 Доступно обновление"

msgid "Instance"
msgstr "Инстанс"

msgid "Server"
msgstr "Сервер"

msgid "Status"
msgstr "Статус"

# /node upgrade / restart
msgid "Do you want to {} all nodes?"
msgstr "Вы хотите выполнить {} всех нод?"

msgid "Do you want to {method} node {node}?"
msgstr "Вы хотите выполнить {method} на ноде {node}?"

msgid "upgrade"
msgstr "апгрейд"

msgid "shutdown"
msgstr "выключение"

msgid "restart"
msgstr "перезапуск"

msgid "Node {node} - {method} sent."
msgstr "Нода {node} - запрос на {method} отправлен."

msgid "All nodes are"
msgstr "Все ноды были"

msgid "Master is"
msgstr "Мастер является"

msgid " going to {} **NOW**."
msgstr " будет {} **СЕЙЧАС**."

# /node shutdown
msgid "Shuts a specific node down"
msgstr "Выключение конкретной ноды"

# /node restart
msgid "Restarts a specific node"
msgstr "Перезапуск конкретной ноды"

# /node offline
msgid "Shuts down all servers, enables maintenance"
msgstr "Выключает все сервера, включает режим обслуживания"

msgid "Shuts all servers down (default: on)"
msgstr "Отключает все сервера (по умолчанию: вкл.)"

msgid "Node {} is now offline."
msgstr "Нода {} переведена в режим оффлайн."

# /node online
msgid "Clears the maintenance mode for all servers"
msgstr "Отключение режима обслуживания на всех серверах"

msgid "Start all your servers (default: off)"
msgstr "Запускает все сервера (по умолчанию: выкл.)"

msgid "Node {} is now online."
msgstr "Нода {} теперь онлайн."

# /node upgrade
msgid "Upgrade DCSServerBot"
msgstr "Обновление DCSServerBot"

msgid "There is no upgrade available for "
msgstr "Обновлений не найдено для "

msgid "your cluster"
msgstr "вашего кластера"

msgid "node {}"
msgstr "ноды {}"

msgid "You are trying to upgrade an agent node in a cluster. Are you really sure?"
msgstr "Вы пытаетесь обновить ноду-агент в кластере. Вы точно уверены?"

# /node shell
msgid "Run a shell command on a node"
msgstr "Выполнить команду shell на ноде"

msgid "```Command executed.```"
msgstr "```Команда выполнена.```"

# /reload
msgid "Reloads a plugin"
msgstr "Перезагрузка плагина"

msgid "Plugin {} reloaded."
msgstr "Плагин {} перезагружен."

msgid "Plugin {} could not be reloaded, check the log for details."
msgstr "Плагин {} не мог быть перезагружен, проверьте лог файл."

msgid "All plugins reloaded."
msgstr "Все плагины перезагружены."

msgid "One or more plugins could not be reloaded, check the log for details."
msgstr "Один или несколько плагинов не были перезагружены, проверьте лог файл."

# /node add_instance
msgid "Add/create an instance\n"
msgstr "Добавить/создать инстанс\n"

msgid "Either select an existing instance or enter the name of a new one"
msgstr "Выберите существующий инстанс или введите имя нового"

msgid "Take this instance configuration as a reference"
msgstr "Взять конфигурацию данного инстанса за основу"

msgid "Instance \"{}\" created.\n"
"Do you want to configure a server for this instance?"
msgstr "Инстанс \"{}\" создан.\n"
"Произвести настройку сервера для этого инстанса?"

msgid "Server {server} assigned to instance {instance}."
msgstr "Сервер {server} назначен инстансу {instance}."

msgid "Instance {} created blank with no server assigned."
msgstr "Инстанс {} создан пустым без привязки к серверу."

msgid ""
"Instance {instance} added to node {node}.Please make sure you forward the following ports:```- DCS Port:    "
"{dcs_port} (TCP/UDP)- WebGUI Port: {webgui_port} (TCP)```"
msgstr ""
"Инстанс {instance} добавлен к ноде {node}.Убедитесь, что выполнен проброс следующих портов:```- DCS Порт:    "
"{dcs_port} (TCP/UDP)- WebGUI Порт: {webgui_port} (TCP)```"

msgid "Instance {instance} could not be added to node {node}, see log."
msgstr ""
"Инстанс {instance} не был добавлен к ноде {node}.\n"
"Проверьте лог файл."

# /node delete_instance
msgid "Delete an instance\n"
msgstr "Удаление инстанса\n"

msgid "The instance is in use by server \"{}\".\n"
"Do you really want to delete it?"
msgstr "Этот инстанс используется на сервере \"{}\".\n"
"Вы действительно хотите удалить его?"

msgid "Do you really want to delete instance {}?"
msgstr "Вы действительно хотите удалить инстанс {}?"

msgid "Do you want to remove the directory\n{}?"
msgstr "Вы хотите удалить директорию\n{}?"

msgid "Instance {instance} removed from node {node}."
msgstr "Инстанс {instance} удален с ноды {node}."

msgid "Instance {} could not be deleted, because the directory is in use."
msgstr "Инстанс {} не может быть удален, так как директория уже используется."

# /node rename_instance
msgid "Rename an instance\n"
msgstr "Переименовать инстанс\n"

msgid "Server {} has to be shut down before renaming the instance!"
msgstr "Сервер {} необходимо выключить перед переименованием инстанса!"

msgid "Do you really want to rename instance {}?"
msgstr "Вы действительно хотите переименовать инстанс {}?"

msgid "Instance {old_name} renamed to {new_name}."
msgstr "Инстанс {old_name} переименован в {new_name}."

msgid "Instance {} could not be renamed, because the directory is in use."
msgstr "Инстанс {} не может быть переименован, так как директория уже используется."

# Config upload
msgid "To which server do you want to upload this configuration to?"
msgstr "На какой сервер вы хотите загрузить эту конфигурацию?"

msgid "Error while uploading file to node {}!"
msgstr "Ошибка при загрузке файла на ноду {}!"

msgid "Error while reading file from discord."
msgstr "Ошибка чтения файла из Discord."

msgid "Plugin {} re-loaded."
msgstr "Плагин {} перезагружен."

msgid "To apply the new config by restarting a node or the whole cluster, use {}"
msgstr "Для применения новой конфигурации перезапуском ноды или всего кластера, используйте команду {}"
