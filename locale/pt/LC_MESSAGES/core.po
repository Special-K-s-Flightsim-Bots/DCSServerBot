msgid "Server is going down for a DCS update in {)}!"
msgstr "O servidor será desligado para uma atualização do DCS em {)}!"

msgid "Server is going down to install a module in {}!"
msgstr "O servidor será desligado para instalar um módulo em {}!"

msgid "Server is going down to uninstall a module in {}!"
msgstr "O servidor será desligado para desinstalar um módulo em {}!"

msgid "You are banned from this server. Reason: {}"
msgstr "Você está banido deste servidor. Motivo: {}"

msgid "The server is full, please try again later."
msgstr "O servidor está cheio, por favor tente novamente mais tarde."

msgid "Your player name contains invalid characters. Please change your name to join our server."
msgstr "Seu nome de jogador contém caracteres inválidos. Por favor, altere seu nome para entrar no nosso servidor."

msgid "Please change your default player name at the top right of the multiplayer selection list to an individual one!"
msgstr "Por favor, altere seu nome de jogador padrão no canto superior direito da lista de seleção multijogador para um nome individual!"
