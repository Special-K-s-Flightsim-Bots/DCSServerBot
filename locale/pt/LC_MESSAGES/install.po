msgstr "[yellow]Usuário {} existente encontrado![/]"

msgid "Do you remember the password of {}?"
msgstr "Você se lembra da senha de {}?"

msgid "Please enter your password for user {}"
msgstr "Por favor, insira sua senha para o usuário {}"

msgid "[red]Wrong password! Try again ({}/3).[/]"
msgstr "[red]Senha incorreta! Tente novamente ({}/3).[/]"

msgid "[yellow]You have entered 3x a wrong password. I have reset it.[/]'"
msgstr "[yellow]Você inseriu 3x uma senha incorreta. Eu a redefini.[/]'"

msgid "[green]- Database user and database created.[/]"
msgstr "[green]- Usuário do banco de dados e banco de dados criados.[/]"

