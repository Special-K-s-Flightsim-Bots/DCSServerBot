msgstr "Nenhum servidor DCS configurado encontrado."

msgid "\n[i]DCS server \"{}\" found.[/i]\n"
msgstr "\n[i]Servidor DCS \"{}\" encontrado.[/i]\n"

msgid "\n[i]DCS server \"{}\" found.[/i]\nWould you like to manage this server through DCSServerBot?"
msgstr "\n[i]Servidor DCS \"{}\" encontrado.[/i]\nVocê gostaria de gerenciar este servidor através do DCSServerBot?"

msgid "Adding instance {instance} with server {name} ..."
msgstr "Adicionando instância {instance} com o servidor {name} ..."

