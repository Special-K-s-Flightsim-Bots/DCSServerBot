msgstr "Insira o nome do host do seu banco de dados PostgreSQL"

msgid "Enter the port to your PostgreSQL-database"
msgstr "Insira a porta do seu banco de dados PostgreSQL"

msgid "Please enter the name of your PostgreSQL master database"
msgstr "Por favor, insira o nome do seu banco de dados master do PostgreSQL"

msgid "Please enter your PostgreSQL master user name"
msgstr "Por favor, insira o nome do usuário master do seu PostgreSQL"

