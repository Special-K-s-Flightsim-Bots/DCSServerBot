msgstr "\n{}. [u]Configuração do nó[/]"

msgid "Aborted: No DCS installation found."
msgstr "Abortado: nenhuma instalação do DCS encontrada."

msgid "Is {} a static IP-address for this node?"
msgstr "{} é um endereço IP estático para este nó?"

