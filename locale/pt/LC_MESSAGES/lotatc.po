msgid "To which server do you want to upload this transponder file to?"
msgstr "Para qual servidor você deseja enviar este arquivo de transponder?"

msgid "LotAtc is not configured on any server."
msgstr "O LotAtc não está configurado em nenhum servidor."

msgid "Transponder file {} uploaded."
msgstr "Arquivo de transponder {} enviado."

msgid "Transponder file {} could not be uploaded!"
msgstr "O arquivo de transponder {} não pôde ser enviado!"

msgid "GCI {} on station."
msgstr "GCI {} em estação."

msgid "{num} {coalition} GCI{s} on station."
msgstr "{num} GCI{s} {coalition} em estação."

msgid "{coalition} GCI \"{name}\" on station."
msgstr "GCI {coalition} \"{name}\" em estação."

msgid "{coalition} GCI \"{name}\" offline."
msgstr "GCI {coalition} \"{name}\" offline."

msgid "Shows active GCIs"
msgstr "Mostra os GCIs ativos"

msgid "You need to join a side to show their GCIs"
msgstr "Você precisa entrar em um lado para mostrar os GCIs dele"

msgid "The following GCIs are active on the {coalition} side:\n{gcis}"
msgstr "Os seguintes GCIs estão ativos no lado {coalition}:\n{gcis}"

msgid "No GCIs are active on the {} side."
msgstr "Nenhum GCI está ativo no lado {}."

msgid "Information about {coalition} GCI \"{name}\\"
msgstr "Informações sobre {coalition} GCI \"{name}\\"

msgid "Info about a GCI"
msgstr "Informações sobre um GCI"

msgid "Usage: {prefix}{command} <name>"
msgstr "Uso: {prefix}{command} <name>"

msgid "Commands to manage GCIs"
msgstr "Comandos para gerenciar os GCIs"

msgid "You are not allowed to see the {} GCIs."
msgstr "Você não tem permissão para ver os GCIs de {}."

msgid "There are no {coalition} GCIs active in server {server}"
msgstr "Não há GCIs {coalition} ativos no servidor {server}"

msgid "GCI {} not found."
msgstr "GCI {} não encontrado."

msgid "List of GCIs"
msgstr "Lista de GCIs"

msgid "List of active {} GCIs"
msgstr "Lista de GCIs {} ativos"

msgid "Server: {}"
msgstr "Servidor: {}"

msgid "You are not allowed to play when being a GCI."
msgstr "Você não tem permissão para jogar quando é um GCI."

msgid "GCI {} tried to join as player {}!"
msgstr "GCI {} tentou entrar como jogador {}!"

msgid "active"
msgstr "ativo"

msgid "inactive"
msgstr "inativo"
