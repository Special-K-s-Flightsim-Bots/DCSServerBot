msgid "Failed to update DCS-SRS. See log for defails."
msgstr "Falha ao atualizar o DCS-SRS. Consulte o log para detalhes."

msgid "No update for DCS-SRS available."
msgstr "Nenhuma atualização do DCS-SRS disponível."

msgid "Repair DCS-SRS"
msgstr "Reparar DCS-SRS"

