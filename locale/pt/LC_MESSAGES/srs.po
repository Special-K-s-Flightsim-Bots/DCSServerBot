msgid "{} Players on SRS"
msgstr "{} jogadores no SRS"

msgid "Name"
msgstr "Nome"

msgid "Radios"
msgstr "Rádios"

msgid "Only the first 2 radios are displayed per user."
msgstr "Apenas os 2 primeiros rádios são exibidos por usuário."

msgid "No {} players on SRS."
msgstr "Nenhum jogador {} no SRS."

msgid "Send a TTS message"
msgstr "Enviar uma mensagem TTS"

msgid "The server to send the TTS message to"
msgstr "O servidor para o qual enviar a mensagem TTS"

msgid "The message to send"
msgstr "A mensagem a enviar"

