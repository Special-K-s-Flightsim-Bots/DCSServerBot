msgid "DCSBattleground commands"
msgstr "Comandos do DCSBattleground"

msgid "Push MGRS coordinates with screenshots to DCS Battleground"
msgstr "Envia coordenadas MGRS com capturas de tela para o DCS Battleground"

msgid "The second parameter needs to be a MGRS coordinate (ex: 38TLN0274366889)."
msgstr "O segundo parâmetro precisa ser uma coordenada MGRS (ex: 38TLN0274366889)."

msgid "Recon data added - {side} side - {server}"
msgstr "Dados de reconhecimento adicionados - lado {side} - {server}"

msgid "Coalitions have to be enabled and you need to use this command in one of your coalition channels!"
msgstr "As coalizões precisam estar ativadas e você precisa usar este comando em um dos seus canais de coalizão!"

msgid "Delete recon data on a specified server"
msgstr "Excluir dados de reconhecimento em um servidor especificado"

msgid "Recon data deleted for server {}."
msgstr "Dados de reconhecimento excluídos para o servidor {}."
