msgid "The FPS of server {server.name} are below {min_fps} for longer than {period} minutes!"
msgstr "O FPS do servidor {server.name} está abaixo de {min_fps} por mais de {period} minutos!"

msgid "Displays the load of your DCS servers"
msgstr "Exibe a carga dos seus servidores DCS"

msgid "Shows servers statistics"
msgstr "Mostra as estatísticas dos servidores"

msgid "Server {server} FPS ({fps}) has been below {min_fps} for more than {period} minutes."
msgstr "O FPS do servidor {server} ({fps}) está abaixo de {min_fps} por mais de {period} minutos."

msgid "Server Performance Low!"
msgstr "Desempenho do servidor baixo!"

msgid "Server {server} RAM usage is {ram} GB, exceeding the maximum of {max_ram} GB for more than {period} minutes."
msgstr "O uso de RAM do servidor {server} é de {ram} GB, excedendo o máximo de {max_ram} GB por mais de {period} minutos."

msgid "Excessive RAM consumption!"
msgstr "Consumo excessivo de RAM!"
