msgstr "reiniciar"

msgid "shutdown"
msgstr "encerrar"

msgid "now"
msgstr "agora"

msgid "if all players have left."
msgstr "se todos os jogadores tiverem saído."

msgid "after {}"
msgstr "após {}"

msgid "immediately"
msgstr "imediatamente"

msgid ", if the mission is unpaused again."
msgstr ", se a missão for despausada novamente."

msgid "Clear the temp directory"
msgstr "Limpa o diretório temporário"

msgid "This is necessary to clear the temp directory."
msgstr "Isso é necessário para limpar o diretório temporário."

msgid "Server \"{}\" cleaned up."
msgstr "Servidor \"{}\" limpo."

msgid "Locks a DCS server"
msgstr "Bloqueia um servidor DCS"

msgid "Server \"{}\" locked."
msgstr "Servidor \"{}\" bloqueado."

msgid "Timeout while locking server \"{}\"!"
msgstr "Tempo esgotado ao bloquear o servidor \"{}\"!"

msgid "Unlocks a DCS server"
msgstr "Desbloqueia um servidor DCS"

msgid "Server \"{}\" unlocked."
msgstr "Servidor \"{}\" desbloqueado."

msgid "Timeout while unlocking server \"{}\"!"
msgstr "Tempo esgotado ao desbloquear o servidor \"{}\"!"

msgid "Commands to manage the Scheduler"
msgstr "Comandos para gerenciar o Agendador"

msgid "Sets the server's maintenance flag"
msgstr "Define o sinalizador de manutenção do servidor"

msgid "Server is configured for a pending restart.\n"
msgstr "O servidor está configurado para um reinício pendente.\n"

msgid "Server is configured for a pending restart.\nSetting the maintenance flag will abort this restart.\n"
msgstr "O servidor está configurado para um reinício pendente.\nDefinir o sinalizador de manutenção abortará este reinício.\n"

msgid "Server is configured for a pending restart.\nSetting the maintenance flag will abort this restart.\nAre you sure?"
msgstr "O servidor está configurado para um reinício pendente.\nDefinir o sinalizador de manutenção abortará este reinício.\nTem certeza?"

msgid "Maintenance mode set for server \"{}\"."
msgstr "Modo de manutenção definido para o servidor \"{}\"."

msgid "Server \"{}\" is already in maintenance mode."
msgstr "O servidor \"{}\" já está em modo de manutenção."

