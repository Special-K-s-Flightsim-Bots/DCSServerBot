msgstr "ativar modo de manutenção"

msgid "Maintenance mode enabled."
msgstr "Modo de manutenção ativado."

msgid "Maintenance mode is already active."
msgstr "O modo de manutenção já está ativo."

msgid "disable maintenance mode"
msgstr "desativar modo de manutenção"

msgid "Maintenance mode disabled."
msgstr "Modo de manutenção desativado."

msgid "Maintenance mode wasn't enabled."
msgstr "O modo de manutenção não estava ativado."

msgid "Time to the next restart"
msgstr "Tempo até o próximo reinício"

msgid "Maintenance mode active, mission will not restart."
msgstr "Modo de manutenção ativo, a missão não será reiniciada."

