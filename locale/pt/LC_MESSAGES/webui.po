msgstr "{instance}: não foi possível criar a pasta da instância ({ex})"

msgid "Language"
msgstr "Idioma"

msgid "General"
msgstr "Geral"

msgid "Database"
msgstr "Banco de dados"

msgid "This node"
msgstr "Este nó"

msgid "Discord — the bot"
msgstr "Discord — o bot"

