msgid "Update your DCS installations"
msgstr "Aktualizuje instalacje DCS"

msgid "Time in seconds to warn users before shutdown"
msgstr "Czas w sekundach na ostrzeżenie użytkowników przed wyłączeniem"

msgid "Can't get version information from ED, possible auth-server outage!"
msgstr "Nie można pobrać informacji o wersji z ED, możliwa awaria serwera autoryzacji!"

msgid "Your installed version {version} is the latest on branch {branch}."
msgstr "Zainstalowana wersja {version} jest najnowsza w gałęzi {branch}."

msgid "Would you like to update from version {old_version}@{old_branch} to {new_version}@{new_branch}?\n"
msgstr "Czy zaktualizować z wersji {old_version}@{old_branch} do {new_version}@{new_branch}?\n"

msgid "Would you like to update from version {old_version}@{old_branch} to {new_version}@{new_branch}?\nAll running DCS servers will be shut down!"
msgstr "Czy zaktualizować z wersji {old_version}@{old_branch} do {new_version}@{new_branch}?\nWszystkie działające serwery DCS zostaną wyłączone!"

msgid "Updating DCS World to the newest version, please wait ..."
msgstr "Aktualizowanie DCS World do najnowszej wersji, proszę czekać ..."

msgid "DCS updated to version {version}@{branch} on node {name}."
msgstr "DCS zaktualizowany do wersji {version}@{branch} na węźle {name}."

msgid "DCS World could not be updated on node {name} due to missing disk space!"
msgstr "Nie można zaktualizować DCS World na węźle {name} z powodu braku miejsca na dysku!"

msgid "DCS World updated to version {version}@{branch} on node {name}.\n"
msgstr "DCS World zaktualizowany do wersji {version}@{branch} na węźle {name}.\n"

msgid "DCS World updated to version {version}@{branch} on node {name}.\nThe updater has requested a **reboot** of the system!"
msgstr "DCS World zaktualizowany do wersji {version}@{branch} na węźle {name}.\nAktualizator zażądał **ponownego uruchomienia** systemu!"

msgid "Error while updating DCS on node {name}, code={rc}"
msgstr "Błąd podczas aktualizacji DCS na węźle {name}, kod={rc}"

msgid "The update takes longer than 10 minutes, please check back regularly, if it has finished."
msgstr "Aktualizacja trwa dłużej niż 10 minut, sprawdzaj regularnie, czy została zakończona."

msgid "Can't update branch {}. You might need to provide proper DCS credentials to do so."
msgstr "Nie można zaktualizować gałęzi {}. Może być konieczne podanie prawidłowych danych logowania DCS."

msgid "Install modules in your DCS server"
msgstr "Instaluje moduły na serwerze DCS"

msgid "Shutdown all servers on node {} for the installation?"
msgstr "Wyłączyć wszystkie serwery na węźle {} na czas instalacji?"

msgid "Installing module {module} on node {node}, please wait ..."
msgstr "Instalowanie modułu {module} na węźle {node}, proszę czekać ..."

msgid "Module {module} installed on node {node}."
msgstr "Moduł {module} zainstalowany na węźle {node}."

msgid "Module {module} installation on node {node} failed with code {rc}."
msgstr "Instalacja modułu {module} na węźle {node} nie powiodła się, kod {rc}."

msgid "Uninstall modules from your DCS server"
msgstr "Odinstalowuje moduły z serwera DCS"

msgid "Shutdown all servers on node {} for the uninstallation?"
msgstr "Wyłączyć wszystkie serwery na węźle {} na czas odinstalowania?"

