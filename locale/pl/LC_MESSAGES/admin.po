msgstr "Wybierz sposób logowania z listy poniżej."

msgid "Fill in the form the wizard opened."
msgstr "Wypełnij formularz otwarty przez kreator."

msgid "The configuration keeps auth.discord.client_secret_key: discord_client_secret."
msgstr "Konfiguracja zachowuje auth.discord.client_secret_key: discord_client_secret."

