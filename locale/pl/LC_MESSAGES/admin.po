msgstr "Poprzednia wersja jest zachowana jako {}."

msgid "A configuration change applies on the next node restart, not on a page reload: {}"
msgstr "Zmiana konfiguracji zaczyna obowiązywać po następnym restarcie węzła, a nie po odświeżeniu strony: {}"

msgid "Open the Discord Developer Portal, your application → OAuth2, and add the redirect URI {}."
msgstr "Otwórz Discord Developer Portal, swoją aplikację → OAuth2, i dodaj adres URI przekierowania {}."

msgid "Discord login"
msgstr "Logowanie przez Discord"

msgid "The bot's application id could not be read, so the Discord login cannot be configured here."
msgstr "Nie można odczytać identyfikatora aplikacji bota, więc nie można tu skonfigurować logowania przez Discord."

msgid "Inspects and sets up the admin website"
msgstr "Sprawdza i konfiguruje stronę administracyjną"

msgid "auth.public_base_url is {} — plain http carries the login page and the session cookie in cleartext. Set an https address, or an address inside your own network."
msgstr "auth.public_base_url ma wartość {} — zwykły http przesyła stronę logowania i ciasteczko sesji jawnym tekstem. Ustaw adres https lub adres w sieci wewnętrznej."

msgid "The client secret is stored under auth.discord.client_secret_key — the configuration file names that key only, never the value."
msgstr "Sekret klienta jest przechowywany pod auth.discord.client_secret_key — plik konfiguracyjny zawiera tylko nazwę tego klucza, nigdy wartość."

msgid "Step 2: Discord login and a local account"
msgstr "Krok 2: logowanie przez Discord i konto lokalne"

msgid "Password"
msgstr "Hasło"

