msgstr "Przerwano."

msgid "Module {module} uninstalled on node {node}."
msgstr "Moduł {module} odinstalowany na węźle {node}."

msgid "Download files from your server"
msgstr "Pobiera pliki z serwera"

msgid "File {file} not found in directory {dir}."
msgstr "Plik {file} nie został znaleziony w katalogu {dir}."

msgid "File sent as a DM."
msgstr "Plik wysłany w wiadomości prywatnej."

msgid "Here is your file:"
msgstr "Oto twój plik:"

msgid "File too large. You need a higher boost level for your server."
msgstr "Plik jest zbyt duży. Wymagany wyższy poziom boosta dla serwera."

msgid "File sent to the configured channel."
msgstr "Plik wysłany na skonfigurowany kanał."

msgid "File copied to the specified location."
msgstr "Plik skopiowany do wskazanej lokalizacji."

msgid "Prune unused data in the database"
msgstr "Usuwa nieużywane dane z bazy danych"

msgid ":warning: Database Prune :warning:"
msgstr ":warning: Czyszczenie bazy danych :warning:"

msgid "You are going to delete data from your database. Be advised.\n\n"
msgstr "Dane z bazy danych zostaną usunięte. Należy zachować ostrożność.\n\n"

