msgid "Backup your data"
msgstr "Tworzenie kopii zapasowej danych"

msgid "Backup of {} started ..."
msgstr "Rozpoczęto tworzenie kopii zapasowej {} ..."

msgid "Backup of {} completed."
msgstr "Kopia zapasowa {} została utworzona."

msgid "Backup of {} failed. Please check log for details."
msgstr "Tworzenie kopii zapasowej {} nie powiodło się. Szczegóły w dzienniku."

msgid "Restore your data from an existing backup"
msgstr "Przywracanie danych z istniejącej kopii zapasowej"

msgid "I am about to restore your {what} from {date}.\n"
msgstr "Trwa przywracanie {what} z {date}.\n"

msgid "Aborted."
msgstr "Przerwano."

msgid "Restore of {} triggered. The node will now restart."
msgstr "Przywracanie {} zostało uruchomione. Węzeł zostanie teraz zrestartowany."

msgid "Recovery of {} failed. Please check log for details."
msgstr "Odzyskiwanie {} nie powiodło się. Szczegóły w dzienniku."

msgid "Recover your data from an existing backup"
msgstr "Odzyskiwanie danych z istniejącej kopii zapasowej"

msgid "I am going to recover your {what} from {date}.\n"
msgstr "Trwa odzyskiwanie {what} z {date}.\n"

msgid "Recovery of {} completed."
msgstr "Odzyskiwanie {} zakończone."

msgid "I am about to restore your {what} from {date}.\nThis action will completely overwrite any existing data.\nAre you absolutely certain that you want to proceed?"
msgstr "Trwa przywracanie {what} z {date}.\nTa operacja całkowicie nadpisze wszystkie istniejące dane.\nCzy na pewno kontynuować?"

msgid "Restore your data from existing backups"
msgstr "Przywracanie danych z istniejących kopii zapasowych"
