msgid "{file} downloaded. Use {command} to install it."
msgstr "Pobrano {file}. Użyj {command}, aby go zainstalować."

msgid "Downloading {} ..."
msgstr "Pobieranie {} ..."

msgid "List was truncated."
msgstr "Lista została skrócona."

msgid "Server {} needs to be shut down to change mods."
msgstr "Serwer {} musi zostać wyłączony, aby zmienić mody."

msgid "Destination"
msgstr "Miejsce docelowe"

msgid "Multiple returns, use /{group} {name} instead."
msgstr "Wiele wyników, zamiast tego użyj /{group} {name}."

msgid "Downloading {}, please wait ..."
msgstr "Pobieranie {}, proszę czekać ..."

msgid "Can't connect to {url}: {message}"
msgstr "Nie można połączyć się z {url}: {message}"
