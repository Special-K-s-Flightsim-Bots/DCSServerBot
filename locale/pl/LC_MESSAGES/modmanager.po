msgid "Select a mod to uninstall"
msgstr "Wybierz mod do odinstalowania"

msgid "Download"
msgstr "Pobierz"

msgid "Shutdown"
msgstr "Wyłącz"

msgid "⚠️ Server {} needs to be shut down to change mods."
msgstr "⚠️ Serwer {} musi zostać wyłączony, aby zmienić mody."

