msgstr "**Następujące mody są obecnie zainstalowane:**"

msgid "Version"
msgstr "Wersja"

msgid "Update"
msgstr "Aktualizacja"

msgid "There are no mods installed."
msgstr "Nie zainstalowano żadnych modów."

msgid "Select a mod to install / update"
