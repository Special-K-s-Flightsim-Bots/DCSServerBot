msgid "Error: {}"
msgstr "Błąd: {}"

msgid "Mod Manager"
msgstr "Menedżer modów"

msgid "Install or uninstall mods to {}"
msgstr "Instaluj lub odinstalowuj mody na {}"

msgid "Install mods"
msgstr "Zainstaluj mody"

msgid "Server {} needs to be shut down to install mods."
