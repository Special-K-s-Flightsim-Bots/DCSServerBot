msgid "Commands to manage custom mods in your DCS server"
msgstr "Komendy do zarządzania własnymi modami na serwerze DCS"

msgid "manage mods"
msgstr "zarządzanie modami"

msgid "Shutting down {}, please wait ..."
msgstr "Wyłączanie {}, proszę czekać ..."

