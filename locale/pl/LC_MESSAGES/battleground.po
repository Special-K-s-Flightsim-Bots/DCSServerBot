msgid "DCSBattleground commands"
msgstr "Komendy DCSBattleground"

msgid "Push MGRS coordinates with screenshots to DCS Battleground"
msgstr "Wysyłanie współrzędnych MGRS ze zrzutami ekranu do DCS Battleground"

msgid "The second parameter needs to be a MGRS coordinate (ex: 38TLN0274366889)."
msgstr "Drugi parametr musi być współrzędną MGRS (np. 38TLN0274366889)."

msgid "Recon data added - {side} side - {server}"
msgstr "Dodano dane rozpoznania - strona {side} - {server}"

msgid "Coalitions have to be enabled and you need to use this command in one of your coalition channels!"
msgstr "Koalicje muszą być włączone, a komendy należy używać na jednym z kanałów koalicji!"

msgid "Delete recon data on a specified server"
msgstr "Usuwanie danych rozpoznania na określonym serwerze"

msgid "Recon data deleted for server {}."
msgstr "Dane rozpoznania zostały usunięte dla serwera {}."
