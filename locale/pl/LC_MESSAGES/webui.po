msgid "%(count)s player known"
msgid_plural "%(count)s players known"
msgstr[0] "%(count)s znany gracz"
msgstr[1] "%(count)s znanych graczy"
msgstr[2] "%(count)s znanych graczy"

msgid "%(count)s DGSA ban hidden"
msgid_plural "%(count)s DGSA bans hidden"
msgstr[0] "%(count)s ukryty ban DGSA"
msgstr[1] "%(count)s ukryte bany DGSA"
msgstr[2] "%(count)s ukrytych banów DGSA"

msgid "per node"
msgstr "na węzeł"

msgid "per instance"
msgstr "na instancję"

msgid "node + instance"
msgstr "węzeł + instancja"

msgid "always on"
msgstr "zawsze włączone"

msgid "master node"
msgstr "węzeł główny"

msgid "agent node"
msgstr "węzeł agenta"

msgid "both nodes"
msgstr "oba węzły"

msgid "Service"
msgstr "Usługa"

msgid "Extension"
msgstr "Rozszerzenie"

msgid "held off by the %(plugin)s plugin: add it to opt_plugins"
msgstr "wstrzymane przez plugin %(plugin)s: dodaj go do opt_plugins"

msgid "Apply now"
msgstr "Zastosuj teraz"

msgid "Apply the change"
msgstr "Zastosuj zmianę"

msgid "Apply the change now"
msgstr "Zastosuj zmianę teraz"

msgid "Not now"
msgstr "Nie teraz"

msgid "Reload this page"
msgstr "Przeładuj tę stronę"

msgid "Reload the %(plugin)s plugin now?"
msgstr "Przeładować plugin %(plugin)s teraz?"

msgid "The plugin is unloaded and loaded again, and it reads its configuration file as it starts. Nothing restarts and no DCS server goes down."
msgstr "Plugin jest wyładowywany i ładowany ponownie, a przy starcie odczytuje plik konfiguracyjny. Nic nie jest restartowane i żaden serwer DCS nie zostaje wyłączony."

msgid "Reload the %(plugin)s plugin"
msgstr "Przeładuj plugin %(plugin)s"

msgid "Restart the bot on node %(node)s now?"
msgstr "Zrestartować bota na węźle %(node)s teraz?"

msgid "Every DCS server on %(node)s goes down with it. Nothing starts them again by itself: the launcher on that machine brings the bot back, and the servers with it."
msgstr "Każdy serwer DCS na %(node)s zostaje wyłączony razem z nim. Nic nie uruchamia ich ponownie samoczynnie: launcher na tej maszynie przywraca bota, a wraz z nim serwery."

msgid "The bot process ends and the launcher starts it again, so this change is read at boot."
msgstr "Proces bota kończy się, a launcher uruchamia go ponownie, więc ta zmiana jest odczytywana przy starcie."

msgid "Restart the bot on node %(node)s"
msgstr "Zrestartuj bota na węźle %(node)s"

msgid "the master node"
msgstr "węzeł główny"

msgid "The change is in the file and takes effect after the %(plugin)s plugin is reloaded."
msgstr "Zmiana jest w pliku i zadziała po przeładowaniu pluginu %(plugin)s."

msgid "The change is in the file and takes effect after a bot restart on %(node)s."
msgstr "Zmiana jest w pliku i zadziała po restarcie bota na %(node)s."

msgid "The change is in the file and takes effect when the next mission is prepared — nothing is reloaded for it."
msgstr "Zmiana jest w pliku i zadziała przy przygotowaniu następnej misji — nic nie jest w tym celu przeładowywane."

msgid "Reloading the %(plugin)s plugin — this page reloads once now."
msgstr "Przeładowywanie pluginu %(plugin)s — ta strona przeładuje się teraz raz."

msgid "Restarting the bot on %(node)s — its DCS servers go down with it. This page reloads once now; if the console does not answer yet, reload it again in a moment."
msgstr "Restartowanie bota na %(node)s — jego serwery DCS zostają wyłączone razem z nim. Ta strona przeładuje się teraz raz; jeśli konsola jeszcze nie odpowiada, przeładuj ją ponownie za chwilę."

msgid "Nothing was applied: this confirmation is no longer valid. Save the change again and apply the fresh one."
msgstr "Nic nie zostało zastosowane: to potwierdzenie nie jest już ważne. Zapisz zmianę ponownie i zastosuj nowe."

msgid "Nothing was reloaded or restarted: the bot process cannot be reached from here."
msgstr "Nic nie zostało przeładowane ani zrestartowane: nie można stąd dotrzeć do procesu bota."

msgid "Nothing was reloaded: the bot cannot be reached from here — %(reason)s."
msgstr "Nic nie zostało przeładowane: nie można stąd dotrzeć do bota — %(reason)s."

msgid "The %(plugin)s plugin was reloaded, so the change is live."
msgstr "Plugin %(plugin)s został przeładowany, więc zmiana działa."

msgid "The %(plugin)s plugin could NOT be reloaded — the file holds the change, the running bot does not. Restart the bot to apply it."
msgstr "Pluginu %(plugin)s NIE udało się przeładować — plik zawiera zmianę, działający bot nie. Zrestartuj bota, aby ją zastosować."

msgid "Re-read the site settings now?"
msgstr "Odczytaj teraz ponownie ustawienia witryny?"

msgid "The public site's settings file is read again for the pages this console serves. Nothing is reloaded or restarted and no DCS server goes down."
msgstr "Plik ustawień publicznej witryny jest odczytywany ponownie dla stron obsługiwanych przez tę konsolę. Nic nie jest przeładowywane ani restartowane, żaden serwer DCS nie zostaje zatrzymany."

msgid "Re-read the site settings"
msgstr "Odczytaj ponownie ustawienia witryny"

msgid "the site settings"
msgstr "ustawienia witryny"

msgid "Re-reading the site settings. The public site follows on its next page load; nothing is reloaded or restarted."
msgstr "Ponowne odczytywanie ustawień witryny. Publiczna witryna zmieni się przy następnym wczytaniu strony; nic nie jest przeładowywane ani restartowane."

msgid "Nothing was applied: the site settings are already being re-read."
msgstr "Nic nie zostało zastosowane: ustawienia witryny są już odczytywane ponownie."

#: services/webservice/config_apply.py
msgid "The file holds the change, but the console could not re-read it — %(reason)s. The sites that were installed keep serving; nothing was reloaded or restarted."
msgstr "Plik zawiera zmianę, ale konsola nie mogła go ponownie odczytać — %(reason)s. Zainstalowane wcześniej witryny są nadal serwowane; nic nie zostało przeładowane ani zrestartowane."


msgid "Nothing was restarted: this console cannot restart a node — the node operation it needs is not available in this process."
msgstr "Nic nie zostało zrestartowane: ta konsola nie może restartować węzła — potrzebna operacja węzła nie jest dostępna w tym procesie."

msgid "Nothing was reloaded: the %(plugin)s plugin is not loaded in this process. Restart the bot to apply the change."
msgstr "Nic nie zostało przeładowane: plugin %(plugin)s nie jest załadowany w tym procesie. Zrestartuj bota, aby zastosować zmianę."

msgid "Nothing was restarted: this installation knows no node named %(node)s."
msgstr "Nic nie zostało zrestartowane: ta instalacja nie zna węzła o nazwie %(node)s."

msgid "Nothing was restarted: a restart of %(node)s is already in flight."
msgstr "Nic nie zostało zrestartowane: restart %(node)s jest już w toku."

msgid "Nothing was applied: this file is read when a mission is prepared, so it applies at the next launch."
msgstr "Nic nie zostało zastosowane: ten plik jest czytany przy przygotowaniu misji, więc zadziała przy następnym uruchomieniu."

msgid "Nothing was applied: no apply action is defined for this file."
msgstr "Nic nie zostało zastosowane: dla tego pliku nie zdefiniowano żadnej akcji zastosowania."

msgid "This action is not recorded in the audit log on this install."
msgstr "Ta akcja nie jest zapisywana w dzienniku audytu w tej instalacji."

