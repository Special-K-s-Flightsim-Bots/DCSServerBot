msgid "Test the cloud-connection"
msgstr "Testowanie połączenia z chmurą"

msgid "Checking cloud connection ..."
msgstr "Sprawdzanie połączenia z chmurą ..."

msgid "Cloud connection established."
msgstr "Połączenie z chmurą nawiązane."

msgid "\nCloud TOKEN configured and valid."
msgstr "\nCloud TOKEN jest skonfigurowany i prawidłowy."

msgid "\nCloud TOKEN configured, but invalid!"
msgstr "\nCloud TOKEN jest skonfigurowany, ale nieprawidłowy!"

msgid "\nGet a cloud TOKEN, if you want to use cloud statistics!"
msgstr "\nPobierz Cloud TOKEN, jeśli chcesz korzystać ze statystyk chmury!"

msgid "Cloud not connected!"
msgstr "Brak połączenia z chmurą!"

msgid "Resync statistics with the cloud"
msgstr "Ponownie zsynchronizuj statystyki z chmurą"

msgid "No cloud sync configured!"
msgstr "Nie skonfigurowano synchronizacji z chmurą!"

msgid "Resync with cloud triggered."
msgstr "Uruchomiono ponowną synchronizację z chmurą."

msgid "Generate Cloud Statistics"
msgstr "Generuj statystyki chmury"

msgid "Cloud statistics are not activated in this Discord!"
msgstr "Statystyki chmury nie są aktywowane na tym serwerze Discord!"

msgid "Use {} to link your account."
msgstr "Użyj {}, aby powiązać swoje konto."

msgid "No cloud-based statistics found for this user."
msgstr "Nie znaleziono statystyk chmurowych dla tego użytkownika."

msgid "List registered DCS servers"
msgstr "Wyświetl zarejestrowane serwery DCS"

msgid "\nCloud sync configured and valid."
msgstr "\nSynchronizacja z chmurą skonfigurowana i prawidłowa."

msgid "\nYou need a cloud TOKEN, if you want to use cloud statistics!"
msgstr "\nPotrzebujesz Cloud TOKEN, jeśli chcesz korzystać ze statystyk chmury!"

msgid "\nCloud sync is disabled. Set 'register' to true in cloud.yaml to enable it."
msgstr "\nSynchronizacja z chmurą jest wyłączona. Ustaw 'register' na true w cloud.yaml, aby ją włączyć."

msgid "DCS Servers"
msgstr "Serwery DCS"

msgid "Address"
msgstr "Adres"

msgid "Map"
msgstr "Mapa"

msgid "Mission"
msgstr "Misja"

msgid "Time"
msgstr "Czas"

msgid "Restart in"
msgstr "Restart za"

msgid "No servers of this group are active."
msgstr "Żaden serwer tej grupy nie jest aktywny."

msgid "No server found with the name \"*{search}*\"."
msgstr "Nie znaleziono serwera o nazwie \"*{search}*\"."

msgid "A potential Troublemaker joined your Server"
msgstr "Potencjalny sprawca problemów dołączył do serwera"

msgid "Player {} is banned on {} other multiplayer servers for\n{}"
msgstr "Gracz {} jest zbanowany na {} innych serwerach wieloosobowych za\n{}"

msgid "You might want to watch them closely."
msgstr "Warto obserwować go uważnie."
