msgid "To which server do you want to upload this transponder file to?"
msgstr "Do którego serwera chcesz przesłać ten plik transpondera?"

msgid "LotAtc is not configured on any server."
msgstr "LotAtc nie jest skonfigurowany na żadnym serwerze."

msgid "Transponder file {} uploaded."
msgstr "Plik transpondera {} przesłany."

msgid "Transponder file {} could not be uploaded!"
msgstr "Nie udało się przesłać pliku transpondera {}!"

msgid "GCI {} on station."
msgstr "GCI {} na stanowisku."

msgid "GCI {} offline."
msgstr "GCI {} nieaktywny."

msgid "{num} {coalition} GCI{s} on station."
msgstr "{num} GCI {coalition}{s} na stanowisku."

msgid "{coalition} GCI \"{name}\" on station."
msgstr "GCI {coalition} \"{name}\" na stanowisku."

msgid "{coalition} GCI \"{name}\" offline."
msgstr "GCI {coalition} \"{name}\" nieaktywny."

msgid "Shows active GCIs"
msgstr "Pokazuje aktywnych GCI"

msgid "You need to join a side to show their GCIs"
msgstr "Musisz dołączyć do strony, aby wyświetlić jej GCI"

msgid "The following GCIs are active on the {coalition} side:\n{gcis}"
msgstr "Następujący GCI są aktywni po stronie {coalition}:\n{gcis}"

msgid "No GCIs are active on the {} side."
msgstr "Żaden GCI nie jest aktywny po stronie {}."

msgid "Information about {coalition} GCI \"{name}\\"
msgstr "Informacje o GCI {coalition} \"{name}\\"

msgid "Info about a GCI"
msgstr "Informacje o GCI"

msgid "Usage: {prefix}{command} <name>"
msgstr "Użycie: {prefix}{command} <nazwa>"

msgid "Commands to manage GCIs"
msgstr "Komendy do zarządzania GCI"

msgid "You are not allowed to see the {} GCIs."
msgstr "Brak uprawnień do wyświetlania GCI {}."

msgid "There are no {coalition} GCIs active in server {server}"
msgstr "Na serwerze {server} nie ma aktywnych GCI {coalition}"

msgid "GCI {} not found."
msgstr "Nie znaleziono GCI {}."

msgid "List of GCIs"
msgstr "Lista GCI"

msgid "List of active {} GCIs"
msgstr "Lista aktywnych GCI {}"

msgid "Server: {}"
msgstr "Serwer: {}"

msgid "You are not allowed to play when being a GCI."
msgstr "Nie można grać będąc GCI."

msgid "GCI {} tried to join as player {}!"
msgstr "GCI {} próbował dołączyć jako gracz {}!"

msgid "active"
msgstr "aktywny"

msgid "inactive"
msgstr "nieaktywny"
