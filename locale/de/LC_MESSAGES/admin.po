# /node upgrade / restart
msgid "Do you want to {} all nodes?"
msgstr "Möchtest Du alle Knoten {}"

msgid "Do you want to {method} node {node}?"
msgstr "Möchtest Du Knoten {node} {method}?"

msgid "upgrade"
msgstr "aktualisieren"

msgid "shutdown"
msgstr "herunterfahren"

msgid "restart"
msgstr "restarten"

msgid "Node {node} - {method} sent."
msgstr "Knoten {node} - {method} gesendet."

msgid "All nodes are"
msgstr "Alle Knoten werden"

msgid "Master is"
msgstr "Der Master wird"

msgid " going to {} **NOW**."
msgstr " **JETZT** {}"

# /node shutdown
msgid "Shuts a specific node down"
msgstr "Fährt einen Knoten herunter"

# /node restart
msgid "Restarts a specific node"
msgstr "Startet einen Knoten neu"

# /node offline
msgid "Shuts down all servers, enables maintenance"
msgstr "Wartungsmodus für alle Server an"

msgid "Shuts all servers down (default: on)"
msgstr "Fährt alle Server herunter (default: ein)"

msgid "Node {} is now offline."
msgstr "Knoten {} ist jetzt im Wartungsmodus."

# /node online
msgid "Clears the maintenance mode for all servers"
msgstr "Wartungsmodus für alle Server aus"

msgid "Start all your servers (default: off)"
msgstr "Startet alle Server (default: aus)"

msgid "Node {} is now online."
msgstr "Knoten {} ist wieder online."

# /node upgrade
msgid "Upgrade DCSServerBot"
msgstr "Aktualisiere DCSServerBot"

msgid "There is no upgrade available for "
msgstr "Es gibt keine Aktualisierung für "

msgid "your cluster"
msgstr "Dein Cluster"

msgid "node {}"
msgstr "Knoten {}"

msgid "You are trying to upgrade an agent node in a cluster. Are you really sure?"
msgstr "Bist Du Dir sicher, dass Du einen Agenten-Knoten in einem Cluster updaten möchtest?"

# /node shell
msgid "Run a shell command on a node"
msgstr "Führe einen Konsolenbefehl aus"

msgid "```Command executed.```"
msgstr "```Kommando ausgeführt.```"

# /reload
msgid "Reloads a plugin"
msgstr "Lade ein Plugin neu"

msgid "Plugin {} reloaded."
msgstr "Plugin {} neu geladen."

msgid "Plugin {} could not be reloaded, check the log for details."
msgstr "Plugin {} konnte nicht geladen werden, bitte überprüfe das Logfile."

msgid "All plugins reloaded."
msgstr "Alle Plugins wurden neu geladen."

msgid "One or more plugins could not be reloaded, check the log for details."
msgstr "Ein oder mehrere Plugins konnten nicht geladen werden, bitte überprüfe das Logfile."

# /node add_instance
msgid "Add/create an instance\n"
msgstr "Füge eine neue Instanz hinzu\n"

msgid "Either select an existing instance or enter the name of a new one"
msgstr "Wähle eine unbenutzte Instanz aus oder gib einen Namen für eine neue"

msgid "Take this instance configuration as a reference"
msgstr "Nutze diese Instanz als Referenz"

msgid "Instance \"{}\" created.\nDo you want to configure a server for this instance?"
msgstr "Instanz \"{}\" angelegt.\nMöchtest Du einen Server für diese Instanz konfigurieren?"

msgid "Server {server} assigned to instance {instance}."
msgstr "Server {server} wurde der Instanz {instance} zugeordnet."

msgid "Instance {} created blank with no server assigned."
msgstr "Instanz {} wurde ohne Server-Zuordnung erstellt."

msgid "Instance {instance} added to node {node}."
"Please make sure you forward the following ports:"
"```"
"- DCS Port:    {dcs_port} (TCP/UDP)"
"- WebGUI Port: {webgui_port} (TCP)"
"```"
msgstr "Instanz {instance} zum Knoten {node} hinzugefügt."
"Bitte stelle sicher, dass Du folgende Port-Weiterleitungen einrichtest:"
"```"
"- DCS Port:    {dcs_port} (TCP/UDP)"
"- WebGUI Port: {webgui_port} (TCP)"
"```"

msgid "Instance {instance} could not be added to node {node}, see log."
msgstr "Instanz {instance} konnte nicht zum Knoten {node} hinzugefügt werden.\nBitte überprüfe das Logfile."

# /node delete_instance
msgid "Delete an instance\n"
msgstr "Lösche eine Instanz\n"

msgid "The instance is in use by server \"{}\".\n"
"Do you really want to delete it?"
msgstr "Die Instanz wird zurzeit vom Server \"{}\" genutzt.\n"
"Möchtest Du sie wirklich löschen?"

msgid "Do you really want to delete instance {}?"
msgstr "Möchtest Du Instanz {} wirklich löschen?"

msgid "Do you want to remove the directory\n{}?"
msgstr "Möchtest Du das Verzeichnis {} auch löschen?"

msgid "Instance {instance} removed from node {node}."
msgstr "Instanz {instance} wurde vom Knoten {node} gelöscht."

msgid "Instance {} could not be deleted, because the directory is in use."
msgstr "Instanz {} konnte nicht gelöscht werden, da das Verzeichnis in Benutzung ist."

# /node rename_instance
msgid "Rename an instance\n"
msgstr "Nenne eine Instanz um\n"

msgid "Server {} has to be shut down before renaming the instance!"
msgstr "Server {} muss zum Umbenennen heruntergefahren werden!"

msgid "Do you really want to rename instance {}?"
msgstr "Möchtest Du Instanz {} wirklich umbenennen?"

msgid "Instance {old_name} renamed to {new_name}."
msgstr "Instanz {old_name} umbenannt zu {new_name}."

msgid "Instance {} could not be renamed, because the directory is in use."
msgstr "Instanz {} konnte nicht umbenannt werden, da das Verzeichnis in Benutzung ist."

# Config upload
msgid "To which server do you want to upload this configuration to?"
msgstr "Auf welchen Server soll diese Konfigurationsdatei geladen werden?"

msgid "Error while uploading file to node {}!"
msgstr "Fehler beim Upload auf Knoten {}!"

msgid "Error while reading file from discord."
msgstr "Fehler beim Laden von Discord."

msgid "Plugin {} re-loaded."
msgstr "Plugin {} wurde neu geladen."

msgid "To apply the new config by restarting a node or the whole cluster, use {}"
msgstr "Um die neue Konfiguration zu laden, nutze {}"

# /webadmin status
msgid "A configuration change applies on the next node restart, not on a page reload."
msgstr "Eine Konfigurationsänderung greift erst beim nächsten Neustart des Knotens, nicht beim Neuladen der Seite."

# /webadmin status
msgid "Configuration file"
msgstr "Konfigurationsdatei"

# /webadmin status
msgid "Frontend"
msgstr "Frontend"

# /webadmin status
msgid "frontend is off — the service serves the REST API only: no page, no login, no session cookie. Set frontend: true."
msgstr "frontend ist aus — der Dienst liefert nur die REST-API: keine Seite, kein Login, kein Session-Cookie. Setze frontend: true."

# /webadmin status
msgid "username and password"
msgstr "Benutzername und Passwort"

# /webadmin status
msgid "Discord"
msgstr "Discord"

# /webadmin status
msgid "break-glass credential"
msgstr "Notfall-Zugangsdaten"

# /webadmin status
msgid "Login"
msgstr "Login"

# /webadmin status
msgid "The login block is empty — every page answers 403. Enable at least one of auth.local, auth.discord or auth.breakglass."
msgstr "Der Login-Block ist leer — jede Seite antwortet mit 403. Aktiviere mindestens eine der Varianten auth.local, auth.discord oder auth.breakglass."

# /webadmin status
msgid "Session secret"
msgstr "Session-Secret"

# /webadmin status
msgid "Public address"
msgstr "Öffentliche Adresse"

# /webadmin status
msgid "Service"
msgstr "Dienst"

# /webadmin status
msgid "Next step"
msgstr "Nächster Schritt"

# /webadmin status
msgid "Inspects the configuration of the admin website"
msgstr "Prüft die Konfiguration der Admin-Webseite"

# /webadmin status
msgid "frontend is on — the pages, the login and the session cookie are installed."
msgstr "frontend ist an — Seiten, Login und Session-Cookie sind installiert."

# /webadmin status
msgid "session.secret is not set — a random key is generated at every start, so everyone is signed out when the node restarts. Set a secret of at least 32 characters."
msgstr "session.secret ist nicht gesetzt — bei jedem Start wird ein zufälliger Schlüssel erzeugt, also werden alle beim Neustart des Knotens abgemeldet. Setze ein Secret mit mindestens 32 Zeichen."

# /webadmin status
msgid "auth.public_base_url is not set — redirect URIs are built from it, so a Discord login cannot return. Set the address your users open, e.g. https://dcs.example.com."
msgstr "auth.public_base_url ist nicht gesetzt — die Redirect-URIs werden daraus gebildet, ein Discord-Login kann also nicht zurückkommen. Setze die Adresse, die deine Nutzer öffnen, z. B. https://dcs.example.com."

# /webadmin status
msgid "The website runs on the master node only — this is not the master, so nothing is served here. Run the check on the master."
msgstr "Die Webseite läuft nur auf dem Master-Knoten — dies ist nicht der Master, hier wird also nichts ausgeliefert. Führe die Prüfung auf dem Master aus."

# /webadmin status
msgid "The service is loaded but not running, so nothing answers on a port. Restart the node."
msgstr "Der Dienst ist geladen, läuft aber nicht, es antwortet also kein Port. Starte den Knoten neu."

# /webadmin status
msgid "Website status"
msgstr "Status der Webseite"

# /webadmin status
msgid "Shows which part of the website configuration is missing"
msgstr "Zeigt, welcher Teil der Webseiten-Konfiguration fehlt"

# /webadmin status
msgid "{} found."
msgstr "{} gefunden."

# /webadmin status
msgid "session.secret is set ({} characters) — sessions survive a node restart."
msgstr "session.secret ist gesetzt ({} Zeichen) — Sitzungen überstehen einen Neustart des Knotens."

# /webadmin status
msgid "auth.public_base_url is {} — redirect URIs are built from it."
msgstr "auth.public_base_url ist {} — die Redirect-URIs werden daraus gebildet."

# /webadmin status
msgid "The service is not loaded on this node — {} is read at startup. Restart the node."
msgstr "Der Dienst ist auf diesem Knoten nicht geladen — {} wird beim Start gelesen. Starte den Knoten neu."

# /webadmin status
msgid "The address is not known yet."
msgstr "Die Adresse ist noch unbekannt."

# /webadmin status
msgid "{} is missing — no website service exists without it. Run /webadmin setup to create it."
msgstr "{} fehlt — ohne diese Datei gibt es keinen Webseiten-Dienst. Führe /webadmin setup aus, um sie zu erstellen."

# /webadmin status
msgid "Login is enabled for: {}."
msgstr "Login ist aktiviert für: {}."

# /webadmin status
msgid "session.secret is only {} characters long — a key shorter than 32 characters is refused at startup. Use at least 32."
msgstr "session.secret ist nur {} Zeichen lang — ein Schlüssel unter 32 Zeichen wird beim Start abgelehnt. Nutze mindestens 32."

# /webadmin status
msgid "auth.public_base_url is not an absolute http(s) address ({}) — redirect URIs are built from it."
msgstr "auth.public_base_url ist keine absolute http(s)-Adresse ({}) — die Redirect-URIs werden daraus gebildet."

# /webadmin status
msgid "auth.public_base_url points at this machine only ({}) — a Discord login comes back to this machine and nowhere else. Set the address your users open."
msgstr "auth.public_base_url zeigt nur auf diese Maschine ({}) — ein Discord-Login kommt nur auf dieser Maschine zurück. Setze die Adresse, die deine Nutzer öffnen."

# /webadmin status
msgid "The service is running on this node, port {}."
msgstr "Der Dienst läuft auf diesem Knoten, Port {}."

# /webadmin status
msgid "Open {}."
msgstr "Öffne {}."

# /webadmin setup
msgid "Not chosen yet — pick a sign-in mode from the list below."
msgstr "Noch nicht gewählt — wähle unten eine Anmeldeart aus der Liste."

# /webadmin setup
msgid "Everything is collected — press the button below to write the configuration."
msgstr "Alles beisammen — drücke unten die Taste, um die Konfiguration zu schreiben."

# /webadmin setup
msgid "Discord login and a local account"
msgstr "Discord-Anmeldung und ein lokales Konto"

# /webadmin setup
msgid "Manual"
msgstr "Manuell"

# /webadmin setup
msgid "Pick how you sign in from the list below."
msgstr "Wähle unten aus der Liste, wie du dich anmeldest."

# /webadmin setup
msgid "Fill in the form the wizard opened."
msgstr "Fülle das Formular aus, das der Assistent geöffnet hat."

# /webadmin setup
msgid "The configuration keeps auth.discord.client_secret_key: discord_client_secret."
msgstr "Die Konfiguration behält auth.discord.client_secret_key: discord_client_secret."

# /webadmin setup
msgid "Client secret"
msgstr "Client-Secret"

# /webadmin setup
msgid "Username"
msgstr "Benutzername"

# /webadmin setup
msgid "Website setup"
msgstr "Webseiten-Einrichtung"

# /webadmin setup
msgid "Turns the admin website on and stores the login secret"
msgstr "Schaltet die Admin-Webseite ein und speichert das Anmelde-Geheimnis"

# /webadmin setup
msgid "Listen"
msgstr "Bindeadresse"

# /webadmin setup
msgid "How do you want to sign in?"
msgstr "Wie möchtest du dich anmelden?"

# /webadmin setup
msgid "Write the configuration"
msgstr "Konfiguration schreiben"

# /webadmin setup
msgid "Step 1: address and port"
msgstr "Schritt 1: Adresse und Port"

# /webadmin setup
msgid "Step 2: Discord login"
msgstr "Schritt 2: Discord-Anmeldung"

# /webadmin setup
msgid "Step 2: local account"
msgstr "Schritt 2: lokales Konto"

# /webadmin setup
msgid "Local account"
msgstr "Lokales Konto"

# /webadmin setup
msgid "This node is not the master — the website runs on the master node only. Run /webadmin setup on the master node."
msgstr "Dieser Knoten ist nicht der Master — die Webseite läuft nur auf dem Master-Knoten. Führe /webadmin setup auf dem Master-Knoten aus."

# /webadmin setup
msgid "Manual setup"
msgstr "Manuelle Einrichtung"

# /webadmin setup
msgid "Pick how you sign in first."
msgstr "Wähle zuerst, wie du dich anmeldest."

# /webadmin setup
msgid "The public address has to be an absolute http or https address."
msgstr "Die öffentliche Adresse muss eine absolute http- oder https-Adresse sein."

# /webadmin setup
msgid "The client secret is required."
msgstr "Das Client-Secret ist erforderlich."

# /webadmin setup
msgid "Backup"
msgstr "Sicherung"

# /webadmin setup
msgid "Nothing changed — {} already matches."
msgstr "Nichts geändert — {} entspricht bereits."

# /webadmin setup
msgid "{} was written."
msgstr "{} wurde geschrieben."

# /webadmin setup
msgid "This node is not the master — the website runs on the master node only. Run /webadmin setup on {}."
msgstr "Dieser Knoten ist nicht der Master — die Webseite läuft nur auf dem Master-Knoten. Führe /webadmin setup auf {} aus."

# /webadmin setup
msgid "The configuration could not be written: {}"
msgstr "Die Konfiguration konnte nicht geschrieben werden: {}"

# /webadmin setup
msgid "Store the client secret with:"
msgstr "Speichere das Client-Secret mit:"

# /webadmin setup
msgid "The port has to be a whole number between {} and {}."
msgstr "Der Port muss eine ganze Zahl zwischen {} und {} sein."

# /webadmin setup
msgid "The previous version is kept as {}."
msgstr "Die vorherige Version wird als {} aufbewahrt."

# /webadmin setup
msgid "A configuration change applies on the next node restart, not on a page reload: {}"
msgstr "Eine Konfigurationsänderung wirkt erst beim nächsten Knoten-Neustart, nicht beim Neuladen der Seite: {}"

# /webadmin setup
msgid "Open the Discord Developer Portal, your application → OAuth2, and add the redirect URI {}."
msgstr "Öffne das Discord Developer Portal, deine Anwendung → OAuth2, und füge die Redirect-URI {} hinzu."

# /webadmin setup
msgid "Discord login"
msgstr "Discord-Anmeldung"

# /webadmin setup
msgid "Port"
msgstr "Port"

# /webadmin setup
msgid "The bot's application id could not be read, so the Discord login cannot be configured here."
msgstr "Die Anwendungs-ID des Bots konnte nicht gelesen werden, daher kann die Discord-Anmeldung hier nicht eingerichtet werden."

# /webadmin
msgid "Inspects and sets up the admin website"
msgstr "Prüft und richtet die Admin-Webseite ein"

# /webadmin status
msgid "auth.public_base_url is {} — plain http carries the login page and the session cookie in cleartext. Set an https address, or an address inside your own network."
msgstr "auth.public_base_url ist {} — unverschlüsseltes http überträgt die Anmeldeseite und das Sitzungs-Cookie im Klartext. Setze eine https-Adresse oder eine Adresse innerhalb deines eigenen Netzwerks."

# /webadmin setup
msgid "The client secret is stored under auth.discord.client_secret_key — the configuration file names that key only, never the value."
msgstr "Das Client-Secret liegt unter auth.discord.client_secret_key — die Konfigurationsdatei nennt nur diesen Schlüssel, nie den Wert."

# /webadmin setup
msgid "Step 2: Discord login and a local account"
msgstr "Schritt 2: Discord-Anmeldung und ein lokales Konto"

# /webadmin setup
msgid "Password"
msgstr "Passwort"

# /webadmin setup
msgid "A username is required."
msgstr "Ein Benutzername ist erforderlich."

# /webadmin setup
msgid "The password has to be at least {} characters long."
msgstr "Das Passwort muss mindestens {} Zeichen lang sein."

# /webadmin setup
msgid "The local account '{}' already exists — nothing was written. Change its password with the user password command instead."
msgstr "Das lokale Konto '{}' existiert bereits — es wurde nichts geschrieben. Ändere sein Passwort stattdessen mit dem Befehl user password."

# /webadmin setup
msgid "The local account {} is set up; its password is the one you entered."
msgstr "Das lokale Konto {} ist eingerichtet; sein Passwort ist das von dir eingegebene."

# /webadmin user
msgid "The username has to be at most {} characters long."
msgstr "Der Benutzername darf höchstens {} Zeichen lang sein."

# /webadmin user
msgid "The password has to be at most {} characters long."
msgstr "Das Passwort darf höchstens {} Zeichen lang sein."

# /webadmin user
msgid "The local account '{}' is not in the configuration any more — reload and pick again."
msgstr "Das lokale Benutzerkonto '{}' ist nicht mehr in der Konfiguration enthalten — neu laden und erneut auswählen."

# /webadmin user
msgid "The role(s) {} are not defined by this installation — nothing was written. Known roles: {}."
msgstr "Die Rolle(n) {} sind in dieser Installation nicht definiert — es wurde nichts geschrieben. Bekannte Rollen: {}."

# /webadmin user
msgid "The local account '{}' is the last one holding Admin — removing it would lock everyone out of the console. Give another account Admin first."
msgstr "Das lokale Benutzerkonto '{}' ist das letzte mit der Rolle Admin — es zu entfernen würde alle aus der Konsole aussperren. Geben Sie zuerst einem anderen Konto Admin."

# /webadmin user
msgid "Pick at least one role for the new account."
msgstr "Wählen Sie mindestens eine Rolle für das neue Konto."

# /webadmin user
msgid "Local account removed"
msgstr "Lokales Benutzerkonto entfernt"

# /webadmin user
msgid "Account"
msgstr "Konto"

# /webadmin user
msgid "The REST API plugin was reloaded, so its routes are attached to the new application object."
msgstr "Das REST-API-Plugin wurde neu geladen, daher sind seine Routen an das neue Anwendungsobjekt angehängt."

# /webadmin restart
msgid "The REST API plugin is loaded on this node, but its reload failed, so its routes are still attached to the old application object — reload it by hand."
msgstr "Das REST-API-Plugin ist auf diesem Node geladen, aber das Neuladen ist fehlgeschlagen, daher sind seine Routen weiterhin an das alte Anwendungsobjekt angehängt — laden Sie es manuell neu."

# /webadmin user
msgid "The REST API plugin is not loaded on this node, so no routes had to be re-attached."
msgstr "Das REST-API-Plugin ist auf diesem Node nicht geladen, daher mussten keine Routen neu angehängt werden."

# /webadmin user
msgid "session.secret is not set — every restart mints a new random session key, so this signs everyone out. Write session.secret first, or press the button again to confirm."
msgstr "session.secret ist nicht gesetzt — jeder Neustart erzeugt einen neuen zufälligen Sitzungsschlüssel, wodurch alle abgemeldet werden. Setzen Sie zuerst session.secret, oder bestätigen Sie mit der Schaltfläche erneut."

# /webadmin user
msgid "The web console could not be restarted ({}). It is down until the bot is restarted."
msgstr "Die Web-Konsole konnte nicht neu gestartet werden ({}). Sie ist heruntergefahren, bis der Bot neu gestartet wird."

# /webadmin user
msgid "The web console did not come back up — it is down until the bot is restarted. Check the bot's log for the service's error."
msgstr "Die Web-Konsole ist nicht wieder hochgekommen — sie ist heruntergefahren, bis der Bot neu gestartet wird. Prüfen Sie das Bot-Log auf den Fehler des Dienstes."

# /webadmin user
msgid "The web console was rebuilt and is running on port {}."
msgstr "Die Web-Konsole wurde neu aufgebaut und läuft auf Port {}."

# /webadmin user
msgid "The web console was rebuilt and is running."
msgstr "Die Web-Konsole wurde neu aufgebaut und läuft."

# /webadmin user
msgid "Web console restart"
msgstr "Web-Konsolen-Neustart"

# /webadmin user
msgid "Result"
msgstr "Ergebnis"

# /webadmin user
msgid "Address"
msgstr "Adresse"

# /webadmin user
msgid "Restart anyway"
msgstr "Trotzdem neu starten"

# /webadmin user
msgid "Cancel"
msgstr "Abbrechen"

# /webadmin user
msgid "Nothing was restarted."
msgstr "Es wurde nichts neu gestartet."

# /webadmin user
msgid "Restart the web console"
msgstr "Web-Konsole neu starten"

# /webadmin user
msgid "Roles"
msgstr "Rollen"

# /webadmin user
msgid "New password"
msgstr "Neues Passwort"

# /webadmin user
msgid "Add a local account"
msgstr "Lokales Benutzerkonto hinzufügen"

# /webadmin user
msgid "Set a new password for {}"
msgstr "Neues Passwort für {} festlegen"

# /webadmin user
msgid "Pick a local account"
msgstr "Lokales Benutzerkonto auswählen"

# /webadmin user
msgid "Account to remove"
msgstr "Zu entfernendes Benutzerkonto"

# /webadmin user
msgid "Account whose password to change"
msgstr "Benutzerkonto, dessen Passwort geändert wird"

# /webadmin user
msgid "Delete it"
msgstr "Löschen"

# /webadmin user
msgid "Nothing was deleted."
msgstr "Es wurde nichts gelöscht."

# /webadmin user
msgid "This node is not the master — the website runs on the master node only. Run {} on {}."
msgstr "Dieser Node ist nicht der Master — die Website läuft nur auf dem Master-Node. Führen Sie {} auf {} aus."

# /webadmin user
msgid "This node is not the master — the website runs on the master node only. Run {} on the master node."
msgstr "Dieser Node ist nicht der Master — die Website läuft nur auf dem Master-Node. Führen Sie {} auf dem Master-Node aus."

# /webadmin user
msgid "This installation defines no role names, so no account can be granted one."
msgstr "Diese Installation definiert keine Rollennamen, daher kann keinem Konto eine zugewiesen werden."

# /webadmin user
msgid "Adds a local account to the admin website"
msgstr "Fügt der Admin-Website ein lokales Benutzerkonto hinzu"

# /webadmin user
msgid "The website configuration carries no local accounts."
msgstr "Die Website-Konfiguration enthält keine lokalen Benutzerkonten."

# /webadmin user
msgid "Pick the local account to remove. This cannot be undone."
msgstr "Wählen Sie das zu entfernende lokale Benutzerkonto. Dies kann nicht rückgängig gemacht werden."

# /webadmin user
msgid "Removes a local account from the admin website"
msgstr "Entfernt ein lokales Benutzerkonto von der Admin-Website"

# /webadmin user
msgid "Delete the local account '{}'? This cannot be undone."
msgstr "Das lokale Benutzerkonto '{}' löschen? Dies kann nicht rückgängig gemacht werden."

# /webadmin user
msgid "Pick the local account whose password you want to change."
msgstr "Wählen Sie das lokale Benutzerkonto, dessen Passwort Sie ändern möchten."

# /webadmin user
msgid "Sets a new password for a local account"
msgstr "Setzt ein neues Passwort für ein lokales Benutzerkonto"

# /webadmin user
msgid "Manages the local accounts that sign in to the admin website"
msgstr "Verwaltet die lokalen Benutzerkonten, die sich bei der Admin-Website anmelden"

# /webadmin setup
msgid "Setup cancelled — nothing was written."
msgstr "Einrichtung abgebrochen — es wurde nichts geschrieben."
