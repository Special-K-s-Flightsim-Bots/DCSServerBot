msgid "Clear"
msgstr "Zurücksetzen"

#: services/webservice/readmodels/servers.py:31
msgid "Dynamic"
msgstr "Dynamisch"

#: services/webservice/readmodels/servers.py:266
msgid "No Trial Clients"
msgstr "Keine Trial-Clients"

#: services/webservice/readmodels/servers.py:267
msgid "Pure Clients Required"
msgstr "Pure Clients erforderlich"

#: services/webservice/readmodels/servers.py:268
msgid "Pure Scripts Required"
msgstr "Pure Scripts erforderlich"

#: services/webservice/readmodels/servers.py:269
msgid "Pure Models Required"
msgstr "Pure Models erforderlich"

