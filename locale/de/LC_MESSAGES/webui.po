#: services/webservice/pages/presets.py:213
#, python-format
msgid ""
"No change was saved: the edited YAML carries %(count)s preset keys "
"(%(keys)s), and expert mode edits exactly the one preset this page opened"
" — nothing was written."
msgstr ""
"Es wurde nichts gespeichert: Das bearbeitete YAML enthält %(count)s "
"Preset-Schlüssel (%(keys)s), und der Expertenmodus bearbeitet genau das "
"eine Preset, das diese Seite geöffnet hat — es wurde nichts geschrieben."

#: services/webservice/pages/presets.py:216
#, python-format
msgid ""
"No change was saved: the edited YAML is keyed '%(posted)s', and this page"
