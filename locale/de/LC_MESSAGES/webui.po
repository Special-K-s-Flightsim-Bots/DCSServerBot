#, python-format
msgid ""
"No change was saved: '%(label)s' accepts %(min)s to %(max)s, and the "
"value entered is %(value)s — nothing was written."
msgstr ""
"Es wurde nichts gespeichert: '%(label)s' akzeptiert %(min)s bis %(max)s, "
"und der eingegebene Wert ist %(value)s — es wurde nichts geschrieben."

#: services/webservice/pages/presets.py:158
#, python-format
msgid ""
"No change was saved: no preset named '%(name)s' is in this installation's"
