msgstr ""

#: services/webservice/pages/actions.py:1030
msgid "a chat line in game, addressed to the recipients you choose"
msgstr ""

#: services/webservice/pages/actions.py:1031
#, python-brace-format
msgid ""
"<b>The recipients you choose below read this line.</b> It appears in "
"their game chat on {server} under your name, as if you had typed it "
