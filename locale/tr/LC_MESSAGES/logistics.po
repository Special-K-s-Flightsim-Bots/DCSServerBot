msgid "Logistics mission management"
msgstr "Lojistik görev yönetimi"

msgid "Create a new logistics task"
msgstr "Yeni bir lojistik görevi oluştur"

msgid "List logistics tasks"
msgstr "Lojistik görevlerini listele"

msgid "View details of a logistics task"
msgstr "Bir lojistik görevinin detaylarını görüntüle"

msgid "Approve a pending logistics request"
msgstr "Bekleyen bir lojistik talebini onayla"

msgid "Deny a pending logistics request"
msgstr "Bekleyen bir lojistik talebini reddet"

