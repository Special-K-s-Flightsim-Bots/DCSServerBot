msgid "Commands to manage player credits"
msgstr "Oyuncu kredilerini yönetmek için komutlar"

msgid "Shows your current credits"
msgstr "Mevcut kredilerinizi gösterir"

msgid "You need the DCS Admin role to use this command!"
msgstr "Bu komutu kullanmak için DCS Admin rolüne sahip olmalısınız!"

msgid "Member {} is not linked to any DCS user!"
msgstr "Üye {} herhangi bir DCS kullanıcısıyla eşleştirilmemiş!"

msgid "Use {} to link your account."
msgstr "Hesabınızı eşleştirmek için {} komutunu kullanın."

msgid "{} has no campaign credits."
msgstr "{} kullanıcısının sefer (campaign) kredisi yok."

msgid "Campaign Credits for {}"
msgstr "{} için Sefer Kredileri"

msgid "Campaign"
msgstr "Sefer (Campaign)"

msgid "Credits"
msgstr "Kredi"

msgid "Time"
msgstr "Zaman"

msgid "Event"
msgstr "Olay"

msgid "Log shows the last 10 events only."
msgstr "Kayıt yalnızca son 10 olayı gösterir."

msgid "{} needs to properly link their DCS account to receive donations."
msgstr "{} bağış alabilmek için DCS hesabını doğru şekilde eşleştirmelidir."

msgid "It seems like there is no campaign running on your server(s)."
msgstr "Sunucularınızda çalışan aktif bir sefer (campaign) yok gibi görünüyor."

msgid "Campaign Credits"
msgstr "Sefer Kredileri"

msgid "Member {} would overrun the configured maximum points with this donation. Aborted."
msgstr "Üye {} bu bağışla yapılandırılan maksimum puanı aşacak. İptal edildi."

msgid "Donation from member {}"
msgstr "{} üyesinden bağış"

msgid "Credit points change by Admin {}"
msgstr "Yönetici {} tarafından kredi puanı değişikliği"

msgid "You just received {} credit points from an Admin."
msgstr "Bir Yöneticiden {} kredi puanı aldınız."

msgid ", you just received {} credit points from an Admin."
msgstr ", bir Yöneticiden {} kredi puanı aldınız."

msgid "Your credits were decreased by {} credit points by an Admin."
msgstr "Krediniz bir Yönetici tarafından {} puan azaltıldı."

msgid ", your credits were decreased by {} credit points by an Admin."
msgstr ", krediniz bir Yönetici tarafından {} puan azaltıldı."

msgid "Donated {credits} points to {name}."
msgstr "{name} kullanıcısına {credits} puan bağışlandı."

msgid "Donate credits to another member"
msgstr "Başka bir üyeye kredi bağışlayın"

msgid "You can't donate to yourself."
msgstr "Kendinize bağış yapamazsınız."

msgid "Your donation has to be > 0."
msgstr "Bağışınız 0'dan büyük olmalıdır."

msgid "You need to properly link your DCS account to give donations!"
msgstr "Bağış yapabilmek için DCS hesabınızı doğru şekilde eşleştirmelisiniz!"

msgid "You don't have any credit points to donate."
msgstr "Bağışlayacak kredi puanınız yok."

msgid "You can't donate {donation} credit points, you only have {total}!"
msgstr "{donation} kredi puanı bağışlayamazsınız, yalnızca {total} puanınız var!"

msgid "Donation to member {}"
msgstr "{} üyesine bağış"

msgid "You just received {donation} credit points from {member}!"
msgstr "{member} üyesinden {donation} kredi puanı aldınız!"

msgid ", you just received {donation} credit points from {member}!"
msgstr ", {member} üyesinden {donation} kredi puanı aldınız!"

msgid "Reset credits for a player or a whole campaign"
msgstr "Bir oyuncunun veya tüm seferin kredilerini sıfırlayın"

msgid "I'm going to delete the campaign credits of user\n{} for the running campaign."
msgstr "Aktif sefer için {}\nkullanıcısının sefer kredilerini sileceğim."

msgid "I'm going to delete all campaign credits for the running campaign."
msgstr "Aktif sefer için tüm sefer kredilerini sileceğim."

msgid "Aborted."
msgstr "İptal edildi."

msgid "Campaign credits have been deleted."
msgstr "Sefer kredileri silindi."

msgid "Initial points received"
msgstr "Başlangıç puanları alındı"

msgid "{name}, you currently have {credits} credit points."
msgstr "{name}, şu anda {credits} kredi puanınız var."

msgid "Unknown mission achievement"
msgstr "Bilinmeyen görev başarımı"

msgid "for killing {}"
msgstr "{} vurduğu için"

msgid "You currently have {} credit points"
msgstr "Şu anda {} kredi puanınız var"

msgid "Donate credits to another player"
msgstr "Başka bir oyuncuya kredi bağışla"

msgid "Usage: {prefix}{command} player points"
msgstr "Kullanım: {prefix}{command} oyuncu puan"

msgid "Player {} not found."
msgstr "Oyuncu {} bulunamadı."

msgid "Player {} would overrun the configured maximum points with this donation. Aborted."
msgstr "Oyuncu {} bu bağışla maksimum puanı aşacak. İptal edildi."

msgid "Donation to player {}"
msgstr "{} oyuncusuna bağış"

msgid "Donation from player {}"
msgstr "{} oyuncusundan bağış"

msgid "You've donated {donation} credit points to player {name}."
msgstr "{name} oyuncusuna {donation} kredi puanı bağışladınız."

msgid "Player {name} donated {donation} credit points to you!"
msgstr "{name} oyuncusu size {donation} kredi puanı bağışladı!"

msgid "Tip a GCI with points"
msgstr "GCI kontrolörüne puan bahşişi ver"

msgid "Usage: {prefix}{command} points [gci_number]"
msgstr "Kullanım: {prefix}{command} puan [gci_numarası]"

msgid "There is currently no {} GCI active."
msgstr "Şu anda aktif {} GCI bulunmuyor."

msgid "Multiple GCIs found, use \"{}tip points gci_number\"."
msgstr "Birden fazla GCI bulundu, \"{}tip puan gci_numarası\" kullanın."

msgid "You've donated {donation} credit points to GCI {name}."
msgstr "GCI {name} kontrolörüne {donation} kredi puanı bağışladınız."
