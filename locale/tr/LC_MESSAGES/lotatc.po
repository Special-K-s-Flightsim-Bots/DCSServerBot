msgid "To which server do you want to upload this transponder file to?"
msgstr "Bu transponder dosyasını hangi sunucuya yüklemek istiyorsunuz?"

msgid "LotAtc is not configured on any server."
msgstr "LotAtc hiçbir sunucuda yapılandırılmamış."

msgid "Transponder file {} uploaded."
msgstr "Transponder dosyası {} yüklendi."

msgid "Transponder file {} could not be uploaded!"
msgstr "Transponder dosyası {} yüklenemedi!"

msgid "GCI {} on station."
msgstr "GCI {} görev başında."

msgid "GCI {} offline."
msgstr "GCI {} çevrimdışı."

msgid "{num} {coalition} GCI{s} on station."
msgstr "{num} {coalition} GCI görev başında."

msgid "{coalition} GCI \"{name}\" on station."
msgstr "{coalition} GCI \"{name}\" görev başında."

msgid "{coalition} GCI \"{name}\" offline."
msgstr "{coalition} GCI \"{name}\" çevrimdışı."

msgid "Shows active GCIs"
msgstr "Aktif GCI kontrolörlerini gösterir"

msgid "You need to join a side to show their GCIs"
msgstr "GCI kontrolörlerini görmek için bir koalisyona katılmalısınız"

msgid "The following GCIs are active on the {coalition} side:\n{gcis}"
msgstr "{coalition} tarafında aşağıdaki GCI kontrolörleri aktif:\n{gcis}"

msgid "No GCIs are active on the {} side."
msgstr "{} tarafında aktif GCI bulunmuyor."

msgid "Information about {coalition} GCI \"{name}\""
msgstr "{coalition} GCI \"{name}\" hakkında bilgi"

msgid "Info about a GCI"
msgstr "Bir GCI hakkında bilgi"

msgid "Usage: {prefix}{command} <name>"
msgstr "Kullanım: {prefix}{command} <isim>"

msgid "Commands to manage GCIs"
msgstr "Yönetim komutları: GCIs"

msgid "You are not allowed to see the {} GCIs."
msgstr "You are not allowed to see the {} GCIs."

msgid "There are no {coalition} GCIs active in server {server}"
msgstr "There are no {coalition} GCIs active in sunucu {sunucu}"

msgid "GCI {} not found."
msgstr "GCI {} bulunamadı."

msgid "List of GCIs"
msgstr "List of GCIs"

msgid "List of active {} GCIs"
msgstr "List of active {} GCIs"

msgid "Server: {}"
msgstr "Sunucu: {}"

msgid "You are not allowed to play when being a GCI."
msgstr "You are not allowed to play when being a GCI."

msgid "GCI {} tried to join as player {}!"
msgstr "GCI {} tried to join as oyuncu {}!"

