msgid "Commands to manage custom mods in your DCS server"
msgstr "DCS sunucunuzdaki özel modları yönetmek için komutlar"

msgid "manage mods"
msgstr "modları yönet"

msgid "Shutting down {}, please wait ..."
msgstr "{} kapatılıyor, lütfen bekleyin ..."

msgid "**The following mods are currently installed:**"
msgstr "**Şu anda yüklü olan modlar:**"

msgid "Mod"
msgstr "Mod"

msgid "Version"
msgstr "Sürüm"

msgid "Update"
msgstr "Güncelle"

msgid "There are no mods installed."
msgstr "Yüklü mod bulunmuyor."

msgid "Select a mod to install / update"
msgstr "Yüklemek / güncellemek için bir mod seçin"

msgid "Select a mod to uninstall"
msgstr "Kaldırmak için bir mod seçin"

msgid "Download"
msgstr "İndir"

msgid "Shutdown"
msgstr "Kapat"

