msgstr "Modları kaldırmak için {} sunucusunun kapatılması gerekiyor."

msgid "List all installed mods"
msgstr "Yüklü tüm modları listele"

msgid "No mod installed on server {}."
msgstr "{} sunucusunda yüklü mod yok."

msgid "The following mods are installed on server {}:"
msgstr "{} sunucusunda aşağıdaki modlar yüklü:"

msgid "Folder"
msgstr "Klasör"

msgid "Download a mod"
msgstr "Bir mod indir"

