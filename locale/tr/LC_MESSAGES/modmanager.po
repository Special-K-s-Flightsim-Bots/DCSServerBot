msgid "Mod {mod} updated to version {version}."
msgstr "{mod} modu {version} sürümüne güncellendi."

msgid "Mod {mod} installed with version {version}."
msgstr "{mod} modu {version} sürümüyle yüklendi."

msgid "Uninstall mods"
msgstr "Modları kaldır"

