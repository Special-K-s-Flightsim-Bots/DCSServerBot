msgid "{} is not a valid URL!"
msgstr "{} geçerli bir URL değil!"

msgid "Downloading {} , please wait ..."
msgstr "{} indiriliyor, lütfen bekleyin ..."

msgid "Error: {}"
msgstr "Hata: {}"

msgid "Mod Manager"
msgstr "Mod Yöneticisi"

msgid "Install or uninstall mods to {}"
msgstr "{} sunucusuna mod yükle veya kaldır"

msgid "Install mods"
msgstr "Mod yükle"

msgid "Server {} needs to be shut down to install mods."
msgstr "Mod yüklemek için {} sunucusunun kapatılması gerekiyor."

msgid "Mod {} not found!"
msgstr "{} modu bulunamadı!"

msgid "Mod {mod}_v{version} is already installed!"
msgstr "{mod}_v{version} modu zaten yüklü!"

