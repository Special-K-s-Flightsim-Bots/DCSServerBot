msgid "File exists. Do you want to overwrite it?"
msgstr "Dosya zaten mevcut. Üzerine yazmak istiyor musunuz?"

msgid "Aborted."
msgstr "İptal edildi."

msgid "Error {code}: {mod}_v{version} {message}"
msgstr "Hata {code}: {mod}_v{version} {message}"

msgid "{file} downloaded. Use {command} to install it."
msgstr "{file} indirildi. Yüklemek için {command} komutunu kullanın."

msgid "Downloading {} ..."
msgstr "{} indiriliyor ..."

msgid "List was truncated."
msgstr "List was truncated."

msgid "Server {} needs to be shut down to change mods."
msgstr "Sunucu {} needs to be shut down to change mods."

msgid "Destination"
msgstr "Destination"

msgid "Multiple returns, use /{group} {name} instead."
