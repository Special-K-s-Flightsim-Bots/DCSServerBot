msgid "Commands to manage Tacview"
msgstr "Tacview eklentisini yönetmek için komutlar"

msgid "Configure Tacview"
msgstr "Tacview'u yapılandır"

msgid "Tacview not installed on server {}!"
msgstr "{} sunucusunda Tacview kurulu değil!"

msgid "Tacview configuration changed on server {}."
msgstr "{} sunucusunda Tacview yapılandırması değiştirildi."

msgid "Server {} needs to be shut down to configure Tacview."
msgstr "Tacview yapılandırmak için {} sunucusu kapatılmalıdır."

msgid "Install Tacview"
msgstr "Tacview yükle"

msgid "Tacview already installed on server {}!"
msgstr "{} sunucusunda Tacview zaten yüklü!"

msgid "Installing Tacview on server {} ..."
msgstr "{} sunucusuna Tacview yükleniyor ..."

msgid "Tacview is not configured on node {}!"
msgstr "{} düğümünde Tacview yapılandırılmamış!"

msgid "Tacview installed on server {}."
msgstr "{} sunucusuna Tacview yüklendi."

msgid "Tacview could not be installed on server {}!"
msgstr "{} sunucusuna Tacview yüklenemedi!"

msgid "Server {} needs to be shut down to install Tacview."
msgstr "Tacview yüklemek için {} sunucusu kapatılmalıdır."

msgid "Uninstall Tacview"
msgstr "Tacview kaldır"

