msgstr "{} sunucusundan Tacview kaldırılıyor ..."

msgid "Tacview uninstalled on server {}."
msgstr "{} sunucusundan Tacview kaldırıldı."

msgid "Tacview could not be uninstalled on server {}!"
msgstr "{} sunucusundan Tacview kaldırılamadı!"

msgid "Server {} needs to be shut down to uninstall Tacview."
msgstr "Tacview kaldırmak için {} sunucusu kapatılmalıdır."

msgid "Tacview file for server {}"
msgstr "{} sunucusu için Tacview dosyası"

msgid "Tacview updated to version {version} on instance {instance}."
msgstr "{instance} örneğinde Tacview {version} sürümüne güncellendi."

msgid "Download a Tacview"
msgstr "Download a Tacview"

msgid "The file exceeds the maximum allowed size on Discord. Aborted."
msgstr "The file exceeds the maximum allowed size on Discord. Aborted."

msgid "Tacview recording sent in a DM"
msgstr "Tacview recording sent in a DM"

msgid "Tacview recording uploaded to channel {}"
msgstr "Tacview recording uploaded to channel {}"

msgid "Error during upload. Check the log for details."
msgstr "Error during upload. Check the log for details."

msgid "Start realtime recording"
msgstr "Start realtime recording"

msgid "Tacview recording started."
msgstr "Tacview recording started."

msgid "Stop realtime recording"
msgstr "Stop realtime recording"

msgid "Tacview recording stopped, file {} written."
msgstr "Tacview recording stopped, file {} written."
