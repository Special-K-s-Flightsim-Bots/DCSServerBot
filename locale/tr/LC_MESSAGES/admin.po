msgstr "Dosya çok büyük. Sunucunuz için daha yüksek bir Discord Takviye (Boost) seviyesi gerekiyor."

msgid "File sent to the configured channel."
msgstr "Dosya yapılandır된 kanala gönderildi."

msgid "File copied to the specified location."
msgstr "Dosya belirtilen konuma kopyalandı."

msgid "Prune unused data in the database"
msgstr "Veritabanındaki kullanılmayan eski verileri temizleyin"

msgid ":warning: Database Prune :warning:"
msgstr ":warning: Veritabanı Temizliği :warning:"

msgid "You are going to delete data from your database. Be advised.\n\nPlease select the data to be pruned:"
msgstr "Veritabanınızdan veri silmek üzeresiniz. Dikkatli olun.\n\nLütfen temizlenecek veriyi seçin:"

msgid "We are going to delete all data of user {}. Are you sure?"
msgstr "{} kullanıcısına ait tüm verileri sileceğiz. Emin misiniz?"

msgid "We are going to delete all data of server {}. Are you sure?"
msgstr "{} sunucusuna ait tüm verileri sileceğiz. Emin misiniz?"

msgid "Data of user {} deleted."
msgstr "{} kullanıcısının verileri silindi."

msgid "Data of server {} deleted."
msgstr "{} sunucusunun verileri silindi."

msgid "No players to prune."
msgstr "Temizlenecek oyuncu bulunamadı."

msgid "This will delete {} players incl. their stats from the database.\nAre you sure?"
