msgstr "ED sunucularından sürüm bilgisi alınamıyor, olası doğrulama sunucusu kesintisi!"

msgid "Your installed version {version} is the latest on branch {branch}."
msgstr "Kurulu sürümünüz ({version}), {branch} dalındaki en güncel sürümdür."

msgid "Would you like to update from version {old_version}@{old_branch} to {new_version}@{new_branch}?\nAll running DCS servers will be shut down!"
msgstr "{old_version}@{old_branch} sürümünden {new_version}@{new_branch} sürümüne güncellemek ister misiniz?\nÇalışan tüm DCS sunucuları kapatılacaktır!"

msgid "Updating DCS World to the newest version, please wait ..."
