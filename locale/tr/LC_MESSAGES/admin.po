msgstr "{name} düğümünde DCS {version}@{branch} sürümüne güncellendi."

msgid "DCS World could not be updated on node {name} due to missing disk space!"
msgstr "Yetersiz disk alanı nedeniyle {name} düğümünde DCS World güncellenemedi!"

msgid "DCS World updated to version {version}@{branch} on node {name}.\nThe updater has requested a **reboot** of the system!"
msgstr "{name} düğümünde DCS World {version}@{branch} sürümüne güncellendi.\nGüncelleyici sistemin **yeniden başlatılmasını** talep etti!"

msgid "Error while updating DCS on node {name}, code={rc}"
msgstr "{name} düğümünde DCS güncellenirken hata oluştu, kod={rc}"

msgid "The update takes longer than 10 minutes, please check back regularly, if it has finished."
msgstr "Güncelleme 10 dakikadan uzun sürüyor, tamamlanıp tamamlanmadığını lütfen düzenli olarak kontrol edin."

msgid "Can't update branch {}. You might need to provide proper DCS credentials to do so."
msgstr "{} dalı güncellenemiyor. Bunun için geçerli DCS hesap bilgileri girmeniz gerekebilir."

msgid "Install modules in your DCS server"
msgstr "DCS sunucunuza modül/harita yükleyin"

msgid "Shutdown all servers on node {} for the installation?"
