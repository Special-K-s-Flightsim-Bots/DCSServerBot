msgid "Add a server"
msgstr "Bir sunucu ekle"

#: services/webservice/pages/actions.py:1189
#: services/webservice/pages/actions.py:1209
#: services/webservice/templates/server_detail.html:600
msgid "Add to the rotation"
msgstr "Rotasyona ekle"

#: services/webservice/pages/actions.py:1193
msgid "Load it when the server next starts"
msgstr "Sunucu bir sonraki başlatıldığında yükle"

#: services/webservice/pages/actions.py:1195
msgid "Arms the rotation so this mission is the next one the server loads."
msgstr ""
"Rotasyonu bu görev sunucunun yükleyeceği bir sonraki görev olacak şekilde "
"hazırlar."

#: services/webservice/pages/actions.py:1199
msgid "Load it now"
msgstr "Şimdi yükle"

#: services/webservice/pages/actions.py:1201
msgid ""
"Loads it right away — only honoured while the server is running, paused or "
"stopped."
msgstr ""
"Hemen yükler — yalnızca sunucu çalışırken, duraklatılmışken veya "
"durdurulmuşken geçerlidir."

#: services/webservice/pages/actions.py:1206
msgid ""
"This mission is already on the server: adding it changes the ROTATION LIST "
"only. No file is copied and nothing is deleted — that is what Upload does."
msgstr ""
"Bu görev zaten sunucuda mevcut: ekleme işlemi yalnızca ROTASYON LİSTESİNİ "
"değiştirir. Hiçbir dosya kopyalanmaz ve hiçbir şey silinmez — bunu Yükle "
"(Upload) işlemi yapar."

#: services/webservice/pages/actions.py:1210
#, python-brace-format
msgid "Add the mission to {server}'s rotation list"
msgstr "Görevi {server} sunucusunun rotasyon listesine ekle"

