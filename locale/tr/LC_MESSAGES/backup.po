msgid "Backup your data"
msgstr "Verilerinizi yedekleyin"

msgid "Backup of {} started ..."
msgstr "{} yedeklemesi başlatıldı ..."

msgid "Backup of {} completed."
msgstr "{} yedeklemesi tamamlandı."

msgid "Backup of {} failed. Please check log for details."
msgstr "{} yedeklemesi başarısız oldu. Detaylar için lütfen günlüğü kontrol edin."

msgid "Restore your data from an existing backup"
msgstr "Mevcut bir yedekten verilerinizi geri yükleyin"

msgid "I am about to restore your {what} from {date}.\nThis action will completely overwrite any existing data.\nAre you absolutely certain that you want to proceed?"
msgstr "{date} tarihli {what} yedeğinizi geri yüklemek üzereyim.\nBu işlem mevcut verilerin üzerine tamamen yazacaktır.\nDevam etmek istediğinizden kesinlikle emin misiniz?"

msgid "Aborted."
msgstr "İptal edildi."

msgid "Restore of {} triggered. The node will now restart."
msgstr "{} geri yüklemesi başlatıldı. Düğüm şimdi yeniden başlatılacak."

msgid "Recovery of {} failed. Please check log for details."
msgstr "{} kurtarma işlemi başarısız oldu. Detaylar için lütfen günlüğü kontrol edin."

msgid "Restore your data from existing backups"
msgstr "Restore your data from existing backups"
