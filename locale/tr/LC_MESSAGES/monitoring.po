msgid "The FPS of server {server.name} are below {min_fps} for longer than {period} minutes!"
msgstr "{server.name} sunucusunun FPS değeri {period} dakikadan uzun süredir {min_fps} değerinin altında!"

msgid "Displays the load of your DCS servers"
msgstr "DCS sunucularınızın sistem yükünü gösterir"

msgid "Shows servers statistics"
msgstr "Sunucu performans istatistiklerini gösterir"

msgid "Server {server} FPS ({fps}) has been below {min_fps} for more than {period} minutes."
msgstr "{server} sunucusunun FPS değeri ({fps}), {period} dakikadan uzun süredir {min_fps} değerinin altında."

msgid "Server Performance Low!"
msgstr "Sunucu Performansı Düşük!"

msgid "Server {server} RAM usage is {ram} GB, exceeding the maximum of {max_ram} GB for more than {period} minutes."
msgstr "{server} sunucusunun RAM kullanımı ({ram} GB), {period} dakikadan uzun süredir maksimum sınırı ({max_ram} GB) aşıyor."

msgid "Excessive RAM consumption!"
msgstr "Aşırı RAM Tüketimi!"
