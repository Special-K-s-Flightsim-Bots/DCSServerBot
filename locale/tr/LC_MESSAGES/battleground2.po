msgid "DCSBattleground commands"
msgstr "DCSBattleground komutları"

msgid "Push MGRS coordinates with screenshots to DCS Battleground"
msgstr "Ekran görüntüleriyle birlikte MGRS koordinatlarını DCS Battleground'a gönderin"

msgid "The second parameter needs to be a MGRS coordinate (ex: 38TLN0274366889)."
msgstr "İkinci parametre bir MGRS koordinatı olmalıdır (örn: 38TLN0274366889)."

msgid "Recon data added - {side} side - {server}"
msgstr "Keşif verisi eklendi - {side} tarafı - {server}"

msgid "Coalitions have to be enabled and you need to use this command in one of your coalition channels!"
msgstr "Koalisyonlar etkinleştirilmiş olmalı ve bu komutu koalisyon kanallarınızdan birinde kullanmalısınız!"

msgid "Delete recon data on a specified server"
msgstr "Belirtilen sunucudaki keşif verilerini silin"

msgid "Recon data deleted for server {}."
msgstr "{} sunucusu için keşif verileri silindi."
