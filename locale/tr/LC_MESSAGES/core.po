msgid "Server is going down for a DCS update in {)}!"
msgstr "Sunucu {)} içinde DCS güncellemesi için kapanıyor!"

msgid "Server is going down to install a module in {}!"
msgstr "Sunucu {} içinde modül kurulumu için kapanıyor!"

msgid "Server is going down to uninstall a module in {}!"
msgstr "Sunucu {} içinde modül kaldırma işlemi için kapanıyor!"

msgid "You are banned from this server. Reason: {}"
msgstr "Bu sunucudan yasaklandınız. Sebep: {}"

msgid "The server is full, please try again later."
msgstr "Sunucu dolu, lütfen daha sonra tekrar deneyin."

msgid "Your player name contains invalid characters. Please change your name to join our server."
msgstr "Oyuncu adınız geçersiz karakterler içeriyor. Sunucumuza katılmak için lütfen adınızı değiştirin."

msgid "Please change your default player name at the top right of the multiplayer selection list to an individual one!"
msgstr "Lütfen çok oyunculu seçim listesinin sağ üst köşesindeki varsayılan oyuncu adınızı kendinize özel bir adla değiştirin!"
