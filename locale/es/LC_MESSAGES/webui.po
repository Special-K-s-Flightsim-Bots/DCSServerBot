msgstr "Configuración — abrir los ajustes propios de {server}"

#: services/webservice/pages/actions.py:1603
#, python-brace-format
msgid "Open the configuration of server {server}"
msgstr "Abrir la configuración del servidor {server}"

#: services/webservice/pages/actions.py:1736
#, python-brace-format
msgid "More controls for {server}"
msgstr "Más controles para {server}"

#: services/webservice/pages/actions.py:2057
#, python-brace-format
msgid "Controls for node {node}"
msgstr "Controles para el nodo {node}"

#: services/webservice/pages/actions.py:2259
#, python-brace-format
msgid "Controls for {player} on {server}"
msgstr "Controles para {player} en {server}"

#: services/webservice/pages/actions.py:2394
#, python-brace-format
msgid "{label} {target}?"
msgstr "{label} {target}?"

#: services/webservice/pages/actions.py:2447
#: services/webservice/pages/actions.py:2544
#: services/webservice/pages/actions.py:2699
#: services/webservice/pages/actions.py:4094
msgid "confirm"
msgstr "confirmar"

#: services/webservice/pages/actions.py:2447
#: services/webservice/pages/actions.py:2699
#: services/webservice/pages/actions.py:4094
msgid "options"
msgstr "opciones"

#: services/webservice/pages/actions.py:2526
msgid "Days (optional)"
msgstr "Días (opcional)"

#: services/webservice/pages/actions.py:2527
msgid ""
"Empty = permanent — the ban does not expire on its own. 7 means seven "
"days from now."
msgstr ""
"Vacío = permanente — el baneo no expira por sí solo. 7 significa siete "
