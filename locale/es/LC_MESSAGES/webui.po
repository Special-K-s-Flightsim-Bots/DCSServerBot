msgstr "conectando…"

#: services/webservice/i18n.py:465
msgid "polling every 10 seconds"
msgstr "consultando cada 10 segundos"

#: services/webservice/i18n.py:466
#, python-brace-format
msgid "the bot is not ready yet — retrying in {seconds}s"
msgstr "el bot aún no está listo — reintentando en {seconds} s"

#: services/webservice/i18n.py:467
msgid "not permitted — sign in again"
msgstr "no autorizado — inicia sesión de nuevo"

#: services/webservice/i18n.py:468
msgid "Sign in again"
msgstr "Iniciar sesión de nuevo"

#: services/webservice/i18n.py:470
#: services/webservice/templates/server_detail.html:62
