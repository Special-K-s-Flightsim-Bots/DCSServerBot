#: services/webservice/plugin_registry.py:71
msgid ""
"Tick the optional plugins to load. The ones marked \"default\" are part "
"of the bot's default set and load even without an entry here. The raw "
"list is still editable in Expert Mode."
msgstr ""
"Marca los plugins opcionales que quieres cargar. Los marcados como "
"\"default\" forman parte del conjunto predeterminado del bot y se cargan "
"aunque no haya una entrada aquí. La lista sin formato sigue siendo "
"editable en el modo experto."

#: services/webservice/shell.py:432
msgid "Your request could not be completed, and nothing was saved."
msgstr "Tu solicitud no se pudo completar y no se guardó nada."

#: services/webservice/shell.py:434
msgid "Your account does not have access to this page."
msgstr "Tu cuenta no tiene acceso a esta página."

#: services/webservice/shell.py:439
msgid "access denied"
msgstr "acceso denegado"

#: services/webservice/shell.py:443
msgid "Access denied"
msgstr "Acceso denegado"

#: services/webservice/shell.py:446
msgid "Return to the dashboard"
msgstr "Volver al panel"

#: services/webservice/shell.py:506
msgid ""
"You are still signed in &mdash; no new sign-in is needed. The console has"
" just started and is verifying your identity; this page will retry by "
"itself."
msgstr ""
"Sigues conectado &mdash; no hace falta iniciar sesión de nuevo. La "
"consola acaba de arrancar y está verificando tu identidad; esta página "
"volverá a intentarlo por su cuenta."

#: services/webservice/shell.py:508
msgid "Still not ready. Retry by hand when you are ready."
msgstr "Aún no está listo. Vuelve a intentarlo a mano cuando quieras."

#: services/webservice/shell.py:509
msgid "The answer changed. Reload to continue."
msgstr "La respuesta ha cambiado. Recarga para continuar."

#: services/webservice/shell.py:514
msgid "verifying your identity"
msgstr "verificando tu identidad"

#: services/webservice/shell.py:518
msgid "The console is starting up"
msgstr "La consola está arrancando"

#: services/webservice/shell.py:520
msgid "Retrying automatically&hellip;"
msgstr "Reintentando automáticamente&hellip;"

#: services/webservice/shell.py:521
msgid "Retry now"
msgstr "Reintentar ahora"

