msgstr "verificando tu identidad"

#: services/webservice/shell.py:535
msgid "The console is starting up"
msgstr "La consola está arrancando"

#: services/webservice/shell.py:537
msgid "Retrying automatically&hellip;"
msgstr "Reintentando automáticamente&hellip;"

#: services/webservice/shell.py:538
msgid "Retry now"
msgstr "Reintentar ahora"

