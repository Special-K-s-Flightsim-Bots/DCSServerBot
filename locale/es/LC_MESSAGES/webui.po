msgstr "Registro"

#: services/webservice/pages/server_detail.py:241
#: services/webservice/templates/server_detail.html:708
msgid "Events"
msgstr "Eventos"

#: services/webservice/pages/server_detail.py:276
#: services/webservice/templates/server_detail.html:747
