#, python-brace-format
msgid ""
"Node '{node}' is offline or unknown, so its log cannot be read from this "
"console."
msgstr ""
"El nodo '{node}' está desconectado o es desconocido, así que su registro "
"no puede leerse desde esta consola."

#: services/webservice/pages/server_detail.py:713
#, python-brace-format
msgid "Node '{node}' cannot read this server's log file (permission denied)."
msgstr ""
"El nodo '{node}' no puede leer el archivo de registro de este servidor "
"(permiso denegado)."

#: services/webservice/pages/server_detail.py:715
#, python-brace-format
msgid "Node '{node}' did not answer in time, so the log was not read."
msgstr "El nodo '{node}' no respondió a tiempo, así que el registro no se leyó."

#: services/webservice/pages/server_detail.py:716
#, python-brace-format
msgid "Node '{node}' could not hand over the log ({error})."
msgstr "El nodo '{node}' no pudo entregar el registro ({error})."

#: services/webservice/pages/server_detail.py:717
#, python-brace-format
msgid "Node '{node}' answered with a failure code instead of the log."
msgstr "El nodo '{node}' respondió con un código de error en lugar del registro."

#: services/webservice/pages/server_detail.py:720
#, python-brace-format
msgid ""
"No log directory yet for this server (looked for '{directory}' on node "
"'{node}')."
msgstr ""
"Aún no hay directorio de registros para este servidor (se buscó "
"'{directory}' en el nodo '{node}')."

#: services/webservice/pages/server_detail.py:722
#, python-brace-format
msgid "Node '{node}' cannot list this server's log directory (permission denied)."
msgstr ""
"El nodo '{node}' no puede listar el directorio de registros de este "
"servidor (permiso denegado)."

#: services/webservice/pages/server_detail.py:724
#, python-brace-format
msgid "Node '{node}' did not answer in time, so the log files were not listed."
msgstr ""
"El nodo '{node}' no respondió a tiempo, así que no se listaron los "
"archivos de registro."

#: services/webservice/pages/server_detail.py:726
#, python-brace-format
msgid "Node '{node}' could not list the log files ({error})."
msgstr "El nodo '{node}' no pudo listar los archivos de registro ({error})."

#: services/webservice/pages/server_detail.py:1806
#, python-format
msgid "server %(name)s"
msgstr "servidor %(name)s"

#: services/webservice/pages/server_detail.py:1913
msgid "The mission list could not be read."
msgstr "No se pudo leer la lista de misiones."

#: services/webservice/pages/servers.py:29
#: services/webservice/pages/servers.py:32
#: services/webservice/readmodels/views.py:125
#: services/webservice/readmodels/views.py:133
#: services/webservice/templates/server_detail.html:150
msgid "Servers"
msgstr "Servidores"

#: services/webservice/pages/servers.py:30
msgid ""
"Every server on every node, in full. A row you may operate carries its "
"controls on the row; acting on one affects that server alone."
msgstr ""
"Todos los servidores de todos los nodos, completos. Una fila que puedes "
"operar lleva sus controles en la fila; actuar sobre una afecta solo a ese"
" servidor."

#: services/webservice/pages/settings.py:138
#: services/webservice/templates/settings_tiles.html:48
msgid "Main"
msgstr ""

#: services/webservice/pages/settings.py:143
#: services/webservice/templates/_settings_files.html:13
msgid "Configuration files"
msgstr ""

#: services/webservice/pages/settings.py:156
msgid ""
"The bot's own configuration, generated from its schema. The form and the "
"YAML are one file: a save writes only what you changed, and a restart "
"applies it."
msgstr ""
"La propia configuración del bot, generada a partir de su esquema. El "
"formulario y el YAML son un mismo archivo: al guardar solo se escribe lo "
"que cambiaste, y un reinicio lo aplica."

#: services/webservice/pages/settings.py:177
#, python-format
msgid "Not valid YAML on line %(line)s, column %(column)s."
msgstr ""

#: services/webservice/pages/settings.py:178
#, python-format
msgid "Not valid against the schema — line %(line)s, in %(block)s."
msgstr ""

#: services/webservice/pages/settings.py:179
#, python-format
msgid "Not valid against the schema — in %(block)s."
msgstr ""

#: services/webservice/pages/settings.py:207
msgid "Saved — this configuration applies on the next bot restart."
msgstr "Guardado — esta configuración se aplica en el próximo reinicio del bot."

#: services/webservice/pages/settings.py:212
msgid "Saved — this change applies immediately."
msgstr "Guardado — este cambio se aplica de inmediato."

#: services/webservice/pages/settings.py:213
msgid "Nothing changed — the file is untouched."
msgstr "Nada cambió: el archivo queda intacto."

#: services/webservice/pages/settings.py:221
msgid ""
"No change was saved: the form carried a field this page cannot place in "
"the config, so saving it would have silently dropped it. Nothing was "
"written — reload the page and try again."
msgstr ""
"No se guardó ningún cambio: el formulario incluía un campo que esta "
"página no puede situar en la configuración, así que guardarlo lo habría "
"descartado en silencio. No se escribió nada — recarga la página e "
"inténtalo de nuevo."

#: services/webservice/pages/settings.py:226
msgid ""
"No change was saved: a new entry's key already names an existing entry, "
"so saving it would have overwritten that entry. Give the new entry a "
"different key — nothing was written."
msgstr ""
"No se guardó ningún cambio: la clave de una entrada nueva ya nombra una "
"entrada existente, así que guardarla habría sobrescrito esa entrada. Dale"
" a la entrada nueva una clave distinta — no se escribió nada."

#: services/webservice/pages/settings.py:234
msgid ""
"No change was saved: the document is empty, and an empty document is not "
"a document — saving it would replace the file with nothing. Edit the file"
" and try again; nothing was written."
msgstr ""
"No se guardó nada: el documento está vacío, y un documento vacío no es un"
" documento — guardarlo reemplazaría el archivo por nada. Edita el archivo"
" e inténtalo de nuevo; no se escribió nada."

#: services/webservice/pages/settings.py:241
msgid ""
"No change was saved: the form named a node that is not the selected one, "
"so saving it would have rewritten another node's block. Reload the page, "
"pick that node if you meant to edit it, and try again — nothing was "
"written."
msgstr ""
"No se guardó nada: el formulario nombró un nodo que no es el "
"seleccionado, por lo que guardarlo habría reescrito el bloque de otro "
"nodo. Recarga la página, elige ese nodo si querías editarlo y vuelve a "
"intentarlo — no se escribió nada."

#: services/webservice/pages/settings.py:248
msgid ""
"No change was saved: this page did not name a node this file carries, so "
"there is no part of the file to write. Reload the page and pick a node — "
"nothing was written."
msgstr ""
"No se guardó nada: esta página no nombró ningún nodo que contenga este "
"archivo, así que no hay ninguna parte del archivo que escribir. Recarga "
"la página y elige un nodo — no se escribió nada."

#: services/webservice/pages/settings.py:254
msgid ""
"This editor did not name a node this file carries, so its part of the "
"file cannot be checked. Reload the page and pick a node."
msgstr ""
"Este editor no nombró ningún nodo que contenga este archivo, por lo que "
"su parte del archivo no se puede comprobar. Recarga la página y elige un "
"nodo."

#: services/webservice/pages/settings.py:262
msgid ""
"This file does not validate against its schema. The form is still "
"generated from the schema, but the file on disk has an error — correct it"
" before saving."
msgstr ""

#: services/webservice/pages/settings.py:267
msgid ""
"No schema ships for this file, so its form cannot be generated — it is "
"shown read-only."
msgstr ""

#: services/webservice/pages/settings.py:285
msgid "instance name"
msgstr "nombre de instancia"

#: services/webservice/pages/settings.py:291
msgid ""
"Pick a node to configure. The tabs then show only its own block and its "
"instances — never every node at once."
msgstr ""
"Elige un nodo para configurar. Las pestañas muestran solo su propio "
"bloque y sus instancias — nunca todos los nodos a la vez."

#: services/webservice/pages/settings.py:296
msgid ""
"Expert Mode edits only this node's part of the file — every other node is"
" left untouched."
msgstr ""
"El modo experto edita solo la parte del archivo de este nodo — todos los "
"demás nodos quedan intactos."

#: services/webservice/pages/settings.py:299
msgid ""
"<b>DEFAULT</b> is the scope every instance starts from. A block under it "
"changes only that node or instance — and because the scope is the TAB, no"
" field carries a <code>default.</code> prefix."
msgstr ""
"<b>DEFAULT</b> es el ámbito del que parte cada instancia. Un bloque "
"debajo solo cambia ese nodo o esa instancia — y como el ámbito es la "
"pestaña, ningún campo lleva el prefijo <code>default.</code>."

#: services/webservice/pages/settings.py:302
#, python-format
msgid ""
"This block changes only <b>%(scope)s</b>. It INHERITS everything it does "
"not set from DEFAULT — nothing is copied, so a field left unset keeps "
"following the default block."
msgstr ""
"Este bloque solo cambia <b>%(scope)s</b>. HEREDA de DEFAULT todo lo que "
"no define — no se copia nada, así que un campo sin definir sigue el "
"bloque por defecto."

#: services/webservice/pages/settings.py:309
msgid ""
"This configuration has no node or instance blocks — the whole file is one"
" scope, so no field carries a <code>DEFAULT.</code> prefix."
msgstr ""
"Esta configuración no tiene bloques de nodo ni de instancia: todo el "
"archivo es un solo ámbito, así que ningún campo lleva el prefijo "
"<code>DEFAULT.</code>"

#: services/webservice/pages/settings.py:312
#, python-format
msgid "Added the block %(scope)s."
msgstr "Se añadió el bloque %(scope)s."

