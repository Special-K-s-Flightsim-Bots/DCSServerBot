#: services/webservice/pages/actions.py
msgid ""
"Node '{node}' answered with no version for branch '{branch}' — ED may be "
"unreachable, or this node has no DCS credentials."
msgstr ""
"El nodo '{node}' no dio ninguna versión para la rama '{branch}' — puede "
"que ED no esté disponible o que este nodo no tenga credenciales de DCS."

#: services/webservice/pages/actions.py
msgid "Node '{node}' could not answer with its version list ({error})."
msgstr ""
"El nodo '{node}' no pudo responder con su lista de versiones ({error})."

#: services/webservice/pages/actions.py
msgid ""
"Node '{node}' declares no DCS installation, so it has no versions to "
"offer."
msgstr ""
"El nodo '{node}' no declara ninguna instalación de DCS, así que no tiene "
"versiones que ofrecer."

#: services/webservice/pages/actions.py
msgid ""
"Node '{node}' is offline or unknown, so its versions cannot be read."
msgstr ""
"El nodo '{node}' está desconectado o no existe, así que sus versiones no "
"se pueden leer."

#: services/webservice/pages/actions.py
msgid ""
"On by default: once the update has finished the node posts the DCS "
"announcement configured in its nodes.yaml."
msgstr ""
"Activado por defecto: cuando la actualización termina, el nodo publica el "
"anuncio de DCS configurado en su nodes.yaml."

#: services/webservice/pages/actions.py
msgid "Reading the versions this node offers…"
msgstr "Leyendo las versiones que ofrece este nodo…"

#: services/webservice/pages/actions.py
msgid "Release"
msgstr "Release"

#: services/webservice/pages/actions.py
msgid "Testing"
msgstr "Testing"

#: services/webservice/pages/actions.py
msgid ""
"The branch to install. Testing and Nightly are offered only when this "
"node is configured with DCS credentials."
msgstr ""
"La rama que se va a instalar. Testing y Nightly solo se ofrecen si este "
"nodo está configurado con credenciales de DCS."

#: services/webservice/pages/actions.py
msgid "The version list could not be read."
msgstr "No se pudo leer la lista de versiones."

#: services/webservice/pages/actions.py
msgid "The version list could not be read: {reason}"
msgstr "No se pudo leer la lista de versiones: {reason}"

#: services/webservice/pages/actions.py
msgid ""
"The version to install. A version older than the installed one is a "
"rollback; the installed one on the same branch is refused."
msgstr ""
"La versión que se va a instalar. Una versión más antigua que la instalada "
"es una vuelta atrás; la instalada en la misma rama se rechaza."

#: services/webservice/pages/actions.py
msgid "Update DCS"
msgstr "Actualizar DCS"

#: services/webservice/pages/actions.py
msgid ""
"Update DCS — update, roll back or switch the branch on {node}; every "
"server on it goes down and comes back on the new version"
msgstr ""
"Actualizar DCS — actualiza, vuelve atrás o cambia la rama en {node}; "
"todos los servidores se detienen y vuelven con la nueva versión"

#: services/webservice/pages/actions.py
msgid ""
"Update {node} — every server on it goes down and comes back on the new "
"version"
msgstr ""
"Actualizar {node} — todos sus servidores se detienen y vuelven con la "
"nueva versión"

#: services/webservice/pages/actions.py
msgid "Update, roll back or switch the DCS branch on {node}"
msgstr "Actualizar, volver atrás o cambiar la rama de DCS en {node}"

#: services/webservice/pages/actions.py
msgid "Update, roll back or switch the DCS branch on {node}?"
msgstr "¿Actualizar, volver atrás o cambiar la rama de DCS en {node}?"

#: services/webservice/pages/actions.py
msgid "Version"
msgstr "Versión"

#: services/webservice/pages/actions.py
msgid "Warning time (seconds)"
msgstr "Tiempo de aviso (segundos)"

#: services/webservice/pages/actions.py
msgid ""
"update, roll back or switch branch — every server on the node goes down"
msgstr ""
"actualiza, vuelve atrás o cambia de rama — todos los servidores del nodo "
"se detienen"

#: services/webservice/pages/actions.py
msgid "{version} — installed now"
msgstr "{version} — instalada ahora"

#: services/webservice/pages/actions.py
msgid "{version} — newest on this branch"
msgstr "{version} — la más reciente de esta rama"
