# /dcs
msgid "Commands to manage your DCS installations"
msgstr "Comandos para mangejar tus instancias de DCS"

# /dcs ban
msgid "Bans a user by name or ucid"
msgstr "Banea a un usuario por nombre o UCID"

msgid "Reason"
msgstr "Razón"

msgid "Days (empty = forever)"
msgstr "Días (vacío = para siempre)"

msgid "Ban Details"
msgstr "Detalles del baneo"

msgid "Member {} is not linked!"
msgstr "El miembro {} no está vinculado!"

msgid "{} is not a valid UCID!"
msgstr "¡{} no es una UCID válida!"

msgid "Player {} banned on all servers"
msgstr "Jugador {} ha sido baneado en todos los servidores"

msgid " for {} days."
msgstr " por {} días."

# /dcs unban
msgid "Unbans a user by name or ucid"
msgstr "Unban a un usuario por nombre o UCID"

msgid "Player {} unbanned on {}."
msgstr "Jugador {} desbaneado en {}."

msgid "Player {} was not banned on {}."
msgstr "Jugador {} no estaba baneado en {}."

msgid "Shows active bans"
msgstr "Muestra los bans activos"

msgid "User with UCID {} is not banned."
msgstr "El usuario con UCID {} no está baneado."

# /dcs bans
msgid "Ban Information"
msgstr "Información de baneos"

msgid "<unknown>"
msgstr "<desconocido>"

msgid "never"
msgstr "nunca"

msgid "Banned by: {}"
msgstr "Baneado por: {}"

msgid "Exp.: {}"
msgstr "Hasta: {}"

# /dcs update
msgid "Update your DCS installations"
msgstr "Actualiza tus instancias de DCS"

msgid "Time in seconds to warn users before shutdown"
msgstr "Tiempo en segundos para avisar a los usuarios antes de apagar"

msgid "Can't get version information from ED, possible auth-server outage!"
msgstr "No se pueden obtener información de la versión desde ED, ¡Posible caída del servidor de autentificación!"

msgid "Your installed version {version} is the latest on branch {branch}."
msgstr "Tu versión instalada {version} es la más reciente de la rama {branch}."

msgid "Would you like to update from version {old_version}@{old_branch} to {new_version}@{new_branch}?\n"
"All running DCS servers will be shut down!"
msgstr "Te gustaría actualizar de la versión {old_version}@{old_branch} a la versión {new_version}@{new_branch} updaten?\n"
"¡Todos los servidores en funcionamiento se apagarán!"

msgid "Updating DCS World to the newest version, please wait ..."
msgstr "Actualizando DCS World a la última versión. Por favor, espere ..."

msgid "DCS World could not be updated on node {name} due to missing disk space!"
msgstr "¡No ha sido posible actualizar DCS World en el nodo {name} debido a falta de espacio en el disco duro!"

msgid "DCS World updated to version {version}@{branch} on node {name}.\n"
"The updater has requested a **reboot** of the system!"
msgstr "DCS World actualizado a la versión {version}@{branch} en el nodo {name}.\n"
"¡El programa de actualización ha requerido el **reinicio** del sistema!"

msgid "DCS updated to version {version}@{branch} on node {name}."
msgstr "Actualizado DCS a la versión {version}@{branch} en el nodo {name}."

msgid "Error while updating DCS on node {name}, code={rc}"
msgstr "Error durante la actualización de DCS en el nodo {name}: código={rc}"

msgid "The update takes longer than 10 minutes, please check back regularly, if it has finished."
msgstr "La actualización tardará más de 10 minutos. Por favor comprueba regularmente si ha finalizado."

msgid "Can't update branch {}. You might need to provide proper DCS credentials to do so."
msgstr "No se puede actualizar la rama {}. Quizás necesites credenciales de DCS adecuadas para hacerlo."

# /dcs install
msgid "Install modules in your DCS server"
msgstr "Instalar módulos en tu servidor de DCS"

msgid "Shutdown all servers on node {} for the installation?"
msgstr "¿Apagar todos los servidores del nodo {} para la instalación?"

msgid "Installing module {module} on node {node}, please wait ..."
msgstr "Instalando módulo {module} en el nodo {node}. Por favor, espere ..."

msgid "Module {module} installed on node {node}."
msgstr "El módulo {module} ha sido instalado en el nodo {node}."

# /dcs uninstall
msgid "Uninstall modules from your DCS server"
msgstr "Desinstala módulos de tu servidor de DCS"

msgid "Shutdown all servers on node {} for the uninstallation?"
msgstr "¿Apagar todos los servidores del nodo {} para la instalación?"

msgid "Aborted."
msgstr "Abortado."

msgid "Module {module} uninstalled on node {node}."
msgstr "El módulo {module} ha sido desinstalado del nodo {node}."

# /download
msgid "Download files from your server"
msgstr "Descarga archivos desde tu servidor"

msgid "File {file} not found in directory {dir}."
msgstr "El archivo {file} no se ha encontrado en el directorio {dir}."

msgid "File sent as a DM."
msgstr "Archivo enviado por mensaje privado."

msgid "Here is your file:"
msgstr "Aquí tiene su fichero:"

msgid "File too large. You need a higher boost level for your server."
msgstr "Fichero demasiado grande. Necesita un nivel mayor de mejora en su servidor."

msgid "File sent to the configured channel."
msgstr "Archivo enviado al canal configurado."

msgid "File copied to the specified location."
msgstr "Archivo copiado a la localización especificada."

# /prune
msgid "Prune unused data in the database"
msgstr "Limpia datos no utilizados ne la base de datos"

msgid ":warning: Database Prune :warning:"
msgstr ":warning: ¡Limpieza de base de datos! :warning:"

msgid "You are going to delete data from your database. Be advised.\n\n"
"Please select the data to be pruned:"
msgstr "Atención. Va a proceder a eliminar datos de la base de datos.\n\n"
"Por favor seleccione la base de datos para limpiar:"

msgid "We are going to delete all data of user {}. Are you sure?"
msgstr "Procederemos a eliminar todos los datos del usuario {user}. ¿Está seguro?"

msgid "We are going to delete all data of server {}. Are you sure?"
msgstr "Procederemos a eliminar todos los datos del servidor {} ¿Está seguro?"

msgid "Data of user {} deleted."
msgstr "Datos del usuario {} eliminados."

msgid "Data of server {} deleted."
msgstr "Datos del servidor {} eliminados."

msgid "No players to prune."
msgstr "No hay jugadores para limpiar."

msgid "This will delete {} players incl. their stats from the database.\n"
"Are you sure?"
msgstr "ESto eliminará {} jugadores de la base de datos incluyendo sus estadísticas.\n"
"¿Está seguro?"

msgid "This will delete all data older than {} days from the database.\n"
"Are you sure?"
msgstr "Ich lösche nun alle daten, die älter als {} Tage sind aus der Datenbank.\n"
"¿Está seguro?"

msgid "All data older than {} days pruned."
msgstr "Todos los datos más antiguos de {} días serán eliminados."

# /node
msgid "Commands to manage your nodes"
msgstr "Comandos para manejar sus nodos"

# /node statistics
msgid "Statistics of your nodes"
msgstr "Estadísticas por nodo"

# /node list
msgid "Status of all nodes"
msgstr "Estado de todos los nodos"

