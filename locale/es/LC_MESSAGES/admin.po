# /node upgrade / restart
msgid "Do you want to {} all nodes?"
msgstr "¿Desea {} todos los nodos?"

msgid "Do you want to {method} node {node}?"
msgstr "¿Desea {method} el nodo {node}?"

msgid "upgrade"
msgstr "actualizar"

msgid "shutdown"
msgstr "apagar"

msgid "restart"
msgstr "reiniciar"

msgid "Node {node} - {method} sent."
msgstr "Nodo {node} - {method} enviado."

msgid "All nodes are"
msgstr "Todos los nodos están"

msgid "Master is"
msgstr "Master se"

msgid " going to {} **NOW**."
msgstr " va a {} **AHORA**."

# /node shutdown
msgid "Shuts a specific node down"
msgstr "Apaga un nodo específico"

# /node restart
msgid "Restarts a specific node"
msgstr "Reinicia un nodo específico"

# /node offline
msgid "Shuts down all servers, enables maintenance"
msgstr "Apaga todos los servidores, habilita el modo mantenimiento"

msgid "Node {} is now offline."
msgstr "Nodo {} está ahora fuera de línea."

# /node online
msgid "Clears the maintenance mode for all servers"
msgstr "Desactiva el modo mantenimiento para todos los servidores"

msgid "Node {} is now online."
msgstr "Nodo {} está ahora en línea."

# /node upgrade
msgid "Upgrade DCSServerBot"
msgstr "Actualizar DCSServerBot"

msgid "There is no upgrade available for "
msgstr "No hay actualización disponible para "

msgid "your cluster"
msgstr "tu clúster"

msgid "node {}"
msgstr "nodo {}"

msgid "You are trying to upgrade an agent node in a cluster. Are you really sure?"
msgstr "Está intentando actualizar un agente nodo en un clúster. ¿Está realmente seguro?"

# /node shell
msgid "Run a shell command on a node"
msgstr "Ejecuta un comando de shell en el nodo"

msgid "```Command executed.```"
msgstr "```Comando ejecutado.```"

# /reload
msgid "Reloads a plugin"
msgstr "Carga de nuevo un plugin"

msgid "Plugin {} reloaded."
msgstr "Plugin {} cargado de nuevo."

msgid "Plugin {} could not be reloaded, check the log for details."
msgstr "Plugin {} no pudo ser cargado de nuevo, compruebe el fichero log para más detalles."

msgid "All plugins reloaded."
msgstr "Todos los plugins han sido cargados de nuevo."

msgid "One or more plugins could not be reloaded, check the log for details."
msgstr "Uno o más plugins no han podido ser cargados de nuevo, por favor compruebe el fichero log para más detalles."

# /node add_instance
msgid "Add/create an instance\n"
msgstr "Añade o crea una instancia\n"

msgid "Either select an existing instance or enter the name of a new one"
msgstr "Selecciones el nombre de una instancia existente o una nueva"

msgid "Take this instance configuration as a reference"
msgstr "Utilice la configuración de ésta instancia como referencia"

msgid "Instance \"{}\" created.\nDo you want to configure a server for this instance?"
msgstr "Instancia \"{}\" creada.\n¿Desea configurar el servidor para esta instancia?"

msgid "Server {server} assigned to instance {instance}."
msgstr "Server {server} asignado a la instancia {instance}."

msgid "Instance {} created blank with no server assigned."
msgstr "Instancia {} creada en blanco sin servidor asignado."

msgid "Instance {instance} added to node {node}."
"Please make sure you forward the following ports:"
"```"
"- DCS Port:    {dcs_port} (TCP/UDP)"
"- WebGUI Port: {webgui_port} (TCP)"
"```"
msgstr "Instancia {instance} añadidoa al nodo {node}."
"Por favor, asegúrese de abrir los siguientes puertos:"
"```"
"- Puerto DCS:    {dcs_port} (TCP/UDP)"
"- Puerto WebGUI: {webgui_port} (TCP)"
"```"

msgid "Instance {instance} could not be added to node {node}, see log."
msgstr "Instancia {instance} no pudo ser añadida al nodo {node}, por favor compruebe el log."

# /node delete_instance
msgid "Delete an instance\n"
msgstr "Eliminar una instancia\n"

msgid "The instance is in use by server \"{}\".\n"
"Do you really want to delete it?"
msgstr "La instancia está en uso por el servidor \"{}\".\n"
"¿Desea eliminarla?"

msgid "Do you really want to delete instance {}?"
msgstr "¿Seguro que desea eliminar la instancia {}?"

msgid "Do you want to remove the directory\n{}?"
msgstr "Desea eliminar el directorio\n{}?"

msgid "Instance {instance} removed from node {node}."
msgstr "Instance {instance} eliminada del nodo {node}."

msgid "Instance {} could not be deleted, because the directory is in use."
msgstr "La instancia {} no pudo ser eliminada. El directorio se encuentra en uso."

# /node rename_instance
msgid "Rename an instance\n"
msgstr "Cambie el nombre de una instancia um\n"

msgid "Server {} has to be shut down before renaming the instance!"
msgstr "Servidor {} ha sido apagado antes de renombrar la instancia!"

msgid "Do you really want to rename instance {}?"
msgstr "¿Realmente desea renombrar la instancia {}?"

msgid "Instance {old_name} renamed to {new_name}."
msgstr "Intancia {old_name} renombrada a {new_name}."

msgid "Instance {} could not be renamed, because the directory is in use."
msgstr "LA instancia {} no pudo ser renombrada. El directorio se encuentra en uso."

# Config upload
msgid "To which server do you want to upload this configuration to?"
msgstr "¿A qué servidor desea cargar ésta configuración?"

msgid "Error while uploading file to node {}!"
msgstr "Error al cargar el archivo al nodo {}!"

msgid "Error while reading file from discord."
msgstr "Error al leer el archivo desde Discord."

msgid "Plugin {} re-loaded."
msgstr "Plugin {} cargado de nuevo."

