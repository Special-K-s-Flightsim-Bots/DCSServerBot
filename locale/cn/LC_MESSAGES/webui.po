msgstr "接下来："

#: services/webservice/templates/scheduler_body.html:137
msgid "At most"
msgstr "最多"

#: services/webservice/templates/scheduler_body.html:143
msgid "What"
msgstr "动作"

#: services/webservice/templates/scheduler_body.html:300
msgid "Act even with players on"
msgstr "即使有玩家在线也执行"

#: services/webservice/templates/scheduler_body.html:301
msgid "Only when nobody is flying"
msgstr "仅在无人飞行时"

#: services/webservice/templates/scheduler_body.html:152
msgid "Only when the mission ends"
msgstr "仅在任务结束时"

#: services/webservice/templates/scheduler_body.html:153
msgid "Only when a coalition wins"
msgstr "仅在某一方获胜时"

#: services/webservice/templates/scheduler_body.html:155
msgid "Apply the extensions first"
msgstr "先应用扩展"

#: services/webservice/templates/scheduler_body.html:156
