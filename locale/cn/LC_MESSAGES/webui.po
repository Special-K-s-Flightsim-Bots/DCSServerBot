msgid ""
"Only the entries marked written reached the disk. The setup is not "
"finished — fix the reason below and write again."
msgstr "只有标记为已写入的条目真正写到了磁盘。设置尚未完成——请解决下面的原因后再次写入。"

#: services/webservice/setup/tour.py:1008
msgid "the file was not written"
msgstr "该文件未写入"

#: services/webservice/setup/tour.py:1009
msgid "the bot's database and its own user were created (step 3)"
msgstr "机器人的数据库及其专属用户已创建（第 3 步）"

#: services/webservice/setup/tour.py:1010
msgid "the bot's database and its user were verified (step 3)"
msgstr "机器人的数据库及其用户已验证（第 3 步）"

#: services/webservice/setup/tour.py:1011
msgid "the PostgreSQL master password is stored in config/.secret/"
msgstr "PostgreSQL 主密码已保存在 config/.secret/"

#: services/webservice/setup/tour.py:1012
msgid "the bot's database password is stored in config/.secret/"
msgstr "机器人的数据库密码已保存在 config/.secret/"

#: services/webservice/setup/tour.py:1014
msgid "the Discord answers (guild, owner, roles) — Discord support is off"
msgstr "Discord 的回答（服务器、所有者、角色）——Discord 支持已关闭"

#: services/webservice/setup/tour.py:1016
msgid "the community answers (group name, users) — Discord support is on"
msgstr "社区的回答（群组名称、用户）——Discord 支持已开启"

#: services/webservice/setup/tour.py:1017
msgid "Missing — enter again"
msgstr "缺失——请重新输入"

#: services/webservice/setup/tour.py:1019
msgid ""
"A restart dropped a secret this configuration needs, and nothing was "
"written. Go back to the step named below, enter the value again, then "
"write."
msgstr "重启丢失了此配置所需的密钥，且没有写入任何内容。请返回下面指出的步骤，重新输入该值，然后再写入。"

#: services/webservice/setup/tour.py:1021
msgid "the Discord bot token is not held — enter it again on step 5"
msgstr "Discord 机器人令牌不存在——请在第 5 步重新输入"

#: services/webservice/setup/tour.py:1022
msgid "the database password is not held — enter it again on step 3"
msgstr "数据库密码未保留——请在步骤 3 重新输入"

#: services/webservice/setup/tour.py:1024
msgid "the cluster database's password is not held — enter it again on step 3"
msgstr "集群数据库密码未保留——请在步骤 3 重新输入"

#: services/webservice/setup/tour.py:1025
msgid "guild, language, autoupdate, the cluster database"
msgstr "服务器、语言、自动更新、集群数据库"

#: services/webservice/setup/tour.py:1027
msgid ""
"guild, language, autoupdate, the cluster database — NOT a federation "
"(same database name)"
msgstr "服务器、语言、自动更新、集群数据库——不是联邦（数据库名称相同）"

#: services/webservice/setup/tour.py:1029
msgid ""
"the cluster database (config/.secret/clusterdb.pkl and main.yaml) — "
"Federation support is off"
msgstr "集群数据库（config/.secret/clusterdb.pkl 和 main.yaml）——联邦支持已关闭"

#: services/webservice/setup/tour.py:1031
msgid ""
"the cluster database (config/.secret/clusterdb.pkl and main.yaml) — the "
"cluster database was not verified, so it is not written"
msgstr "集群数据库（config/.secret/clusterdb.pkl 和 main.yaml）——集群数据库未经验证，因此不会写入"

#: services/webservice/setup/tour.py:1034
msgid "the console's Discord login — no client secret is held, so it stays off"
msgstr "控制台的 Discord 登录 —— 未保存客户端密钥，因此将保持关闭"

#: services/webservice/setup/tour.py:1038
msgid "guild, language, autoupdate"
msgstr "服务器、语言、自动更新"

#: services/webservice/setup/tour.py:1039
msgid "roles, channels, owner"
msgstr "角色、频道、所有者"

#: services/webservice/setup/tour.py:1040
msgid "the console and its sign-in"
msgstr "控制台及其登录"

#: services/webservice/setup/tour.py:1041
msgid "this node, DCS"
msgstr "此节点, DCS"

#: services/webservice/setup/tour.py:1042
msgid "status/chat/admin channels"
msgstr "状态/聊天/管理频道"

#: services/webservice/setup/tour.py:1043
msgid "autostart per server"
msgstr "每个服务器的自启动"

#: services/webservice/setup/tour.py:1044
msgid "DGSA banlist opt-ins"
msgstr "DGSA 封禁列表选项"

#: services/webservice/setup/tour.py:1045
msgid "the Discord bot token"
