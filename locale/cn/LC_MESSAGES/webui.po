msgstr ""

#: services/webservice/pages/actions.py:1471
msgid "Popup — a private message in game"
msgstr "弹窗 — 游戏内的一条私密消息"

#: services/webservice/pages/actions.py:1472
#, python-brace-format
msgid "Send a popup to {player} on {server}"
msgstr "向 {server} 上的 {player} 发送一条弹窗"

#: services/webservice/pages/actions.py:1473
msgid "a private message only they see"
msgstr ""

#: services/webservice/pages/actions.py:1474
#, python-brace-format
msgid ""
"<b>Only {player} sees this message.</b> It arrives in a box of its own "
"and closes by itself after the server's configured message timeout."
msgstr ""

#: services/webservice/pages/actions.py:1477
#, python-brace-format
msgid ""
"The popup is addressed to {player} alone. It arrives in a box of its own,"
