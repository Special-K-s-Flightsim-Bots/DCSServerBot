msgstr "向导"

#: services/webservice/templates/scheduler_body.html:64
msgid "Editing"
msgstr "正在编辑"

#: services/webservice/templates/scheduler_body.html:64
msgid "its own block only — a value you leave alone stays inherited"
msgstr "仅其自身块——未改动的值保持继承"

#: services/webservice/templates/scheduler_body.html:66
