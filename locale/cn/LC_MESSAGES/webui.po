#: services/webservice/readmodels/serverconfig.py:102
msgid "Anti-cheat"
msgstr "反作弊"

#: services/webservice/readmodels/serverconfig.py:103
#: services/webservice/templates/server_detail.html:313
msgid "Discord channels"
msgstr "Discord 频道"

#: services/webservice/readmodels/serverconfig.py:104
msgid "Mission list — owned by a feature of its own"
msgstr "任务列表 — 由专属功能拥有"

#: services/webservice/readmodels/serverconfig.py:105
#: services/webservice/templates/server_detail.html:366
msgid "Coalition passwords"
msgstr "阵营密码"

#: services/webservice/readmodels/serverconfig.py:141
msgid ""
"A channel change is applied immediately: the bot rewrites servers.yaml "
"and starts using the new channel at once, with no restart."
msgstr "频道更改会立即生效：机器人会改写 servers.yaml 并立刻开始使用新频道，无需重启。"

#: services/webservice/readmodels/serverconfig.py:221
msgid ""
"Renamed by the bot, not by the file: a rename moves the server (its "
"instance folder and its servers.yaml entry) and rewrites the channel "
"names and messages that carry the old name."
msgstr "由机器人而非文件来重命名：重命名会移动服务器（其实例文件夹及其 servers.yaml 条目），并改写带有旧名称的频道名称和消息。"

#: services/webservice/readmodels/serverconfig.py:224
msgid "Description"
msgstr "描述"

#: services/webservice/readmodels/serverconfig.py:225
msgid ""
"A brief description, shown in /status and in the server list. The Discord"
" editor allows up to 2000 characters."
msgstr "一段简短描述，显示在 /status 和服务器列表中。Discord 编辑器最多允许 2000 个字符。"

#: services/webservice/readmodels/serverconfig.py:227
msgid "Server port"
msgstr "服务器端口"

#: services/webservice/readmodels/serverconfig.py:228
msgid ""
"The UDP port DCS listens on. The Discord editor takes a 5-digit value "
"here. A port another server on this node already uses is refused, naming "
"it."
msgstr "DCS 监听的 UDP 端口。Discord 编辑器在此处接受 5 位数值。若该端口已被此节点上的另一台服务器使用，则会被拒绝，并指出该服务器。"

#: services/webservice/readmodels/serverconfig.py:231
#: services/webservice/templates/login.html:131
#: services/webservice/templates/overview.html:51
#: services/webservice/templates/server_detail.html:730
msgid "Password"
msgstr "密码"

#: services/webservice/readmodels/serverconfig.py:232
msgid ""
"The DCS password a client needs to join. The field shows the stored "
"password: leave it as it is to keep it, empty it to remove it, type in it"
" to set a new one."
msgstr "客户端加入所需的 DCS 密码。该字段显示已存储的密码：保持不变即可保留，清空即可移除，输入即可设置新密码。"

#: services/webservice/readmodels/serverconfig.py:235
msgid "Maximum number of players"
msgstr "最大玩家数"

#: services/webservice/readmodels/serverconfig.py:236
msgid ""
"The slot count DCS advertises. The Discord editor takes up to three "
"digits here, which is where the 999 ceiling comes from."
msgstr "DCS 公布的席位数。Discord 编辑器在此处最多接受三位数字，这就是 999 上限的由来。"

#: services/webservice/readmodels/serverconfig.py:238
msgid "Public server"
msgstr "公开服务器"

#: services/webservice/readmodels/serverconfig.py:239
msgid "Lists the server in the public DCS server browser."
msgstr "将服务器列入公开的 DCS 服务器浏览器。"

#: services/webservice/readmodels/serverconfig.py:240
msgid "Resume mode"
msgstr "恢复模式"

#: services/webservice/readmodels/serverconfig.py:241
msgid "What DCS does when the last client leaves and when a mission loads."
msgstr "当最后一个客户端离开以及载入任务时，DCS 的行为。"

#: services/webservice/readmodels/serverconfig.py:243
msgid "Maximum allowed ping"
msgstr "允许的最大延迟"

#: services/webservice/readmodels/serverconfig.py:244
msgid ""
"Values above 300 tend to cause lags / desyncs (the editor's own words). 0"
" turns the check off."
msgstr "高于 300 的数值往往会导致卡顿/失步（编辑器自己的说法）。0 表示关闭该检查。"

#: services/webservice/readmodels/serverconfig.py:246
msgid "Server can screenshot"
msgstr "服务器可以截图"

#: services/webservice/readmodels/serverconfig.py:247
msgid ""
"Lets the server take screenshots (used by plugins that ask a client for a"
" picture)."
msgstr "允许服务器截图（供那些向客户端索取图片的插件使用）。"

#: services/webservice/readmodels/serverconfig.py:249
msgid "Allow trial-only clients"
msgstr "允许仅有试用版的客户端"

#: services/webservice/readmodels/serverconfig.py:250
msgid "Clients that own no module may still join."
msgstr "不拥有任何模组的客户端仍可加入。"

#: services/webservice/readmodels/serverconfig.py:251
msgid "Require pure clients"
msgstr "要求纯净客户端"

#: services/webservice/readmodels/serverconfig.py:252
msgid "A client with any modification is refused at join."
msgstr "加入时拒绝任何经过修改的客户端。"

#: services/webservice/readmodels/serverconfig.py:253
msgid "Require pure scripts"
msgstr "要求纯净脚本"

#: services/webservice/readmodels/serverconfig.py:254
msgid "Modified mission scripts are refused."
msgstr "拒绝经过修改的任务脚本。"

#: services/webservice/readmodels/serverconfig.py:255
msgid "Require pure models"
msgstr "要求纯净模型"

#: services/webservice/readmodels/serverconfig.py:256
msgid "Modified 3D models are refused."
msgstr "拒绝经过修改的 3D 模型。"

#: services/webservice/readmodels/serverconfig.py:257
msgid "Require pure textures"
msgstr "要求纯净贴图"

#: services/webservice/readmodels/serverconfig.py:258
msgid "Modified textures are refused."
msgstr "拒绝经过修改的贴图。"

#: services/webservice/readmodels/serverconfig.py:259
msgid "Allow change tail number"
msgstr "允许更改机身编号"

#: services/webservice/readmodels/serverconfig.py:260
msgid "Players may repaint their tail number in the cockpit."
msgstr "玩家可以在座舱内重新涂装他们的机身编号。"

#: services/webservice/readmodels/serverconfig.py:261
msgid "Allow dynamic radio"
msgstr "允许动态无线电"

#: services/webservice/readmodels/serverconfig.py:262
msgid "Players may tune any radio channel, not only the mission's presets."
msgstr "玩家可以调到任意无线电频道，而不仅是任务的预设频道。"

#: services/webservice/readmodels/serverconfig.py:264
msgid "Allow change skin"
msgstr "允许更改涂装"

#: services/webservice/readmodels/serverconfig.py:265
msgid "Players may pick another livery for their aircraft."
msgstr "玩家可以为自己的飞机挑选另一套涂装。"

#: services/webservice/readmodels/serverconfig.py:266
msgid "Allow object export"
msgstr "允许对象导出"

#: services/webservice/readmodels/serverconfig.py:267
msgid "DCS's export switch for third-party tooling that reads the mission state."
msgstr "DCS 的导出开关，供读取任务状态的第三方工具使用。"

#: services/webservice/readmodels/serverconfig.py:269
msgid "Allow sensor export"
msgstr "允许传感器导出"

#: services/webservice/readmodels/serverconfig.py:270
msgid "DCS's export switch for sensor data."
msgstr "DCS 的传感器数据导出开关。"

#: services/webservice/readmodels/serverconfig.py:271
msgid "Allow ownship export"
msgstr "允许本机导出"

#: services/webservice/readmodels/serverconfig.py:272
msgid "DCS's export switch for the player's own aircraft."
msgstr "DCS 的玩家本机导出开关。"

#: services/webservice/readmodels/serverconfig.py:273
msgid "Allow players pool"
msgstr "允许玩家池"

#: services/webservice/readmodels/serverconfig.py:274
msgid "Players nobody slots are held in a pool instead of leaving."
msgstr "没有分配到席位的玩家会被保留在池中，而不是离开。"

#: services/webservice/readmodels/serverconfig.py:275
msgid "Disable all events"
msgstr "禁用所有事件"

#: services/webservice/readmodels/serverconfig.py:276
msgid ""
"Turns DCS's own mission events off. The bot's event-driven plugins see "
"nothing while it is on."
msgstr "关闭 DCS 自身的任务事件。启用期间，机器人的事件驱动插件什么也看不到。"

#: services/webservice/readmodels/serverconfig.py:290
msgid ""
"The missions DCS cycles through, in order. Managed by the mission "
"autoscan and validated at boot — a bad path is a boot failure — so this "
"tab does not edit it."
msgstr "DCS 按顺序轮换的任务列表。由任务自动扫描管理，并在启动时校验——路径错误会导致启动失败——因此此标签页不编辑它。"

#: services/webservice/readmodels/serverconfig.py:319
msgid "Blue coalition password"
msgstr "蓝方阵营密码"

#: services/webservice/readmodels/serverconfig.py:320
msgid ""
"The password a client picks to join the blue side. The bot stores it and "
"asks DCS to apply it."
msgstr "客户端加入蓝方时选择的密码。机器人会存储它并要求 DCS 应用它。"

#: services/webservice/readmodels/serverconfig.py:321
msgid "Red coalition password"
msgstr "红方阵营密码"

#: services/webservice/readmodels/serverconfig.py:322
msgid ""
"The password a client picks to join the red side. The bot stores it and "
"asks DCS to apply it."
msgstr "客户端加入红方时选择的密码。机器人会存储它并要求 DCS 应用它。"

#: services/webservice/readmodels/serverconfig.py:340
msgid ""
"A coalition password can be changed while the server is running, paused "
"or stopped: the bot sends it to DCS and keeps the cleartext in its "
"database."
msgstr "服务器运行、暂停或停止时都可以更改阵营密码：bot 会将其发送给 DCS，并把明文保存在自己的数据库中。"

#: services/webservice/readmodels/serverconfig.py:345
msgid ""
"A password is set outside DCSServerBot — the bot knows only its hash. "
"Type a new one to replace it."
msgstr "密码是在 DCSServerBot 之外设置的 — 机器人只知道它的哈希值。输入新密码即可替换它。"

#: services/webservice/readmodels/serverconfig.py:350
msgid ""
"The bot knows this password but DCS currently carries no hash for it — "
"saving here sets it in DCS too."
msgstr "机器人知道此密码，但 DCS 目前没有它的哈希值 — 在此处保存也会在 DCS 中设置它。"

#: services/webservice/readmodels/serverconfig.py:355
msgid ""
"The coalition passwords can only be changed while the server is shutdown,"
" stopped, running or paused. Wait for it to settle, then edit here."
msgstr "只有当服务器已关闭、已停止、正在运行或已暂停时才能更改阵营密码。等它稳定后再在这里编辑。"

#: services/webservice/readmodels/serverconfig.py:373
msgid ""
"The server must be stopped to change its configuration. Stop it on the "
"Servers page, then edit here."
msgstr "必须停止服务器才能更改其配置。请在 Servers 页面上停止它，然后在这里编辑。"

#: services/webservice/readmodels/serverconfig.py:797
msgid "Admin channel"
msgstr "管理频道"

#: services/webservice/readmodels/serverconfig.py:798
msgid "The channel where admin commands for this server are accepted."
msgstr "接受此服务器管理命令的频道。"

#: services/webservice/readmodels/serverconfig.py:799
msgid "Status channel"
msgstr "状态频道"

#: services/webservice/readmodels/serverconfig.py:800
msgid "Where the bot posts joins, leaves and mission changes."
msgstr "机器人发布加入、离开和任务变更的地方。"

#: services/webservice/readmodels/serverconfig.py:801
msgid "Chat channel"
msgstr "聊天频道"

#: services/webservice/readmodels/serverconfig.py:801
msgid "Relays in-game chat. Not set means the bot relays nowhere."
msgstr "转发游戏内聊天。未设置表示机器人不转发到任何地方。"

