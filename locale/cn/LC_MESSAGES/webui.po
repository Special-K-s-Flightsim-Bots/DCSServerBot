msgstr "步骤"

#: services/webservice/templates/scheduler_body.html:48
msgid "of"
msgstr "共"

#: services/webservice/templates/scheduler_body.html:49
msgid "When should the server run?"
msgstr "服务器应该在什么时候运行？"

#: services/webservice/templates/scheduler_body.html:51
