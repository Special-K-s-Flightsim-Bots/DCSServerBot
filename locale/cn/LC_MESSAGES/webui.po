#: services/webservice/pages/presets.py:1155
msgid "Weather preset"
msgstr "天气预设"

#: services/webservice/pages/actions.py:719
msgid ""
"Applied to the mission when this server starts up. It replaces the "
"instance's configured weather for this launch."
msgstr "服务器启动时应用到任务。本次启动会替换实例中配置的天气。"

#: services/webservice/pages/actions.py:722
msgid "Leave the weather alone"
msgstr "保持天气不变"

#: services/webservice/pages/actions.py:725
msgid ""
"This server's presets could not be listed. Type a preset name, or leave "
"it empty to leave the weather alone."
msgstr "无法列出此服务器的预设。请输入预设名称，或留空以保持天气不变。"

#: services/webservice/pages/actions.py:744
msgid "Create your own weather"
msgstr "创建你自己的天气"

#: services/webservice/pages/actions.py:747
msgid "Type a preset name"
msgstr "输入预设名称"

#: services/webservice/pages/actions.py:755
msgid "Loading current mission …"
msgstr "正在加载当前任务 …"

#: services/webservice/pages/actions.py:757
#, python-brace-format
msgid "Read from {mission}"
msgstr "读取自 {mission}"

#: services/webservice/pages/actions.py:760
msgid "The mission's weather could not be read."
msgstr "无法读取任务的气象数据。"

#: services/webservice/pages/actions.py:764
msgid ""
"This server has no current mission, so there is nothing to apply a "
"weather preset to."
msgstr "此服务器没有当前任务，因此没有可应用气象预设的对象。"

#: services/webservice/pages/actions.py:777
msgid "Or create a temporary preset"
msgstr "或临时创建预设"

#: services/webservice/pages/actions.py:782
msgid ""
"Applied to this launch only. Nothing is saved to the preset files: a "
"field left empty leaves the mission's own value alone."
msgstr "仅应用于本次启动。不会向预设文件写入任何内容：留空的字段会保留任务自身的值。"

#: services/webservice/pages/actions.py:784
msgid ""
"A preset above and these fields are two ways to make the same choice — "
"pick one, not both."
msgstr "上方的预设与这里的字段是同一个选择的两种方式——二选一，不要同时使用。"

#: services/webservice/pages/actions.py:789
msgid ""
"Not done (a preset was picked and the temporary weather fields were "
"filled — pick one, not both)."
msgstr "未执行（既选择了预设又填写了临时天气字段——二选一，不要同时使用）。"

#: services/webservice/pages/actions.py:800
msgid ""
"Not done (a weather preset was picked and the extensions are off, so "
"nothing would apply it — tick \"Run extensions on the mission\", or clear"
" the weather pick)."
msgstr "未执行（已选择天气预设但扩展已关闭，因此不会有任何东西应用它——请勾选「对任务运行扩展」，或清除天气选择）。"

#: services/webservice/pages/actions.py:807
msgid "Tell the players the weather changed"
msgstr "告知玩家天气已变化"

#: services/webservice/pages/actions.py:808
msgid ""
"Announces the new weather in-game, but only when a preset was really "
"applied. Off by default."
msgstr "在游戏内公告新天气，但仅在确实应用了预设时。默认关闭。"

#: services/webservice/pages/actions.py:838
msgid "Run extensions on the mission"
msgstr "对任务运行扩展"

#: services/webservice/pages/actions.py:840
msgid ""
"On by default, as in /server startup: the server's extensions are applied"
" to the mission before it loads. Untick to launch the mission exactly as "
"its file stands."
msgstr "默认启用，与 /server startup 一致：服务器的扩展会在任务加载前应用到任务上。取消勾选则按文件原样启动任务。"

#: services/webservice/pages/actions.py:860
msgid "Startup"
msgstr "启动"

#: services/webservice/pages/actions.py:864
msgid "End maintenance so the server is scheduled again"
msgstr "结束维护，使服务器重新纳入调度"

#: services/webservice/pages/actions.py:866
msgid ""
"On by default, exactly like Discord's /server startup. An unflagged "
"server simply stays unflagged."
msgstr "默认开启，与 Discord 的 /server startup 完全一致。未被标记的服务器就保持未标记。"

#: services/webservice/pages/actions.py:872
msgid "Apply them to the original mission file"
msgstr "应用到原始任务文件"

#: services/webservice/pages/actions.py:874
msgid ""
"Only matters while extensions run: on (the default) they are applied to "
"the uploaded file, off to the file the server is on now."
msgstr "仅在运行扩展时有效：启用（默认）时应用到上传的文件，禁用时应用到服务器当前所在的文件。"

#: services/webservice/pages/actions.py:892
msgid "Startup — bring this server up from SHUTDOWN"
msgstr "启动 — 让此服务器从“已关闭”状态启动"

#: services/webservice/pages/actions.py:893
#, python-brace-format
msgid "Startup server {server}"
msgstr "启动服务器 {server}"

#: services/webservice/pages/actions.py:894
msgid ""
"It comes back up and rejoins the rotation: with the first box ticked (the"
" default) any maintenance is ended, so the scheduler may start it again. "
"A server that was not in maintenance simply stays that way. The other two"
" are /server startup's own choices — whether the extensions are applied "
"to the mission, and whether they are applied to the uploaded file or to "
"the one the server is on. This is the DCS-level bring-up, not the "
"process-level Start in the row's menu."
msgstr ""
"它会重新启动并加入轮换：勾选第一个复选框（默认）会结束任何维护，从而让调度器可以再次启动它。本来就不在维护中的服务器则保持不变。另外两个是 "
"/server startup 自己的选项 — 是否把扩展应用到任务上，以及应用到上传的文件还是服务器当前所在的文件。这是 DCS "
"层面的启动，而不是该行菜单里进程层面的“开始”。"

#: services/webservice/pages/actions.py:901
msgid "Start up server"
msgstr "启动服务器"

#: services/webservice/pages/actions.py:902
#, python-brace-format
msgid "Start up {server} — ends maintenance so the scheduler may start it"
msgstr "启动 {server} — 结束维护，让调度器可以启动它"

#: services/webservice/pages/actions.py:904
msgid "Start"
msgstr "开始"

#: services/webservice/pages/actions.py:907
msgid "Start — start a STOPPED server"
msgstr "开始 — 让一台“已停止”的服务器运行"

#: services/webservice/pages/actions.py:908
#, python-brace-format
msgid "Start server {server}"
msgstr "让服务器 {server} 运行"

#: services/webservice/pages/actions.py:909
msgid "start a STOPPED server — Startup is the usual one"
msgstr "让一台“已停止”的服务器运行 — 通常用的是“启动”"

#: services/webservice/pages/actions.py:911
msgid "Pause"
msgstr "暂停"

#: services/webservice/pages/actions.py:913
msgid "Pause — freeze the mission; players stay connected"
msgstr "暂停 — 冻结任务；玩家保持连接"

#: services/webservice/pages/actions.py:914
#, python-brace-format
msgid "Pause the mission on {server}"
msgstr "暂停 {server} 上的任务"

#: services/webservice/pages/actions.py:916
msgid "Unpause"
msgstr "继续"

#: services/webservice/pages/actions.py:918
msgid "Unpause — resume the frozen mission"
msgstr "继续 — 恢复已冻结的任务"

#: services/webservice/pages/actions.py:919
#, python-brace-format
msgid "Unpause the mission on {server}"
msgstr "继续 {server} 上的任务"

#: services/webservice/pages/actions.py:921
#: services/webservice/pages/actions.py:1775
#: services/webservice/templates/overview.html:59
#: services/webservice/templates/server_detail.html:748
msgid "Restart"
msgstr "重启"

#: services/webservice/pages/actions.py:925
msgid "Restart — players currently flying lose their sortie"
msgstr "重启 — 正在飞行的玩家会失去本轮出击"

#: services/webservice/pages/actions.py:926
#, python-brace-format
msgid "Restart server {server}"
msgstr "重启服务器 {server}"

#: services/webservice/pages/actions.py:927
msgid ""
"<b>Players currently flying lose their sortie.</b> The mission restarts "
"from the beginning — mid-mission progress is gone."
msgstr "<b>正在飞行的玩家会失去本轮出击。</b>任务将从头重新开始 — 任务进行中的进度会丢失。"

#: services/webservice/pages/actions.py:929
msgid ""
"A restart stops the mission, reloads it from the start and the players "
"reconnect to a fresh round. It cannot be undone from here."
msgstr "重启会停止任务，从头重新载入，玩家将重新连接到新的一轮。此操作无法在此撤销。"

#: services/webservice/pages/actions.py:931
msgid "Restart server"
msgstr "重启服务器"

#: services/webservice/pages/actions.py:932
#, python-brace-format
msgid "Restart {server} — players flying lose their sortie"
msgstr "重启 {server} — 飞行中的玩家会失去本轮出击"

#: services/webservice/pages/actions.py:934
msgid "Shutdown"
msgstr "关机"

#: services/webservice/pages/actions.py:940
msgid "Set maintenance so the scheduler does not restart it"
msgstr "设为维护状态，以免调度器重启它"

#: services/webservice/pages/actions.py:942
msgid ""
"On by default, exactly like Discord's /server shutdown: without it a "
"scheduled start brings the server straight back."
msgstr "默认开启，与 Discord 的 /server shutdown 完全一致：若不勾选，计划启动会立刻把服务器重新拉起。"

#: services/webservice/pages/actions.py:944
msgid "Shutdown — stop the DCS server; everyone on it is disconnected"
msgstr "关机 — 停止 DCS 服务器；上面的所有人都会被断开连接"

#: services/webservice/pages/actions.py:945
#, python-brace-format
msgid "Shutdown server {server}"
msgstr "关闭服务器 {server}"

#: services/webservice/pages/actions.py:946
#, python-brace-format
msgid ""
"<b>{players} player(s) connected right now lose their connection</b> and "
"nobody can join until somebody starts the server up again. The box below "
"is ticked by default and puts the server into maintenance — it stays out "
"of service, so the scheduler does not bring it back up. Clear it only to "
"shut the server down without keeping it down."
msgstr ""
"<b>当前连接的 {players} 名玩家将失去连接</b>，在有人重新启动服务器之前无人能加入。下方复选框默认勾选，会把服务器置为维护状态 —"
" 它保持停止服务，因此调度器不会把它重新拉起。只有在你希望关闭服务器但不想让它保持关闭时才取消勾选。"

#: services/webservice/pages/actions.py:951
msgid ""
"<b>Nobody is connected right now.</b> The box below is ticked by default "
"and puts the server into maintenance — it stays out of service, so the "
"scheduler does not bring it back up. Clear it only to shut the server "
"down without keeping it down."
msgstr ""
"<b>当前没有玩家连接。</b>下方复选框默认勾选，会把服务器置为维护状态 — "
"它保持停止服务，因此调度器不会把它重新拉起。只有在你希望关闭服务器但不想让它保持关闭时才取消勾选。"

#: services/webservice/pages/actions.py:955
msgid ""
"It stays SHUTDOWN on every page until a Startup brings it back — this is "
"the graceful stop, not the process-level Stop in the row's menu."
msgstr "它会在所有页面上保持“已关闭”，直到有一次“启动”把它带回来 — 这是优雅停止，而不是该行菜单里进程层面的“停止”。"

