msgid "Unmute {player} on {server}"
msgstr "在 {server} 上解除 {player} 的禁言"

#: services/webservice/pages/actions.py:1490
msgid "restore their chat"
msgstr "恢复他们的聊天"

#: services/webservice/pages/actions.py:1497
msgid "Screenshot"
msgstr "截图"

#: services/webservice/pages/actions.py:1499
msgid "Screenshot — capture this player's screen"
msgstr "截图 — 抓取该玩家的屏幕画面"

#: services/webservice/pages/actions.py:1500
#, python-brace-format
msgid "Take a screenshot of {player} on {server}"
msgstr "为 {server} 上的 {player} 截图"

#: services/webservice/pages/actions.py:1501
