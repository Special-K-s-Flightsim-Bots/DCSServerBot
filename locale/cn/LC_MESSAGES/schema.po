msgstr "嵌入中显示的备用主机名；若非单进程则必需。"

#. lardoon_schema:schema;node_lardoon_schema.url
#: extensions/lardoon/schemas/lardoon_schema.yaml:43
msgid "Alternate hostname shown in the server status embed."
msgstr "服务器状态嵌入中显示的备用主机名。"

#. lardoon_schema:schema;instance_lardoon_schema.tacviewExportPath
#: extensions/lardoon/schemas/lardoon_schema.yaml:114
msgid "Alternative directory holding the Tacview files."
msgstr "存放 Tacview 文件的备用目录。"

#. olympus_schema:schema;instance_olympus_schema.regex;(frontend|client).mapMirrors
#: extensions/olympus/schemas/olympus_schema.yaml:320
