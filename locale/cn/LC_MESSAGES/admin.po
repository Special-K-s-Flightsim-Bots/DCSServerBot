# /dcs
msgid "Commands to manage your DCS installations"
msgstr "管理 DCS 安装的命令"

# /dcs ban
msgid "Bans a user by name or ucid"
msgstr "按名称或 UCID 封禁用户"

msgid "Reason"
msgstr "原因"

msgid "Days (empty = forever)"
msgstr "天数（留空表示永久）"

msgid "Ban Details"
msgstr "封禁详情"

msgid "Member {} is not linked!"
msgstr "成员 {} 尚未关联!"

msgid "{} is not a valid UCID!"
msgstr "{} 不是有效的 UCID!"

msgid "Player {} banned on all servers"
msgstr "已在所有服务器封禁玩家 {}"

msgid " for {} days."
msgstr "（{} 天）"

# /dcs unban
msgid "Unbans a user by name or ucid"
msgstr "按名称或 UCID 解封用户"

msgid "Player {} unbanned on {}."
msgstr "已在 {} 解封玩家 {}."

msgid "Player {} was not banned on {}."
msgstr "玩家 {} 未在 {} 上被封禁."

msgid "Shows active bans"
msgstr "显示当前封禁"

msgid "User with UCID {} is not banned."
msgstr "UCID 为 {} 的用户未被封禁."

# /dcs bans
msgid "Ban Information"
msgstr "封禁信息"

msgid "<unknown>"
msgstr "<未知>"

msgid "never"
msgstr "永不"

msgid "Banned by: {}"
msgstr "封禁人: {}"

msgid "Exp.: {}"
msgstr "到期时间: {}"

# /dcs update
msgid "Update your DCS installations"
msgstr "更新 DCS 主程序"

msgid "Time in seconds to warn users before shutdown"
msgstr "关机前向用户发出警告的秒数"

msgid "Can't get version information from ED, possible auth-server outage!"
msgstr "无法从 ED 获取版本信息，可能是认证服务器出现故障!"

msgid "Your installed version {version} is the latest on branch {branch}."
msgstr "您当前安装的 {version} 已是分支 {branch} 的最新版本."

msgid ""
"Would you like to update from version {old_version}@{old_branch} to {new_version}@{new_branch}?\n"
"All running DCS servers will be shut down!"
msgstr ""
"是否要将版本从 {old_version}@{old_branch} 更新到 {new_version}@{new_branch}?\n"
"所有正在运行的 DCS 服务器都将被关闭!"

msgid "Updating DCS World to the newest version, please wait ..."
msgstr "正在将 DCS World 更新到最新版本，请稍候 ..."

msgid "DCS updated to version {version}@{branch} on node {name}."
msgstr "节点 {name} 上的 DCS 已更新到版本 {version}@{branch}."

msgid "DCS World could not be updated on node {name} due to missing disk space!"
msgstr "由于磁盘空间不足，节点 {name} 上的 DCS World 无法完成更新!"

msgid ""
"DCS World updated to version {version}@{branch} on node {name}.\n"
"The updater has requested a **reboot** of the system!"
msgstr ""
"节点 {name} 上的 DCS World 已更新到版本 {version}@{branch}.\n"
"更新程序要求对系统执行 **重启**!"

msgid "Error while updating DCS on node {name}, code={rc}"
msgstr "更新节点 {name} 上的 DCS 时出错，返回码={rc}"

msgid "The update takes longer than 10 minutes, please check back regularly, if it has finished."
msgstr "此次更新耗时可能超过 10 分钟，请定期检查是否已完成."

msgid "Can't update branch {}. You might need to provide proper DCS credentials to do so."
msgstr "无法更新分支 {}。您可能需要提供正确的 DCS 凭据才能继续."

# /dcs install
msgid "Install modules in your DCS server"
msgstr "在 DCS 服务器中安装模块"

msgid "Shutdown all servers on node {} for the installation?"
msgstr "要为安装操作关闭节点 {} 上的所有服务器吗?"

msgid "Installing module {module} on node {node}, please wait ..."
msgstr "正在节点 {node} 上安装模块 {module}，请稍候 ..."

msgid "Module {module} installed on node {node}."
msgstr "模块 {module} 已安装到节点 {node}."

# /dcs uninstall
msgid "Uninstall modules from your DCS server"
msgstr "从 DCS 服务器卸载模块"

msgid "Shutdown all servers on node {} for the uninstallation?"
msgstr "要为卸载操作关闭节点 {} 上的所有服务器吗?"

msgid "Aborted."
msgstr "已中止."

msgid "Module {module} uninstalled on node {node}."
msgstr "模块 {module} 已从节点 {node} 卸载."

# /download
msgid "Download files from your server"
msgstr "从服务器下载文件"

msgid "File {file} not found in directory {dir}."
msgstr "在目录 {dir} 中未找到文件 {file}."

msgid "File sent as a DM."
msgstr "文件已通过私信发送."

msgid "Here is your file:"
msgstr "这是您的文件:"

msgid "File too large. You need a higher boost level for your server."
msgstr "文件过大。您的 Discord 服务器需要更高的等级."

msgid "File sent to the configured channel."
msgstr "文件已发送到已配置的频道."

msgid "File copied to the specified location."
msgstr "文件已复制到指定位置."

# /prune
msgid "Prune unused data in the database"
msgstr "清理数据库中的无用数据"

msgid ":warning: Database Prune :warning:"
msgstr ":warning: 数据库清理 :warning:"

msgid ""
"You are going to delete data from your database. Be advised.\n"
"\n"
"Please select the data to be pruned:"
msgstr ""
"警告：您即将从数据库中删除数据。\n"
"\n"
"请选择要清理的数据:"

msgid "We are going to delete all data of user {}. Are you sure?"
msgstr "即将删除用户 {} 的全部数据。您确定吗?"

msgid "We are going to delete all data of server {}. Are you sure?"
msgstr "即将删除服务器 {} 的全部数据。您确定吗?"

msgid "Data of user {} deleted."
msgstr "用户 {} 数据已删除."

msgid "Data of server {} deleted."
msgstr "服务器 {} 数据已删除."

msgid "No players to prune."
msgstr "没有可清理的玩家数据."

msgid ""
"This will delete {} players incl. their stats from the database.\n"
"Are you sure?"
msgstr ""
"这将从数据库中删除 {} 名玩家及其统计数据。\n"
"您确定吗?"

msgid ""
"This will delete all data older than {} days from the database.\n"
"Are you sure?"
msgstr ""
"这将从数据库中删除所有早于 {} 天前的数据。\n"
"您确定吗?"

msgid "All data older than {} days pruned."
msgstr "已清理所有早于 {} 天前的数据."

# /node
msgid "Commands to manage your nodes"
msgstr "管理节点的命令"

# /node statistics
msgid "Statistics of your nodes"
msgstr "节点统计信息"

# /node list
msgid "Status of all nodes"
msgstr "所有节点状态"

msgid "DCSServerBot Cluster Overview"
msgstr "DCSServerBot 集群概述"

msgid "🆕 Update available"
msgstr "🆕 有更新可用"

msgid "Instance"
msgstr "实例"

msgid "Server"
msgstr "服务器"

msgid "Status"
msgstr "状态"

# /node upgrade / restart
msgid "Do you want to {} all nodes?"
msgstr "是否要对所有节点执行 {}?"

msgid "Do you want to {method} node {node}?"
msgstr "是否要对节点 {node} 执行 {method}?"

msgid "upgrade"
msgstr "升级"

msgid "shutdown"
msgstr "关闭"

msgid "restart"
msgstr "重启"

msgid "Node {node} - {method} sent."
msgstr "已向节点 {node} 发送 {method} 指令."

msgid "All nodes are"
msgstr "所有节点"

msgid "Master is"
msgstr "主节点"

msgid " going to {} **NOW**."
msgstr "将**立即**执行 {}."

# /node shutdown
msgid "Shuts a specific node down"
msgstr "关闭特定节点"

# /node restart
msgid "Restarts a specific node"
msgstr "重启特定节点"

# /node offline
msgid "Shuts down all servers, enables maintenance"
msgstr "关闭所有服务器并启用维护模式"

msgid "Shuts all servers down (default: on)"
msgstr "关闭所有服务器（默认开启）"

msgid "Node {} is now offline."
msgstr "节点 {} 已离线."

# /node online
msgid "Clears the maintenance mode for all servers"
msgstr "关闭所有服务器的维护模式"

msgid "Start all your servers (default: off)"
msgstr "启动所有服务器（默认关闭）"

msgid "Node {} is now online."
msgstr "节点 {} 已上线."

# /node upgrade
msgid "Upgrade DCSServerBot"
msgstr "升级 DCSServerBot"

msgid "There is no upgrade available for "
msgstr "没有可用的更新 "

msgid "your cluster"
msgstr "您的集群"

msgid "node {}"
msgstr "节点 {}"

msgid "You are trying to upgrade an agent node in a cluster. Are you really sure?"
msgstr "您正在尝试升级集群中的代理节点。您真的确定吗?"

# /node shell
msgid "Run a shell command on a node"
msgstr "在节点上运行 shell 命令"

msgid "```Command executed.```"
msgstr "```命令已执行。```"

# /reload
msgid "Reloads a plugin"
msgstr "重新加载插件"

msgid "Plugin {} reloaded."
msgstr "插件 {} 已重新加载."

msgid "Plugin {} could not be reloaded, check the log for details."
msgstr "插件 {} 无法重新加载，请查看日志了解详情."

msgid "All plugins reloaded."
msgstr "所有插件已重新加载."

msgid "One or more plugins could not be reloaded, check the log for details."
msgstr "一个或多个插件无法重新加载，请查看日志了解详细信息."

# /node add_instance
msgid "Add/create an instance\n"
msgstr "添加/创建实例\n"

msgid "Either select an existing instance or enter the name of a new one"
msgstr "请选择现有实例，或输入新实例名称"

msgid "Take this instance configuration as a reference"
msgstr "以此实例配置作为参考"

msgid "Instance \"{}\" created.\n"
"Do you want to configure a server for this instance?"
msgstr "实例 \"{}\" 已创建.\n"
"是否要为此实例配置服务器?"

msgid "Server {server} assigned to instance {instance}."
msgstr "服务器 {server} 已分配给实例 {instance}."

msgid "Instance {} created blank with no server assigned."
msgstr "实例 {} 已创建，但未分配服务器."

msgid ""
"Instance {instance} added to node {node}.Please make sure you forward the following ports:```- DCS Port:    "
"{dcs_port} (TCP/UDP)- WebGUI Port: {webgui_port} (TCP)```"
msgstr ""
"实例 {instance} 已添加到节点 {node}。请确保已转发以下端口:```- DCS 端口:    "
"{dcs_port} (TCP/UDP)- WebGUI 端口: {webgui_port} (TCP)```"

msgid "Instance {instance} could not be added to node {node}, see log."
msgstr ""
"无法将实例 {instance} 添加到节点 {node}.\n"
"请查看日志文件."

# /node delete_instance
msgid "Delete an instance\n"
msgstr "删除一个实例\n"

msgid "The instance is in use by server \"{}\".\n"
"Do you really want to delete it?"
msgstr "该实例正在被服务器使用 \"{}\".\n"
"你真的想删除它吗?"

msgid "Do you really want to delete instance {}?"
msgstr "你真的想删除实例 {} 吗?"

msgid "Do you want to remove the directory\n{}?"
msgstr "是否要删除目录\n{}?"

msgid "Instance {instance} removed from node {node}."
msgstr "实例 {instance} 已从节点 {node} 移除."

msgid "Instance {} could not be deleted, because the directory is in use."
msgstr "实例 {} 无法被删除，因为目录正在使用中."

# /node rename_instance
msgid "Rename an instance\n"
msgstr "重命名一个实例\n"

msgid "Server {} has to be shut down before renaming the instance!"
msgstr "服务器 {} 必须在重命名实例之前关闭!"

msgid "Do you really want to rename instance {}?"
msgstr "你真的想重命名实例 {} 吗?"

msgid "Instance {old_name} renamed to {new_name}."
msgstr "实例 {old_name} 已重命名为 {new_name}."

msgid "Instance {} could not be renamed, because the directory is in use."
msgstr "实例 {} 无法重命名，因为目录正在使用中."

# Config upload
msgid "To which server do you want to upload this configuration to?"
msgstr "您想将此配置上传到哪个服务器?"

msgid "Error while uploading file to node {}!"
msgstr "上传文件到节点 {} 时出错!"

msgid "Error while reading file from discord."
msgstr "从 Discord 读取文件时出错."

msgid "Plugin {} re-loaded."
msgstr "插件 {} 已重新加载."

msgid "To apply the new config by restarting a node or the whole cluster, use {}"
msgstr "要通过重启节点或整个集群来应用新配置，请使用 {}"

# /webadmin status
msgid "A configuration change applies on the next node restart, not on a page reload."
msgstr "配置更改在下次节点重启后生效，而不是在刷新页面时生效。"

# /webadmin status
msgid "Configuration file"
msgstr "配置文件"

# /webadmin status
msgid "Frontend"
msgstr "前端"

# /webadmin status
msgid "frontend is off — the service serves the REST API only: no page, no login, no session cookie. Set frontend: true."
msgstr "frontend 已关闭 — 服务只提供 REST API：没有页面、没有登录、没有会话 cookie。请设置 frontend: true。"

# /webadmin status
msgid "username and password"
msgstr "用户名和密码"

# /webadmin status
msgid "Discord"
msgstr "Discord"

# /webadmin status
msgid "break-glass credential"
msgstr "应急凭据"

# /webadmin status
msgid "Login"
msgstr "登录"

# /webadmin status
msgid "The login block is empty — every page answers 403. Enable at least one of auth.local, auth.discord or auth.breakglass."
msgstr "登录配置为空 — 每个页面都返回 403。请至少启用 auth.local、auth.discord 或 auth.breakglass 之一。"

# /webadmin status
msgid "Session secret"
msgstr "会话密钥"

# /webadmin status
msgid "Public address"
msgstr "公网地址"

# /webadmin status
msgid "Service"
msgstr "服务"

# /webadmin status
msgid "Next step"
msgstr "下一步"

# /webadmin status
msgid "Inspects the configuration of the admin website"
msgstr "检查管理网站的配置"

# /webadmin status
msgid "frontend is on — the pages, the login and the session cookie are installed."
msgstr "frontend 已开启 — 页面、登录和会话 cookie 均已安装。"

# /webadmin status
msgid "session.secret is not set — a random key is generated at every start, so everyone is signed out when the node restarts. Set a secret of at least 32 characters."
msgstr "session.secret 未设置 — 每次启动都会生成随机密钥，因此节点重启后所有人都被登出。请设置至少 32 个字符的密钥。"

# /webadmin status
msgid "auth.public_base_url is not set — redirect URIs are built from it, so a Discord login cannot return. Set the address your users open, e.g. https://dcs.example.com."
msgstr "auth.public_base_url 未设置 — 重定向 URI 由此生成，Discord 登录无法返回。请设置用户打开的地址，例如 https://dcs.example.com。"

# /webadmin status
msgid "The website runs on the master node only — this is not the master, so nothing is served here. Run the check on the master."
msgstr "网站只在主节点（master）上运行 — 这不是主节点，因此这里不提供任何内容。请在主节点上执行检查。"

# /webadmin status
msgid "The service is loaded but not running, so nothing answers on a port. Restart the node."
msgstr "服务已加载但未运行，因此没有端口响应。请重启节点。"

# /webadmin status
msgid "Website status"
msgstr "网站状态"

# /webadmin status
msgid "Shows which part of the website configuration is missing"
msgstr "显示网站配置中缺少的部分"

# /webadmin status
msgid "{} found."
msgstr "已找到 {}。"

# /webadmin status
msgid "session.secret is set ({} characters) — sessions survive a node restart."
msgstr "session.secret 已设置（{} 个字符）— 会话可在节点重启后保留。"

# /webadmin status
msgid "auth.public_base_url is {} — redirect URIs are built from it."
msgstr "auth.public_base_url 为 {} — 重定向 URI 由此生成。"

# /webadmin status
msgid "The service is not loaded on this node — {} is read at startup. Restart the node."
msgstr "该节点上未加载此服务 — {} 在启动时读取。请重启节点。"

# /webadmin status
msgid "The address is not known yet."
msgstr "地址尚不清楚。"

# /webadmin status
msgid "{} is missing — no website service exists without it. Run /webadmin setup to create it."
msgstr "缺少 {} — 没有它就不存在网站服务。运行 /webadmin setup 创建它。"

# /webadmin status
msgid "Login is enabled for: {}."
msgstr "已启用登录方式：{}。"

# /webadmin status
msgid "session.secret is only {} characters long — a key shorter than 32 characters is refused at startup. Use at least 32."
msgstr "session.secret 只有 {} 个字符 — 少于 32 个字符的密钥会在启动时被拒绝。请使用至少 32 个字符。"

# /webadmin status
msgid "auth.public_base_url is not an absolute http(s) address ({}) — redirect URIs are built from it."
msgstr "auth.public_base_url 不是绝对的 http(s) 地址（{}）— 重定向 URI 由此生成。"

# /webadmin status
msgid "auth.public_base_url points at this machine only ({}) — a Discord login comes back to this machine and nowhere else. Set the address your users open."
msgstr "auth.public_base_url 只指向本机（{}）— Discord 登录只能返回本机。请设置用户打开的地址。"

# /webadmin status
msgid "The service is running on this node, port {}."
msgstr "服务正在该节点上运行，端口 {}。"

# /webadmin status
msgid "Open {}."
msgstr "请打开 {}。"

# /webadmin setup
msgid "Not chosen yet — pick a sign-in mode from the list below."
msgstr "尚未选择 — 请在下方列表中挑一种登录方式。"

# /webadmin setup
msgid "Everything is collected — press the button below to write the configuration."
msgstr "已收集完毕 — 按下方的按钮写入配置。"

# /webadmin setup
msgid "Discord login and a local account"
msgstr "Discord 登录和一个本地账户"

# /webadmin setup
msgid "Manual"
msgstr "手动"

# /webadmin setup
msgid "Pick how you sign in from the list below."
msgstr "在下面的列表中选择你的登录方式。"

# /webadmin setup
msgid "Fill in the form the wizard opened."
msgstr "填写向导打开的表格。"

# /webadmin setup
msgid "The configuration keeps auth.discord.client_secret_key: discord_client_secret."
msgstr "配置保留 auth.discord.client_secret_key: discord_client_secret。"

# /webadmin setup
msgid "Client secret"
msgstr "客户端密钥"

# /webadmin setup
msgid "Username"
msgstr "用户名"

# /webadmin setup
msgid "Website setup"
msgstr "网站设置"

# /webadmin setup
msgid "Turns the admin website on and stores the login secret"
msgstr "开启管理网站并保存登录密钥"

# /webadmin setup
msgid "Listen"
msgstr "监听地址"

# /webadmin setup
msgid "How do you want to sign in?"
msgstr "你想如何登录？"

# /webadmin setup
msgid "Write the configuration"
msgstr "写入配置"

# /webadmin setup
msgid "Step 1: address and port"
msgstr "第 1 步：地址和端口"

# /webadmin setup
msgid "Step 2: Discord login"
msgstr "第 2 步：Discord 登录"

# /webadmin setup
msgid "Step 2: local account"
msgstr "第 2 步：本地账号"

# /webadmin setup
msgid "Local account"
msgstr "本地账号"

# /webadmin setup
msgid "This node is not the master — the website runs on the master node only. Run /webadmin setup on the master node."
msgstr "此节点不是主节点 — 网站只在主节点上运行。请在主节点上运行 /webadmin setup。"

# /webadmin setup
msgid "Manual setup"
msgstr "手动设置"

# /webadmin setup
msgid "Pick how you sign in first."
msgstr "请先选择登录方式。"

# /webadmin setup
msgid "The public address has to be an absolute http or https address."
msgstr "公开地址必须是绝对的 http 或 https 地址。"

# /webadmin setup
msgid "The client secret is required."
msgstr "客户端密钥是必需的。"

# /webadmin setup
msgid "Backup"
msgstr "备份"

# /webadmin setup
msgid "Nothing changed — {} already matches."
msgstr "没有任何变化 — {} 已经一致。"

# /webadmin setup
msgid "{} was written."
msgstr "{} 已写入。"

# /webadmin setup
msgid "This node is not the master — the website runs on the master node only. Run /webadmin setup on {}."
msgstr "此节点不是主节点 — 网站只在主节点上运行。请在 {} 上运行 /webadmin setup。"

# /webadmin setup
msgid "The configuration could not be written: {}"
msgstr "配置无法写入：{}"

# /webadmin setup
msgid "Store the client secret with:"
msgstr "用下面的命令保存客户端密钥："

# /webadmin setup
msgid "The port has to be a whole number between {} and {}."
msgstr "端口必须是 {} 到 {} 之间的整数。"

# /webadmin setup
msgid "The previous version is kept as {}."
msgstr "之前的版本保留为 {}。"

# /webadmin setup
msgid "A configuration change applies on the next node restart, not on a page reload: {}"
msgstr "配置更改在下次重启节点时生效，而不是刷新页面：{}"

# /webadmin setup
msgid "Open the Discord Developer Portal, your application → OAuth2, and add the redirect URI {}."
msgstr "打开 Discord Developer Portal，你的应用 → OAuth2，并添加重定向 URI {}。"

# /webadmin setup
msgid "Discord login"
msgstr "Discord 登录"

# /webadmin setup
msgid "Port"
msgstr "端口"

# /webadmin setup
msgid "The bot's application id could not be read, so the Discord login cannot be configured here."
msgstr "无法读取机器人的应用 ID，因此这里无法配置 Discord 登录。"

# /webadmin
msgid "Inspects and sets up the admin website"
msgstr "检查并设置管理网站"

# /webadmin status
msgid "auth.public_base_url is {} — plain http carries the login page and the session cookie in cleartext. Set an https address, or an address inside your own network."
msgstr "auth.public_base_url 为 {} — 明文 http 会以明文传输登录页面和会话 Cookie。请设置 https 地址，或您自己网络内的地址。"

# /webadmin setup
msgid "The client secret is stored under auth.discord.client_secret_key — the configuration file names that key only, never the value."
msgstr "客户端密钥存储在 auth.discord.client_secret_key 下 — 配置文件只写入该键名，绝不写入其值。"

# /webadmin setup
msgid "Step 2: Discord login and a local account"
msgstr "第 2 步：Discord 登录和本地账户"

# /webadmin setup
msgid "Password"
msgstr "密码"

# /webadmin setup
msgid "A username is required."
msgstr "需要用户名。"

# /webadmin setup
msgid "The password has to be at least {} characters long."
msgstr "密码长度至少为 {} 个字符。"

# /webadmin setup
msgid "The local account '{}' already exists — nothing was written. Change its password with the user password command instead."
msgstr "本地账户“{}”已存在 — 未写入任何内容。请改用 user password 命令修改其密码。"

# /webadmin setup
msgid "The local account {} is set up; its password is the one you entered."
